{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "keycloak": {
        "ClusterId": "keycloak-cluster",
        "Match": {
          "Path": "{**catch-all}"
        },
        "Transforms": [
          {
            "RequestHeader": "X-Forwarded-Proto",
            "Set": "https"
          },
          {
            "RequestHeader": "X-Forwarded-Host",
            "Set": "localhost:8443"
          },
          {
            "RequestHeader": "X-Forwarded-For",
            "Append": "{RemoteIpAddress}"
          }
        ]
      }
    },
    "Clusters": {
      "keycloak-cluster": {
        "Destinations": {
          "keycloak": {
            "Address": "http://localhost:8080"
          }
        }
      }
    }
  }
}
