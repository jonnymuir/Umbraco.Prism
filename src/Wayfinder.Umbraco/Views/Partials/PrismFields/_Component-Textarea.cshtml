@model Wayfinder.Umbraco.Models.PrismFieldContext
<div class="@Model.WrapperClass"@Html.Raw(Model.WrapperAttrs)>
    @await Html.PartialAsync("~/Views/Partials/PrismFields/_ComponentLabel.cshtml", Model)
    @if (Model.Field.ReadOnly)
    {
        <div class="govuk-body">@Model.DisplayValue</div>
        <input type="hidden" name="fields[@Model.Field.FieldKey]" value="@Model.DisplayValue" />
    }
    else
    {
        <textarea class="govuk-textarea@(Model.HasFieldError ? " govuk-textarea--error" : "")"
                  id="@Model.Field.FieldKey"
                  name="fields[@Model.Field.FieldKey]"
                  rows="5"
                  data-label="@Model.Field.Label"@Html.Raw(Model.DescribedBy)@Html.Raw(Model.RequiredAttr)@Html.Raw(Model.AriaRequired)@Html.Raw(Model.AriaInvalid)@Html.Raw(Model.MinLengthAttr)@Html.Raw(Model.MaxLengthAttr)>@Model.DisplayValue</textarea>
    }
</div>
