@model Wayfinder.Umbraco.Models.PrismFieldContext
@{
    var checkedValues = (Model.DisplayValue ?? "")
        .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
        .Select(v => v.Trim())
        .ToHashSet(StringComparer.OrdinalIgnoreCase);
}
<div class="@Model.WrapperClass"@Html.Raw(Model.WrapperAttrs)>
    <fieldset class="govuk-fieldset"@Html.Raw(Model.DescribedBy)>
        <legend class="govuk-fieldset__legend govuk-fieldset__legend--s">
            @Model.Field.Label@if (Model.Field.Required){<span class="govuk-visually-hidden"> (required)</span>}
        </legend>
        @if (Model.HasHint)
        {
            <div class="govuk-hint" id="@Model.HintId">@Model.Field.Hint</div>
        }
        @if (Model.HasFieldError)
        {
            <p class="govuk-error-message" id="@Model.ErrorId">
                <span class="govuk-visually-hidden">Error:</span> @Model.FieldError
            </p>
        }
        <div class="govuk-checkboxes" data-module="govuk-checkboxes">
            @if (Model.Field.Options != null)
            {
                foreach (var option in Model.Field.Options)
                {
                    var cbId = $"{Model.Field.FieldKey}-{option.ToLowerInvariant().Replace(" ", "-")}";
                    <div class="govuk-checkboxes__item">
                        <input class="govuk-checkboxes__input"
                               type="checkbox"
                               id="@cbId"
                               name="fields[@Model.Field.FieldKey]"
                               value="@option"
                               @(checkedValues.Contains(option) ? "checked" : "")
                               data-label="@option"@Html.Raw(Model.AriaInvalid)@Html.Raw(Model.ReadOnlyAttr) />
                        <label class="govuk-label govuk-checkboxes__label" for="@cbId">@option</label>
                    </div>
                }
            }
        </div>
    </fieldset>
</div>
