{
  "id": "c3d4e5f6-a7b8-9012-cdef-123456789012",
  "definitionKey": "information-request",
  "displayName": "Information Request",
  "version": 1,
  "schemaVersion": "1.0",
  "initialStageKey": "collecting-info",
  "instancePolicy": "single",
  "lanes": [
    {
      "key": "applicant",
      "title": "Applicant",
      "actor": "applicant",
      "roleGates": []
    },
    {
      "key": "caseworker",
      "title": "Caseworker",
      "actor": "caseworker",
      "roleGates": []
    }
  ],
  "gateways": [
    {
      "key": "request-submitted",
      "title": "Request submitted",
      "type": "Split",
      "laneKey": "applicant",
      "roleGates": []
    },
    {
      "key": "review-complete",
      "title": "Review complete",
      "type": "Join",
      "laneKey": "applicant",
      "roleGates": [],
      "waitingInfo": {
        "content": "We've received your submission and it's currently being reviewed. You'll hear from us soon \u2014 no further action is needed right now.",
        "expectedWaitSeconds": 30,
        "pollIntervalMs": 5000,
        "allowDefer": false
      },
      "requiredIncomingLanes": [
        "applicant",
        "caseworker"
      ]
    }
  ],
  "stages": [
    {
      "key": "collecting-info",
      "title": "Tell us about yourself",
      "type": "Question",
      "laneKey": "applicant",
      "actions": [],
      "fields": [
        {
          "key": "firstName",
          "label": "First name",
          "type": "Text",
          "required": true,
          "hint": "As it appears on your ID",
          "options": []
        },
        {
          "key": "lastName",
          "label": "Last name",
          "type": "Text",
          "required": true,
          "options": []
        },
        {
          "key": "dateOfBirth",
          "label": "Date of birth",
          "type": "Date",
          "required": true,
          "hint": "For example, 12 03 1985",
          "options": []
        },
        {
          "key": "email",
          "label": "Email address",
          "type": "Email",
          "required": true,
          "hint": "We'll only use this to contact you about your request",
          "options": []
        },
        {
          "key": "requestType",
          "label": "What type of request is this?",
          "type": "Select",
          "required": true,
          "options": [
            "General enquiry",
            "Data subject access request",
            "Complaint",
            "Technical support"
          ]
        },
        {
          "key": "description",
          "label": "Tell us more about your request",
          "type": "Textarea",
          "required": true,
          "hint": "Include as much detail as possible. Maximum 1000 characters.",
          "options": []
        },
        {
          "key": "urgency",
          "label": "How urgent is this?",
          "type": "Radios",
          "required": true,
          "options": [
            "Standard (5-7 working days)",
            "Urgent (2 working days)",
            "Critical (same day)"
          ]
        }
      ],
      "roleGates": []
    },
    {
      "key": "caseworker-review",
      "title": "Caseworker review",
      "description": "Caseworker confirms the review outcome before the applicant sees the final status.",
      "type": "Question",
      "laneKey": "caseworker",
      "actions": [],
      "fields": [],
      "roleGates": []
    },
    {
      "key": "complete",
      "title": "Request Complete",
      "type": "Confirmation",
      "laneKey": "applicant",
      "actions": [],
      "fields": [],
      "roleGates": []
    }
  ],
  "transitions": [
    {
      "source": "collecting-info",
      "target": "request-submitted",
      "trigger": "submit",
      "conditions": [],
      "actions": []
    },
    {
      "source": "request-submitted",
      "target": "review-complete",
      "trigger": "await-review",
      "conditions": [],
      "actions": []
    },
    {
      "source": "request-submitted",
      "target": "caseworker-review",
      "trigger": "route-review",
      "conditions": [],
      "actions": []
    },
    {
      "source": "caseworker-review",
      "target": "review-complete",
      "trigger": "complete-review",
      "conditions": [],
      "actions": []
    },
    {
      "source": "review-complete",
      "target": "complete",
      "trigger": "release",
      "conditions": [],
      "actions": []
    }
  ]
}
