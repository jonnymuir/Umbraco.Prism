{
  "$schema": "../../UmbracoPrism.TestSite/umbraco-package-schema.json",
  "name": "Umbraco Prism",
  "version": "1.1.2",
  "extensions": [
    {
      "type": "workspace",
      "kind": "default",
      "alias": "Prism.Workspace.TenantRoot",
      "name": "Prism Tenants Root Workspace",
      "meta": {
        "entityType": "prism-tenant-root",
        "headline": "Tenants"
      }
    },
    {
      "type": "workspaceView",
      "alias": "Prism.WorkspaceView.TenantRoot",
      "name": "Prism Tenants Root Workspace View",
      "elementName": "prism-dashboard",
      "js": "/App_Plugins/UmbracoPrism/dist/prism-dashboard.js",
      "meta": {
        "label": "Tenants",
        "pathname": "tenants",
        "icon": "icon-server"
      },
      "conditions": [
        {
          "alias": "Umb.Condition.WorkspaceAlias",
          "match": "Prism.Workspace.TenantRoot"
        }
      ]
    },
    {
      "type": "menuItem",
      "alias": "Prism.MenuItem.TenantRoot",
      "name": "Prism Tenants Menu Item",
      "weight": 100,
      "meta": {
        "label": "Tenants",
        "icon": "icon-server",
        "entityType": "prism-tenant-root",
        "menus": ["Umb.Menu.AdvancedSettings"]
      }
    },
    {
      "type": "modal",
      "alias": "Prism.CreateTenantModal",
      "name": "Prism Create Tenant Modal",
      "elementName": "prism-create-tenant-modal",
      "js": "/App_Plugins/UmbracoPrism/dist/prism-dashboard.js"
    }
  ]
}
