{
  "$schema": "../../UmbracoPrism.TestSite/umbraco-package-schema.json",
  "name": "Umbraco Prism",
  "version": "1.1.2",
  "extensions": [
    {
      "type": "section",
      "alias": "Prism.Section",
      "name": "Prism",
      "meta": {
        "label": "Prism",
        "pathname": "prism",
        "icon": "icon-prism"
      }
    },
    {
      "type": "dashboard",
      "alias": "Prism.Dashboard",
      "name": "Prism Dashboard",
      "elementName": "prism-dashboard",
      "js": "/App_Plugins/UmbracoPrism/dist/prism-dashboard.js",
      "weight": -10,
      "conditions": [
        {
          "alias": "Umb.Condition.SectionAlias",
          "match": "Umb.Section.Content"
        }
      ],
      "meta": {
        "label": "Tenants",
        "pathname": "tenants"
      }
    },
    {
      "type": "modal",
      "alias": "Prism.CreateTenantModal",
      "name": "Prism Create Tenant Modal",
      "elementName": "prism-create-tenant-modal",
      "js": "/App_Plugins/UmbracoPrism/dist/prism-dashboard.js"
    },
    {
      "type": "dashboard",
      "alias": "Prism.CmsWorkflow.Dashboard",
      "name": "Prism CMS Workflow Dashboard",
      "elementName": "prism-cms-workflow-tab",
      "js": "/App_Plugins/UmbracoPrism/dist/prism-cms-workflow-tab.js",
      "conditions": [
        {
          "alias": "Umb.Condition.SectionAlias",
          "match": "Prism.Section"
        }
      ],
      "meta": {
        "label": "CMS Workflow",
        "pathname": "cms-workflow"
      }
    },
    {
      "type": "bundle",
      "alias": "Prism.CmsWorkflow.Bundle",
      "name": "Prism CMS Workflow Management Bundle",
      "js": "/App_Plugins/UmbracoPrism/dist/prism-cms-workflow-manifests.js"
    }
  ]
}
