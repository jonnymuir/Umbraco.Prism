<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageId>UmbracoPrism</PackageId>
    <Title>Umbraco Prism</Title>
    <Version>1.9.1</Version>
    <Authors>Jonny Muir</Authors>
    <Company>Umbraco Prism</Company>
    <Description>Multi-tenancy for Umbraco (v17+) with dynamic branding and stateless identity.</Description>
    <PackageTags>Umbraco;Multi-tenancy;OIDC;Azure;Backoffice;umbraco-marketplace</PackageTags>
    <PackageProjectUrl>https://github.com/jonnymuir/Umbraco.Prism</PackageProjectUrl>
    <RepositoryUrl>https://github.com/jonnymuir/Umbraco.Prism</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>MARKETPLACE.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageIcon>assets/logo-vertical-lockup.png</PackageIcon>
    <StaticWebAssetBasePath>App_Plugins/UmbracoPrism</StaticWebAssetBasePath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Extensions.AspNetCore.Configuration.Secrets" Version="1.3.2" />
    <PackageReference Include="HtmlSanitizer" Version="9.0.892" />
    <PackageReference Include="FirebaseAdmin" Version="3.1.0" />
    <PackageReference Include="Azure.Identity" Version="1.17.1" />
    <PackageReference Include="Azure.Security.KeyVault.Secrets" Version="4.8.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.2" />
    <PackageReference Include="Microsoft.Identity.Web" Version="4.3.0" />
    <PackageReference Include="MimeKit" Version="4.16.0" />
    <PackageReference Include="MailKit" Version="4.16.0" />
    <PackageReference Include="Polly" Version="8.6.6" />
    <PackageReference Include="Umbraco.Cms.Api.Management" Version="17.3.4" />
    <PackageReference Include="Umbraco.Cms.Core" Version="17.3.4" />
    <PackageReference Include="Umbraco.Cms.Web.Common" Version="17.3.4" />
    <PackageReference Include="Umbraco.Cms.Web.Website" Version="17.3.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../UmbracoPrism.Shared/UmbracoPrism.Shared.csproj" />
    <ProjectReference Include="..\UmbracoPrism.WorkflowEditor\UmbracoPrism.WorkflowEditor.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../MARKETPLACE.md" Pack="true" PackagePath="/" />
    <None Include="../../assets/logo-vertical-lockup.png" Pack="true" PackagePath="assets/" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
    <Content Update="wwwroot/**" Pack="true" PackagePath="/" />
    <!-- Exclude workflow editor authoring concerns from package -->
    <Content Update="wwwroot/dist/workflow-editor.*" Pack="false" CopyToPublishDirectory="Never" />
    <StaticWebAsset Remove="wwwroot/dist/workflow-editor.html" />
    <StaticWebAsset Remove="wwwroot/dist/workflow-editor.js" />
    <StaticWebAsset Remove="wwwroot/dist/workflow-editor.js.map" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="workflow-seeds\*.json" />
    <EmbeddedResource Include="workflow-seeds\field-groups\*.json" />
    <EmbeddedResource Include="Views\_ViewImports.cshtml" />
    <EmbeddedResource Include="Views\Partials\PrismFields\**\*.cshtml" />
    <EmbeddedResource Include="Views\Partials\PrismComponents\**\*.cshtml" />
    <EmbeddedResource Include="Views\Partials\_WorkflowStep-*.cshtml" />
    <EmbeddedResource Include="Views\Partials\_WorkflowHub-*.cshtml" />
    <EmbeddedResource Include="Views\workflowPage.cshtml" />
    <EmbeddedResource Include="Views\workflowHub.cshtml" />
  </ItemGroup>

</Project>
