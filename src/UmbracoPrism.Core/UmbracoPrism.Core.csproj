<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
    <IsPackable>true</IsPackable>
    <!-- Ship the /// XML doc comments. Set here, not in Directory.Build.props: that file is read
         before IsPackable is known. Stage 1: undocumented public members don't fail the build. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageId>UmbracoPrism</PackageId>
    <Title>Umbraco Prism</Title>
    <Description>Multi-tenancy for Umbraco (v17+) with dynamic branding and stateless identity.</Description>
    <PackageTags>Umbraco;Multi-tenancy;OIDC;Azure;Backoffice;umbraco-marketplace</PackageTags>
    <PackageReadmeFile>MARKETPLACE.md</PackageReadmeFile>
    <StaticWebAssetBasePath>App_Plugins/UmbracoPrism</StaticWebAssetBasePath>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Services/MobileBundles/Templates/*" LogicalName="MobileBundleTemplates/%(Filename)%(Extension)" />
    <EmbeddedResource Include="Services/MobileBundles/Templates/bundle/**/*" LogicalName="MobileBundleTemplates/bundle/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="Services/MobileBundles/Templates/journey-status/**/*" LogicalName="MobileBundleTemplates/journey-status/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="Controllers/SavedPages/prism-offline-sw.js" LogicalName="SavedPages/prism-offline-sw.js" />
    <!-- Served as /App_Plugins/UmbracoPrism/branding/*.css, and read from the assembly by BrandingService
         so the tenant editor finds them however the host serves static web assets. -->
    <EmbeddedResource Include="wwwroot/branding/*.css" LogicalName="PrismBranding/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Extensions.AspNetCore.Configuration.Secrets" Version="1.5.2" />
    <PackageReference Include="FirebaseAdmin" Version="3.7.0" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Azure.Security.KeyVault.Secrets" Version="4.11.2" />
    <PackageReference Include="MessagePack" Version="3.1.12" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.11.0" />
    <PackageReference Include="Microsoft.Identity.Web" Version="4.16.1" />
    <PackageReference Include="MimeKit" Version="4.18.1" />
    <PackageReference Include="MailKit" Version="4.18.1" />
    <PackageReference Include="Polly" Version="8.8.0" />
    <!-- Floor for a transitive dependency (via MimeKit/Umbraco): 10.0.12 and below carry GHSA-846f-f764-76mx
         and GHSA-2fmv-rv2c-59x7. Not PrivateAssets, so sites installing the package resolve the patched version too. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageReference Include="Umbraco.Cms.Api.Management" Version="$(UmbracoPackageRange)" />
    <PackageReference Include="Umbraco.Cms.Core" Version="$(UmbracoPackageRange)" />
    <PackageReference Include="Umbraco.Cms.Web.Common" Version="$(UmbracoPackageRange)" />
    <PackageReference Include="Umbraco.Cms.Web.Website" Version="$(UmbracoPackageRange)" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../MARKETPLACE.md" Pack="true" PackagePath="/" />
    <Content Update="wwwroot/**" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
