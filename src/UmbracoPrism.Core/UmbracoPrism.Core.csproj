<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>UmbracoPrism</PackageId>
    <Title>Umbraco Prism</Title>
    <Version>0.1.2</Version>
    <Authors>Jonny Muir</Authors>
    <Company>Umbraco Prism</Company>
    <Description>Multi-tenancy for Umbraco (v17+) with dynamic branding and stateless identity.</Description>
    <PackageTags>Umbraco;Multi-tenancy;OIDC;Azure;Backoffice;umbraco-marketplace</PackageTags>
    <PackageProjectUrl>https://github.com/jonnymuir/Umbraco.Prism</PackageProjectUrl>
    <RepositoryUrl>https://github.com/jonnymuir/Umbraco.Prism</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageIcon>assets/logo-horizontal-lockup.svg</PackageIcon>
    <StaticWebAssetBasePath>App_Plugins/UmbracoPrism</StaticWebAssetBasePath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" Version="1.17.1" />
    <PackageReference Include="Azure.Security.KeyVault.Secrets" Version="4.8.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.2" />
    <PackageReference Include="Microsoft.Identity.Web" Version="4.3.0" />
    <PackageReference Include="Umbraco.Cms.Api.Management" Version="17.0.0" />
    <PackageReference Include="Umbraco.Cms.Core" Version="17.0.0" />
    <PackageReference Include="Umbraco.Cms.Web.Common" Version="17.0.0" />
    <PackageReference Include="Umbraco.Cms.Web.Website" Version="17.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../assets/logo-vertical-lockup.png" Pack="true" PackagePath="assets/" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
    <Content Update="wwwroot/**" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>