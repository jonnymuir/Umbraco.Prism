@using UmbracoPrism.Core.Models.ServiceDesign
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<UmbracoPrism.Core.Models.ServiceDesign.PrismServiceRequestViewModel>
@inject Microsoft.AspNetCore.Mvc.ViewEngines.ICompositeViewEngine _viewEngine
@addTagHelper *, UmbracoPrism.Core
@{
    Layout = "~/Views/Shared/Master.cshtml";
    ViewBag.Title = Model.HasError ? "Service Request Error" : Model.StateDisplayName;
}

<div class="touchpoint-page">
    @if (Model.HasError)
    {
        <div class="touchpoint-page__header">
            <h1 class="touchpoint-page__title">Service Request Error</h1>
        </div>
        <div class="touchpoint-alert touchpoint-alert--error">
            <p>@Model.ErrorMessage</p>
        </div>
    }
    @* Instance picker — shown when instancePolicy = "prompt" and an active instance exists.
       The picker partial uses h2, so we provide the page h1 here. *@
    else if (Model.ShowInstancePicker)
    {
        <div class="touchpoint-page__header">
            <h1 class="touchpoint-page__title">@Model.StateDisplayName</h1>
        </div>
        @await Html.PartialAsync("~/Views/Partials/_ServiceRequestHub-InstancePicker.cshtml", Model)
    }
    else
    {
        var shell = ServiceRequestRenderShellResolver.ResolveShell(
            Model.Components,
            Model.StepType,
            Model.Components.Any(c => string.Equals(c.Type, "waiting", StringComparison.OrdinalIgnoreCase)),
            Model.AvailableActions.Any());

        var partialName = shell switch
        {
            "question" => "_Touchpoint-Question",
            "check-answers" => "_Touchpoint-Review",
            "confirmation" => "_Touchpoint-Completion",
            "status-timeline" => "_Touchpoint-StatusTimeline",
            "task-list" => "_Touchpoint-TaskList",
            "waiting" => "_Touchpoint-Waiting",
            _ => $"_Touchpoint-{shell}"
        };
        var partialPath = $"~/Views/Partials/{partialName}.cshtml";
        var viewResult = _viewEngine.GetView(null, partialPath, false);
        if (viewResult.Success)
        {
            if (partialName == "_Touchpoint-Question")
            {
                <div class="touchpoint-page__header">
                    <h1 class="touchpoint-page__title">@Model.StateDisplayName</h1>
                </div>
            }
            @await Html.PartialAsync(partialName, Model)
        }
        else
        {
            <div class="touchpoint-page__header">
                <h1 class="touchpoint-page__title">@Model.StateDisplayName</h1>
            </div>
            <div class="touchpoint-alert touchpoint-alert--warn">
                <p>No template found for touchpoint shell: <code>@shell</code></p>
            </div>
        }
    }
</div>
