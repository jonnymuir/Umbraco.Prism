@model UmbracoPrism.Core.Models.ServiceDesign.PrismFieldContext
@{
    var checkedValues = (Model.DisplayValue ?? "")
        .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
        .Select(v => v.Trim())
        .ToHashSet(StringComparer.OrdinalIgnoreCase);
    var items = Model.Field.GuidanceItems;
    var total = items?.Count ?? 0;
    var completed = items?.Count(i => checkedValues.Contains(i.Key)) ?? 0;
}
<div class="@Model.WrapperClass"@Html.Raw(Model.WrapperAttrs) data-prism-guidance-checklist>
    <fieldset class="govuk-fieldset"@Html.Raw(Model.DescribedBy)>
        <legend class="govuk-fieldset__legend govuk-fieldset__legend--m">
            @Model.Field.Label@if (Model.Field.Required){<span class="govuk-visually-hidden"> (required)</span>}
        </legend>
        @if (Model.HasHint)
        {
            <div class="govuk-hint" id="@Model.HintId">@Model.Field.Hint</div>
        }
        @if (Model.HasFieldError)
        {
            <p class="govuk-error-message" id="@Model.ErrorId">
                <span class="govuk-visually-hidden">Error:</span> @Model.FieldError
            </p>
        }
        <p class="govuk-body" data-prism-guidance-progress data-prism-guidance-total="@total">@completed of @total guidance articles completed</p>
        @if (items is { Count: > 0 })
        {
            <div class="govuk-checkboxes" data-module="govuk-checkboxes">
                @foreach (var item in items)
                {
                    var cbId = $"{Model.Field.FieldKey}-{item.Key}";
                    <div class="govuk-checkboxes__item">
                        <input class="govuk-checkboxes__input"
                               type="checkbox"
                               id="@cbId"
                               name="fields[@Model.Field.FieldKey]"
                               value="@item.Key"
                               data-prism-guidance-checkbox
                               @(checkedValues.Contains(item.Key) ? "checked" : "")@Html.Raw(Model.AriaInvalid) />
                        <label class="govuk-label govuk-checkboxes__label" for="@cbId">
                            <a class="govuk-link" href="@item.Href" target="_blank" rel="noopener">@item.Label</a>
                        </label>
                    </div>
                }
            </div>
        }
    </fieldset>
</div>
