@model UmbracoPrism.Core.Models.Workflow.PrismFieldContext
<div class="@Model.WrapperClass"@Html.Raw(Model.WrapperAttrs)>
    <fieldset class="govuk-fieldset"@Html.Raw(Model.DescribedBy)>
        <legend class="govuk-fieldset__legend govuk-fieldset__legend--s">
            @Model.Field.Label@if (Model.Field.Required){<span class="govuk-visually-hidden"> (required)</span>}
        </legend>
        @if (Model.HasHint)
        {
            <div class="govuk-hint" id="@Model.HintId">@Model.Field.Hint</div>
        }
        @if (Model.HasFieldError)
        {
            <p class="govuk-error-message" id="@Model.ErrorId" role="alert">
                <span class="govuk-visually-hidden">Error:</span> @Model.FieldError
            </p>
        }
        <div class="govuk-radios" data-module="govuk-radios">
            @if (Model.Field.Options != null)
            {
                foreach (var option in Model.Field.Options)
                {
                    var radioId = $"{Model.Field.FieldKey}-{option.ToLowerInvariant().Replace(" ", "-")}";
                    var isChecked = option.Equals(Model.DisplayValue, StringComparison.OrdinalIgnoreCase);
                    <div class="govuk-radios__item">
                        <input class="govuk-radios__input"
                               type="radio"
                               id="@radioId"
                               name="fields[@Model.Field.FieldKey]"
                               value="@option"
                               @(isChecked ? "checked" : "")
                               data-label="@option"@Html.Raw(Model.RequiredAttr)@Html.Raw(Model.AriaRequired)@Html.Raw(Model.AriaInvalid)@Html.Raw(Model.ReadOnlyAttr) />
                        <label class="govuk-label govuk-radios__label" for="@radioId">@option</label>
                    </div>
                }
            }
        </div>
    </fieldset>
</div>
