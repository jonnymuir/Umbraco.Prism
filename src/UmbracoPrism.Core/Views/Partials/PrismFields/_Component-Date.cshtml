@model UmbracoPrism.Core.Models.ServiceDesign.PrismFieldContext
@{
    // Try to parse stored value (DD/MM/YYYY format)
    var storedParts = (Model.Field.Value?.ToString() ?? "").Split('/');
    var day   = storedParts.Length == 3 ? storedParts[0] : "";
    var month = storedParts.Length == 3 ? storedParts[1] : "";
    var year  = storedParts.Length == 3 ? storedParts[2] : "";

    var dateParts = new[]
    {
        (Id: $"{Model.Field.FieldKey}-day",   Label: "Day",   Width: "govuk-input--width-2",  Value: day),
        (Id: $"{Model.Field.FieldKey}-month", Label: "Month", Width: "govuk-input--width-2",  Value: month),
        (Id: $"{Model.Field.FieldKey}-year",  Label: "Year",  Width: "govuk-input--width-4",  Value: year)
    };
}
<div class="@Model.WrapperClass"@Html.Raw(Model.WrapperAttrs)>
    <fieldset class="govuk-fieldset" role="group"@Html.Raw(Model.DescribedBy)>
        <legend class="govuk-fieldset__legend govuk-fieldset__legend--s">
            @Model.Field.Label@if (Model.Field.Required){<span class="govuk-visually-hidden"> (required)</span>}
        </legend>
        @if (Model.HasHint)
        {
            <div class="govuk-hint" id="@Model.HintId">@Model.Field.Hint</div>
        }
        @if (Model.HasFieldError)
        {
            <p class="govuk-error-message" id="@Model.ErrorId">
                <span class="govuk-visually-hidden">Error:</span> @Model.FieldError
            </p>
        }
        <div class="govuk-date-input">
            @foreach (var part in dateParts)
            {
                <div class="govuk-date-input__item">
                    <div class="govuk-form-group">
                        <label class="govuk-label govuk-date-input__label" for="@part.Id">@part.Label</label>
                        <input class="govuk-input govuk-date-input__input @part.Width@(Model.HasFieldError ? " govuk-input--error" : "")"
                               type="text"
                               inputmode="numeric"
                               id="@part.Id"
                               name="fields[@part.Id]"
                               value="@part.Value"
                               autocomplete="off"@Html.Raw(Model.RequiredAttr)@Html.Raw(Model.AriaRequired)@Html.Raw(Model.AriaInvalid)@Html.Raw(Model.ReadOnlyAttr) />
                    </div>
                </div>
            }
        </div>
    </fieldset>
</div>
