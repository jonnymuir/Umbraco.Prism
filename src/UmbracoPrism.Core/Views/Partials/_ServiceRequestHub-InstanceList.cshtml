@using UmbracoPrism.Core.Models
@model IReadOnlyList<ServiceRequestViewModel>

<ul class="prism-instance-list" role="list">
    @foreach (var instance in Model)
    {
        <li class="prism-instance-card"
            data-blueprint-key="@instance.Summary.BlueprintKey"
            data-current-state="@instance.Summary.CurrentStateKey">
            <div class="prism-instance-card__body">
                <h3 class="prism-instance-card__title">@instance.Summary.BlueprintDisplayName</h3>
                <p class="prism-instance-card__status">
                    <span class="prism-instance-card__state-badge">@instance.Summary.CurrentStateDisplayName</span>
                </p>
                <p class="prism-instance-card__meta">
                    Started <time datetime="@instance.Summary.CreatedAt.ToString("yyyy-MM-dd")">
                        @instance.Summary.CreatedAt.ToString("d MMM yyyy")
                    </time>
                    @if (instance.Summary.LastUpdatedAt != instance.Summary.CreatedAt)
                    {
                        <span> &middot; Updated <time datetime="@instance.Summary.LastUpdatedAt.ToString("yyyy-MM-dd")">
                            @instance.Summary.LastUpdatedAt.ToString("d MMM yyyy")
                        </time></span>
                    }
                </p>
            </div>
            <div class="prism-instance-card__actions">
                <a href="@instance.ResumeUrl"
                   class="prism-button @(instance.Summary.CanContinue ? "prism-button--primary" : "prism-button--secondary")">
                    @(instance.Summary.CanContinue ? "Continue" : "View")
                </a>
            </div>
        </li>
    }
</ul>
