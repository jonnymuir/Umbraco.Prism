@model UmbracoPrism.Core.Models.Workflow.PrismComponentContext
@{
    var token = Html.AntiForgeryToken();
    var sourceKey = Model.Component.SourceStateKey;
}

@if (!string.IsNullOrEmpty(Model.Component.Title))
{
    <h2 class="govuk-heading-m">@Model.Component.Title</h2>
}

<dl class="govuk-summary-list">
    @foreach (var field in Model.Component.Fields.Where(f => string.IsNullOrEmpty(f.ConditionalOn)))
    {
        <div class="govuk-summary-list__row">
            <dt class="govuk-summary-list__key">@field.Label</dt>
            <dd class="govuk-summary-list__value">@(field.Value ?? "Not answered")</dd>
            <dd class="govuk-summary-list__actions">
                @if (!string.IsNullOrEmpty(sourceKey))
                {
                    <form method="post" action="@Model.ReturnUrl" style="display:inline">
                        @token
                        <input type="hidden" name="InstanceId" value="@Model.InstanceId" />
                        <input type="hidden" name="StateVersion" value="@Model.StateVersion" />
                        <input type="hidden" name="WorkflowKey" value="@Model.WorkflowKey" />
                        <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />
                        <input type="hidden" name="Nonce" value="@Model.Nonce" />
                        <button type="submit" name="Action" value="change:@sourceKey"
                                class="govuk-link govuk-link--no-visited-state"
                                style="background:none;border:none;cursor:pointer;padding:0;font-size:inherit;font-family:inherit;text-decoration:underline">
                            Change<span class="govuk-visually-hidden"> @field.Label.ToLower()</span>
                        </button>
                    </form>
                }
                else
                {
                    <a class="govuk-link" href="#">
                        Change<span class="govuk-visually-hidden"> @field.Label.ToLower()</span>
                    </a>
                }
            </dd>
        </div>
    }
</dl>
