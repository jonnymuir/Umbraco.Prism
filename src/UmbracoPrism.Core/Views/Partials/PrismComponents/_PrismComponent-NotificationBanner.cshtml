@model UmbracoPrism.Core.Models.ServiceDesign.PrismComponentContext
@{
    var isSuccess = string.Equals(Model.Component.BannerType, "success", StringComparison.OrdinalIgnoreCase);
    var bannerClass = isSuccess
        ? "govuk-notification-banner govuk-notification-banner--success"
        : "govuk-notification-banner";
}

<div class="@bannerClass" role="region" aria-labelledby="prism-banner-title">
    <div class="govuk-notification-banner__header">
        <h2 class="govuk-notification-banner__title" id="prism-banner-title">
            @(Model.Component.Heading ?? "Important")
        </h2>
    </div>
    @if (!string.IsNullOrEmpty(Model.Component.Content))
    {
        <div class="govuk-notification-banner__content">
            <p class="govuk-body">@Html.Raw(Model.Component.Content)</p>
        </div>
    }
</div>
