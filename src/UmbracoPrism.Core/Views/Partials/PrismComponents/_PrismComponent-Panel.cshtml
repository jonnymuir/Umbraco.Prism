@model UmbracoPrism.Core.Models.Workflow.PrismComponentContext

<div class="govuk-panel govuk-panel--confirmation">
    <h1 class="govuk-panel__title">@(Model.Component.Heading ?? "Complete")</h1>
    @if (Model.Component.Content is not null)
    {
        <div class="govuk-panel__body">@Html.Raw(Model.Component.Content)</div>
    }
</div>
