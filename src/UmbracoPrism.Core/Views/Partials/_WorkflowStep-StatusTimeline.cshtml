@model UmbracoPrism.Core.Models.Workflow.PrismWorkflowViewModel

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <h1 class="govuk-heading-l">@Model.StateDisplayName</h1>

        @foreach (var component in Model.Components)
        {
            <prism-component component="@component"
                             errors="@Model.FieldErrors"
                             values="@Model.FormValues"
                             return-url="@Model.ReturnUrl"
                             instance-id="@Model.InstanceId"
                             state-version="@Model.StateVersion"
                             workflow-key="@Model.WorkflowKey"
                             nonce="@Model.Nonce" />
        }

        @if (Model.AvailableActions.Any())
        {
            <div class="govuk-button-group">
                @foreach (var action in Model.AvailableActions)
                {
                    var btnClass = action.Style switch { "primary" => "govuk-button", "destructive" => "govuk-button govuk-button--warning", _ => "govuk-button govuk-button--secondary" };
                    <a href="/" class="@btnClass" data-module="govuk-button">@action.Label</a>
                }
            </div>
        }
    </div>
</div>
