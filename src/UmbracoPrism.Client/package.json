{
  "name": "umbracoprism-client",
  "private": true,
  "version": "1.9.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && vite build --config vite.workflow-editor.config.ts",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test-storybook": "test-storybook --url http://localhost:6006",
    "test-storybook:all": "test-storybook --url http://localhost:6006 --browsers chromium firefox webkit",
    "test-storybook:ci": "start-server-and-test storybook http://127.0.0.1:6006 test-storybook",
    "test-storybook:ci:all": "start-server-and-test storybook http://127.0.0.1:6006 \"npm run test-storybook:all\"",
    "test:playwright": "playwright test",
    "test:playwright:workflow-graph-visual": "playwright test tests/workflow-editor/workflow-graph-visual.spec.ts --reporter=line",
    "test:playwright:localhost-auth": "node ../../scripts/validate-aspire-prereqs.mjs --localhost-auth-suite && playwright test -c playwright.localhost-auth.config.ts --reporter=line",
    "test:playwright:planning-smoke": "node ../../scripts/validate-aspire-prereqs.mjs --localhost-auth-suite && playwright test -c playwright.localhost-auth.config.ts --grep '01-planning-workflow-editor' --reporter=line --max-failures=1",
    "test:playwright:ui": "playwright test --ui"
  },
  "dependencies": {
    "@aparajita/capacitor-biometric-auth": "^10.0.0",
    "@aparajita/capacitor-secure-storage": "^8.0.0",
    "@capacitor/core": "^8.3.0",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/push-notifications": "^7.0.0",
    "@umbraco-cms/backoffice": "^17.1.0",
    "lit": "^3.3.1"
  },
  "overrides": {
    "dompurify": "^3.4.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.46.1",
    "@storybook/addon-a11y": "^8.6.18",
    "@storybook/addon-essentials": "^8.6.18",
    "@storybook/addon-interactions": "^8.6.18",
    "@storybook/test": "^8.6.18",
    "@storybook/test-runner": "^0.21.0",
    "@storybook/testing-library": "0.2.2",
    "@storybook/web-components": "^8.6.18",
    "@storybook/web-components-vite": "^8.6.18",
    "@typescript-eslint/parser": "^8.58.0",
    "axe-playwright": "^2.1.0",
    "eslint": "^10.1.0",
    "start-server-and-test": "^2.0.4",
    "storybook": "^8.6.18",
    "typescript": "~5.9.3",
    "vite": "^7.2.4"
  }
}
