{
  "name": "umbracoprism-client",
  "private": true,
  "version": "5.0.1",
  "type": "module",
  "scripts": {
    "build": "tsc && vite build",
    "test:calc": "node scripts/run-calculation-golden.mjs",
    "test:save-error-parsing": "node --experimental-transform-types --import ./scripts/register-ts-js-resolve.mjs scripts/run-save-error-parsing-tests.mjs",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:playwright": "playwright test",
    "test:playwright:localhost-auth": "node ../../scripts/validate-aspire-prereqs.mjs --localhost-auth-suite && playwright test -c playwright.localhost-auth.config.ts --reporter=line",
    "test:playwright:ui": "playwright test --ui",
    "demo:record": "playwright test tests/demo/garden-waste-demo.spec.ts -c playwright.demo-recording.config.ts --reporter=line",
    "test-storybook": "vitest run"
  },
  "dependencies": {
    "@aparajita/capacitor-biometric-auth": "^10.0.0",
    "@aparajita/capacitor-secure-storage": "^8.0.0",
    "@capacitor/core": "^8.5.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/push-notifications": "^7.0.0",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.0",
    "@codemirror/view": "^6.43.10",
    "@umbraco-cms/backoffice": "^17.1.0",
    "@xyflow/react": "^12.11.5",
    "lit": "^3.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "overrides": {
    "dompurify": "^3.4.13",
    "@hey-api/openapi-ts": "^0.97.3",
    "@microsoft/signalr": {
      "ws": "^7.5.11"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/web-components-vite": "^10.6.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@typescript-eslint/parser": "^8.69.0",
    "@umbraco-cms/backoffice": "^17.6.2",
    "@umbraco-ui/uui-css": "^1.18.1",
    "@umbraco-ui/uui-icon": "^1.18.1",
    "@umbraco-ui/uui-icon-registry-essential": "^1.18.1",
    "@vitest/browser-playwright": "^4.1.11",
    "eslint": "^10.9.1",
    "playwright": "^1.58.2",
    "storybook": "^10.6.0",
    "typescript": "~5.9.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
