          "fieldKey": "guidance-acknowledgement",
          "label": "Read the following guidance before you apply",
          "hint": null,
          "required": true,
          "conditionalOn": null,
          "visibleWhen": null,
          "default": null,
          "defaultFrom": null,
          "changeStateKey": null
        }
      ],
      "routes": [
        {
          "id": "guidance--continue--route-from-guidance",
          "target": "route-from-guidance",
          "trigger": "continue"
