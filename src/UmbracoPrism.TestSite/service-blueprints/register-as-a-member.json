{
  "definitionKey": "register-as-a-member",
  "displayName": "Register as a member",
  "version": 1,
  "schemaVersion": "1.0",
  "description": "Reference example of registering a person who has just created an account at the identity provider: the journey asks the business app to create their membership with their own bearer token, so the business app takes who they are and which tenant they join from the verified token and never from the form. See docs/walkthroughs/member-registration.md.",
  "initialStage": "start",
  "requestPolicy": "single",
  "allowManualRestart": true,
  "queues": [
    {
      "key": "public-visitor",
      "displayName": "Site visitor touchpoints",
      "description": "The person who has just created an account, registering their membership.",
      "actor": "applicant"
    },
    {
      "key": "automation",
      "displayName": "Business app calls",
      "description": "Never human-visible. Each stage here makes one call to the business app as the signed-in person.",
      "actor": "system"
    }
  ],
  "stages": [
    {
      "stageKey": "start",
      "displayName": "Become a member",
      "stageType": "Question",
      "actor": "applicant",
      "queueKey": "public-visitor",
      "components": [
        {
          "type": "body",
          "content": "You have created your account. To finish, we will set up your membership and ask how we should contact you. We create it as you, using your verified email address, so nobody else can register in your name."
        }
      ],
      "routes": [
        {
          "id": "start--continue--route-from-start",
          "target": "route-from-start",
          "trigger": "continue"
        }
      ]
    },
    {
      "stageKey": "check-membership",
      "displayName": "Checking for an existing membership",
      "stageType": "Question",
      "actor": "system",
      "queueKey": "automation",
      "description": "Never human-visible. The person waits at the membership-checked join while this stage's onEnter action asks the business app, as them, whether they are already a member.",
      "actions": [
        {
          "type": "support-system-call",
          "timing": "onEnter",
          "params": {
            "supportSystemKey": "mock-business-app-profile",
            "capabilityKey": "load-profile",
            "inputs": {}
          }
        }
      ],
      "components": [],
      "routes": [
        {
          "id": "check-membership--registered--membership-checked",
          "target": "membership-checked",
          "trigger": "registered"
        },
        {
          "id": "check-membership--not-registered--membership-checked",
          "target": "membership-checked",
          "trigger": "not-registered"
        }
      ]
    },
    {
      "stageKey": "your-details",
      "displayName": "Your details",
      "stageType": "Question",
      "actor": "applicant",
      "queueKey": "public-visitor",
      "components": [
        {
          "type": "fieldset",
          "legend": "About you",
          "children": [
            {
              "type": "text",
              "maxLength": 80,
              "fieldKey": "memberName",
              "label": "Your name",
              "hint": "As you would like us to address you.",
              "required": true
            }
          ]
        },
        {
          "type": "fieldset",
          "legend": "How can we reach you?",
          "children": [
            {
              "type": "text",
              "maxLength": 20,
              "fieldKey": "phone",
              "label": "Telephone number",
              "hint": "For example, 01632 960 001. Leave blank if you do not want to give one."
            },
            {
              "type": "radio",
              "fieldKey": "contactPreference",
              "label": "How should we contact you?",
              "options": [
                "email",
                "phone",
                "post"
              ],
              "required": true
            }
          ]
        }
      ],
      "routes": [
        {
          "id": "your-details--continue--route-from-your-details",
          "target": "route-from-your-details",
          "trigger": "continue"
        }
      ]
    },
    {
      "stageKey": "check-answers",
      "displayName": "Check your answers",
      "stageType": "CheckAnswers",
      "actor": "applicant",
      "queueKey": "public-visitor",
      "components": [
        {
          "type": "summary-list",
          "children": [
            {
              "type": "text",
              "maxLength": 80,
              "fieldKey": "memberName",
              "label": "Your name",
              "hint": "As you would like us to address you.",
              "required": true,
              "changeStateKey": "your-details"
            },
            {
              "type": "text",
              "maxLength": 20,
              "fieldKey": "phone",
              "label": "Telephone number",
              "hint": "For example, 01632 960 001. Leave blank if you do not want to give one.",
              "changeStateKey": "your-details"
            },
            {
              "type": "radio",
              "fieldKey": "contactPreference",
              "label": "How should we contact you?",
              "options": [
                "email",
                "phone",
                "post"
              ],
              "required": true,
              "changeStateKey": "your-details"
            }
          ]
        }
      ],
      "routes": [
        {
          "id": "check-answers--submit--route-from-check-answers",
          "target": "route-from-check-answers",
          "trigger": "submit"
        }
      ]
    },
    {
      "stageKey": "register-member",
      "displayName": "Registering your membership",
      "stageType": "Question",
      "actor": "system",
      "queueKey": "automation",
      "description": "Never human-visible. The person waits at the registration-sent join while this stage's onEnter action creates their membership in the business app with their own bearer token.",
      "actions": [
        {
          "type": "support-system-call",
          "timing": "onEnter",
          "params": {
            "supportSystemKey": "mock-business-app-profile",
            "capabilityKey": "register-member",
            "inputs": {
              "memberName": "memberName",
              "phone": "phone",
              "contactPreference": "contactPreference"
            }
          }
        }
      ],
      "components": [],
      "routes": [
        {
          "id": "register-member--registered--registration-sent",
          "target": "registration-sent",
          "trigger": "registered"
        },
        {
          "id": "register-member--rejected--registration-sent",
          "target": "registration-sent",
          "trigger": "rejected"
        }
      ]
    },
    {
      "stageKey": "registration-rejected",
      "displayName": "We could not register you",
      "stageType": "Question",
      "actor": "applicant",
      "queueKey": "public-visitor",
      "components": [
        {
          "type": "inset-text",
          "content": "Your membership has not been created."
        },
        {
          "type": "stat-group",
          "title": "What went wrong",
          "items": [
            {
              "label": "Reason",
              "fieldKey": "registrationNote"
            }
          ]
        }
      ],
      "routes": [
        {
          "id": "registration-rejected--continue--route-from-registration-rejected",
          "target": "route-from-registration-rejected",
          "trigger": "continue"
        }
      ]
    },
    {
      "stageKey": "already-a-member",
      "displayName": "You are already a member",
      "stageType": "Confirmation",
      "actor": "applicant",
      "queueKey": "public-visitor",
      "components": [
        {
          "type": "panel",
          "heading": "You are already a member"
        },
        {
          "type": "stat-group",
          "title": "Your membership",
          "items": [
            {
              "label": "Organisation",
              "fieldKey": "profileTenant"
            },
            {
              "label": "Name",
              "fieldKey": "profileName"
            },
            {
              "label": "Email",
              "fieldKey": "profileEmail"
            },
            {
              "label": "Role",
              "fieldKey": "profileRole"
            }
          ]
        },
        {
          "type": "body",
          "content": "There is nothing more to do. To change how we contact you, use Update my details."
        }
      ],
      "routes": []
    },
    {
      "stageKey": "welcome",
      "displayName": "Welcome, you are a member",
      "stageType": "Confirmation",
      "actor": "applicant",
      "queueKey": "public-visitor",
      "components": [
        {
          "type": "panel",
          "heading": "You are now a member"
        },
        {
          "type": "stat-group",
          "title": "Your membership",
          "items": [
            {
              "label": "Organisation",
              "fieldKey": "profileTenant"
            },
            {
              "label": "Membership id",
              "fieldKey": "memberId"
            },
            {
              "label": "Role",
              "fieldKey": "memberRole"
            }
          ]
        },
        {
          "type": "body",
          "content": "You can now use Update my details to change how we contact you."
        }
      ],
      "routes": []
    }
  ],
  "gateways": [
    {
      "key": "route-from-start",
      "displayName": "Look for an existing membership",
      "gatewayType": "Split",
      "queueKey": "public-visitor",
      "routes": [
        {
          "id": "route-from-start--continue--membership-checked",
          "target": "membership-checked",
          "trigger": "continue"
        },
        {
          "id": "route-from-start--continue--check-membership",
          "target": "check-membership",
          "trigger": "continue"
        }
      ]
    },
    {
      "key": "membership-checked",
      "displayName": "Membership checked",
      "gatewayType": "Join",
      "queueKey": "public-visitor",
      "routes": [
        {
          "id": "membership-checked--registered--already-a-member",
          "target": "already-a-member",
          "trigger": "registered"
        },
        {
          "id": "membership-checked--not-registered--your-details",
          "target": "your-details",
          "trigger": "not-registered"
        }
      ],
      "waitingContent": "We are checking your membership.",
      "waitingExpectedSeconds": 5,
      "waitingPollIntervalMs": 1000,
      "requiredIncomingQueues": [
        "public-visitor",
        "automation"
      ]
    },
    {
      "key": "route-from-your-details",
      "displayName": "Check your answers",
      "gatewayType": "Split",
      "queueKey": "public-visitor",
      "routes": [
        {
          "id": "route-from-your-details--continue--check-answers",
          "target": "check-answers",
          "trigger": "continue"
        }
      ]
    },
    {
      "key": "route-from-check-answers",
      "displayName": "Register your membership",
      "gatewayType": "Split",
      "queueKey": "public-visitor",
      "routes": [
        {
          "id": "route-from-check-answers--submit--registration-sent",
          "target": "registration-sent",
          "trigger": "submit"
        },
        {
          "id": "route-from-check-answers--submit--register-member",
          "target": "register-member",
          "trigger": "submit"
        }
      ]
    },
    {
      "key": "registration-sent",
      "displayName": "Registration sent",
      "gatewayType": "Join",
      "queueKey": "public-visitor",
      "routes": [
        {
          "id": "registration-sent--registered--welcome",
          "target": "welcome",
          "trigger": "registered"
        },
        {
          "id": "registration-sent--rejected--registration-rejected",
          "target": "registration-rejected",
          "trigger": "rejected"
        }
      ],
      "waitingContent": "We are setting up your membership.",
      "waitingExpectedSeconds": 5,
      "waitingPollIntervalMs": 1000,
      "requiredIncomingQueues": [
        "public-visitor",
        "automation"
      ]
    },
    {
      "key": "route-from-registration-rejected",
      "displayName": "Try again",
      "gatewayType": "Split",
      "queueKey": "public-visitor",
      "routes": [
        {
          "id": "route-from-registration-rejected--continue--your-details",
          "target": "your-details",
          "trigger": "continue"
        }
      ]
    }
  ]
}
