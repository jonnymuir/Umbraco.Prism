{
  "definitionKey": "apply-for-a-juggling-licence",
  "displayName": "Apply for a juggling licence",
  "version": 1,
  "schemaVersion": "1.0",
  "description": "Prism CMS Workflow reference example — a GDS-style public application journey, entirely hosted and authored in Umbraco with no separate business app.",
  "initialStage": "eligibility",
  "requestPolicy": "single",
  "allowManualRestart": true,
  "calculations": {
    "fields": {
      "member": {
        "source": "service",
        "shape": {
          "tier": { "valueKind": "string" },
          "name": { "valueKind": "string" },
          "email": { "valueKind": "string" }
        }
      },
      "isMember": { "expr": "member.tier <> ''" },
      "membershipTier": { "expr": "member.tier" },
      "memberName": { "expr": "member.name" },
      "memberEmail": { "expr": "member.email" },
      "feeAmount": {
        "expr": "if(licenceType = 'Competitive' or licenceType = 'Professional', 20, 25)",
        "format": "gbp"
      }
    }
  },
  "queues": [
    {
      "key": "public-visitor",
      "displayName": "Site visitor touchpoints",
      "description": "The site visitor applying for a juggling licence — anonymous, or a logged-in Prism Member.",
      "actor": "applicant"
    },
    {
      "key": "automation",
      "displayName": "Automated decision",
      "description": "Never human-visible — resolved entirely by the juggling-licence-decision Umbraco Automate automation calling back, not by anyone browsing a worklist.",
      "actor": "system"
    }
  ],
  "stages": [
    {
      "stageKey": "eligibility",
      "displayName": "Eligibility",
      "description": "Confirms the applicant meets the basic eligibility rules before collecting any details.",
      "stageType": "Question",
      "actor": "applicant",
      "queueKey": "public-visitor",
      "components": [
        {
          "type": "inset-text",
          "content": "You can apply for a juggling licence if you are 16 or over and have a UK postal address."
        },
        {
          "type": "fieldset",
          "children": [
            {
              "type": "boolean",
              "fieldKey": "age-confirmation",
              "label": "I confirm I am aged 16 or over",
              "required": true
            },
            {
              "type": "boolean",
              "fieldKey": "uk-address-confirmation",
              "label": "I confirm I have a UK postal address",
              "required": true
            }
          ]
        }
      ],
      "routes": [
        {
          "id": "eligibility--continue--route-from-eligibility",
          "target": "route-from-eligibility",
          "trigger": "continue"
        }
      ]
    },
    {
      "stageKey": "applicant-details",
      "displayName": "Your details",
      "stageType": "Question",
      "actor": "applicant",
      "queueKey": "public-visitor",
      "components": [
        {
          "type": "fieldset",
          "legend": "About you",
          "children": [
            {
              "type": "text",
              "maxLength": 100,
              "fieldKey": "full-name",
              "label": "Full name",
              "required": true,
              "defaultFrom": "memberName"
            },
            {
              "type": "email",
              "fieldKey": "email-address",
              "label": "Email address",
              "required": true,
              "defaultFrom": "memberEmail"
            },
            {
              "type": "date",
              "fieldKey": "date-of-birth",
              "label": "Date of birth",
              "hint": "For example, 12 03 1990",
              "required": true
            }
          ]
        }
      ],
      "routes": [
        {
          "id": "applicant-details--continue--route-from-applicant-details",
          "target": "route-from-applicant-details",
          "trigger": "continue"
        }
      ]
    },
    {
      "stageKey": "licence-details",
      "displayName": "Licence type",
      "stageType": "Question",
      "actor": "applicant",
      "queueKey": "public-visitor",
      "components": [
        {
          "type": "stat-group",
          "showWhen": "isMember",
          "title": "Your Juggling Society membership",
          "items": [
            { "label": "Membership tier", "fieldKey": "membershipTier" }
          ]
        },
        {
          "type": "inset-text",
          "showWhen": "isMember",
          "content": "Because you're signed in as a Juggling Society member, we've pre-selected the licence type below to match your membership tier shown above. If you're applying for a different type of licence, choose it instead — your answer here is what we'll use, whatever your membership says."
        },
        {
          "type": "fieldset",
          "children": [
            {
              "type": "radio",
              "fieldKey": "licenceType",
              "label": "What type of licence are you applying for?",
              "hint": "Choose the option that best matches how you plan to juggle. If we've pre-selected one for you above, you can still choose a different one.",
              "options": ["Recreational", "Competitive", "Professional"],
              "required": true,
              "defaultFrom": "membershipTier"
            }
          ]
        },
        {
          "type": "details",
          "heading": "How is my licence fee calculated?",
          "content": "The standard fee is £25. Competitive and Professional licences cost £20, whatever your membership tier — your membership only suggests which licence type to apply for, it doesn't set the fee on its own."
        },
        {
          "type": "fieldset",
          "children": [
            {
              "type": "boolean",
              "fieldKey": "declaration",
              "label": "I confirm the information I have given is accurate",
              "required": true
            }
          ]
        }
      ],
      "routes": [
        {
          "id": "licence-details--continue--route-from-licence-details",
          "target": "route-from-licence-details",
          "trigger": "continue"
        }
      ]
    },
    {
      "stageKey": "check-answers",
      "displayName": "Check your answers",
      "stageType": "CheckAnswers",
      "actor": "applicant",
      "queueKey": "public-visitor",
      "components": [
        {
          "type": "summary-list",
          "children": [
            {
              "type": "text",
              "fieldKey": "full-name",
              "label": "Full name",
              "required": true,
              "changeStateKey": "applicant-details"
            },
            {
              "type": "email",
              "fieldKey": "email-address",
              "label": "Email address",
              "required": true,
              "changeStateKey": "applicant-details"
            },
            {
              "type": "date",
              "fieldKey": "date-of-birth",
              "label": "Date of birth",
              "required": true,
              "changeStateKey": "applicant-details"
            },
            {
              "type": "radio",
              "fieldKey": "licenceType",
              "label": "Licence type",
              "options": ["Recreational", "Competitive", "Professional"],
              "required": true,
              "changeStateKey": "licence-details"
            }
          ]
        },
        {
          "type": "stat-group",
          "title": "Your licence fee",
          "items": [
            { "label": "Fee due", "fieldKey": "feeAmount", "emphasis": true }
          ]
        }
      ],
      "routes": [
        {
          "id": "check-answers--submit--route-from-check-answers",
          "target": "route-from-check-answers",
          "trigger": "submit"
        }
      ]
    },
    {
      "stageKey": "processing-application",
      "displayName": "Processing your application",
      "description": "Never human-visible — the applicant waits at the application-decided join gateway instead, while this stage's onEnter action calls out to the juggling-licence-decision Umbraco Automate automation.",
      "stageType": "Question",
      "actor": "system",
      "queueKey": "automation",
      "components": [],
      "actions": [
        {
          "type": "support-system-call",
          "timing": "onEnter",
          "params": {
            "supportSystemKey": "juggling-licence-decision",
            "capabilityKey": "decide-application",
            "inputs": {
              "licenceType": "licenceType",
              "applicantName": "full-name",
              "applicantEmail": "email-address"
            }
          }
        }
      ],
      "routes": [
        {
          "id": "processing-application--approved--application-decided",
          "target": "application-decided",
          "trigger": "approved"
        },
        {
          "id": "processing-application--referred--application-decided",
          "target": "application-decided",
          "trigger": "referred"
        }
      ]
    },
    {
      "stageKey": "confirmation",
      "displayName": "Application submitted",
      "stageType": "Confirmation",
      "actor": "applicant",
      "queueKey": "public-visitor",
      "components": [
        {
          "type": "panel",
          "heading": "Application submitted"
        },
        {
          "type": "heading",
          "level": 2,
          "content": "What happens next"
        },
        {
          "type": "stat-group",
          "title": "Decision",
          "items": [
            { "label": "Outcome", "fieldKey": "applicationDecisionNote" }
          ]
        },
        {
          "type": "body",
          "content": "We've sent a confirmation to the email address you gave us."
        },
        {
          "type": "body",
          "content": "Your juggling licence will arrive by post within 10 working days."
        }
      ],
      "routes": []
    }
  ],
  "gateways": [
    {
      "key": "route-from-eligibility",
      "displayName": "Continue to your details",
      "gatewayType": "Split",
      "queueKey": "public-visitor",
      "routes": [
        {
          "id": "route-from-eligibility--continue--applicant-details",
          "target": "applicant-details",
          "trigger": "continue"
        }
      ]
    },
    {
      "key": "route-from-applicant-details",
      "displayName": "Continue to licence type",
      "gatewayType": "Split",
      "queueKey": "public-visitor",
      "routes": [
        {
          "id": "route-from-applicant-details--continue--licence-details",
          "target": "licence-details",
          "trigger": "continue"
        }
      ]
    },
    {
      "key": "route-from-licence-details",
      "displayName": "Continue to check your answers",
      "gatewayType": "Split",
      "queueKey": "public-visitor",
      "routes": [
        {
          "id": "route-from-licence-details--continue--check-answers",
          "target": "check-answers",
          "trigger": "continue"
        }
      ]
    },
    {
      "key": "route-from-check-answers",
      "displayName": "Submit application",
      "gatewayType": "Split",
      "queueKey": "public-visitor",
      "routes": [
        {
          "id": "route-from-check-answers--submit--application-decided",
          "target": "application-decided",
          "trigger": "submit"
        },
        {
          "id": "route-from-check-answers--submit--processing-application",
          "target": "processing-application",
          "trigger": "submit"
        }
      ]
    },
    {
      "key": "application-decided",
      "displayName": "Application decided",
      "gatewayType": "Join",
      "queueKey": "public-visitor",
      "routes": [
        {
          "id": "application-decided--approved--confirmation",
          "target": "confirmation",
          "trigger": "approved"
        },
        {
          "id": "application-decided--referred--confirmation",
          "target": "confirmation",
          "trigger": "referred"
        }
      ],
      "waitingContent": "We're deciding your application. This usually takes just a few seconds.",
      "waitingExpectedSeconds": 10,
      "waitingPollIntervalMs": 2000,
      "requiredIncomingQueues": ["public-visitor", "automation"]
    }
  ]
}
