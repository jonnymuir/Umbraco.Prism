@using UmbracoPrism.Core.Models
@using Umbraco.Cms.Core.Models
@using Umbraco.Cms.Core.Models.Blocks
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@inject IPrismContext PrismContext
@{
    // 1. Resolve the Tenant once at the top level
    var tenant = PrismContext.CurrentTenant;

    var rootContent = Umbraco.ContentAtRoot().ToList();

    // 2. Resolve site-wide Settings node (Paul Seal pattern)
    var settings = TestSiteSeedContract.FindPublishedByAlias(rootContent, TestSiteSeedContract.SettingsAlias);
    var mobileNavLinks = settings?.Value<BlockListModel>("mobileNavLinks");
    var homeUrl = TestSiteSeedContract.ResolveUrl(
        TestSiteSeedContract.FindPublishedByAlias(rootContent, TestSiteSeedContract.HomePageAlias),
        TestSiteSeedContract.HomePageUrl);
    var workflowPageUrl = TestSiteSeedContract.ResolveUrl(
        TestSiteSeedContract.FindPublishedWorkflowPage(rootContent, TestSiteSeedContract.WorkflowKey),
        TestSiteSeedContract.WorkflowPageUrl);
    var workflowHubUrl = TestSiteSeedContract.ResolveUrl(
        TestSiteSeedContract.FindPublishedByAlias(rootContent, TestSiteSeedContract.WorkflowHubAlias),
        TestSiteSeedContract.WorkflowHubUrl);
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>@(tenant?.Name ?? "Prism") - @Model.Name</title>

    <!-- Site CSS (ITCSS layer order) -->
    <link rel="stylesheet" href="/css/base.css" />
    <link rel="stylesheet" href="/css/layout.css" />
    <link rel="stylesheet" href="/css/components.css" />
    <link rel="stylesheet" href="/css/utilities.css" />

    <!-- Branding CSS (feature showcase - tenant-specific CSS variable overrides) -->
    <!--
        Loaded after site CSS so tenant branding can safely override defaults.
        This keeps the demo honest: the branding layer is what partners will edit.
    -->
    <link rel="stylesheet" href="/branding/prism-branding.css" />

</head>
<body>

    <a href="#main-content" class="skip-link">Skip to main content</a>

    <prism-mobile-user-agent-demo />

    <header class="header">
        <div class="logo">
            <strong>@(tenant?.Name ?? "Prism Portal")</strong>
        </div>
        <nav aria-label="Main navigation">
            <a href="@homeUrl">Home</a>
            <a href="@workflowPageUrl">Get in Touch</a>
            <a href="@workflowHubUrl">My Workflows</a>
        </nav>
    </header>

    <main id="main-content" class="container">
        @RenderBody()
    </main>

    <footer class="footer">
        <p>&copy; @DateTime.Now.Year @(tenant?.Name ?? "Prism Portal") &mdash; Powered by Prism Multi-Tenant Engine</p>
    </footer>

    @if (mobileNavLinks != null)
    {
        @await Html.PartialAsync("_MobileShellNav", mobileNavLinks)
    }

    <!-- Workflow validation script -->
    <script src="/js/prism-workflow-validation.js" defer></script>
    
    <!-- Conditional fields script -->
    <script src="/js/prism-conditional-fields.js" defer></script>

</body>
</html>
