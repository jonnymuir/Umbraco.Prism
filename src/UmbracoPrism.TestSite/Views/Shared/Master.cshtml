@using UmbracoPrism.Core.Extensions
@using UmbracoPrism.Core.Models
@using UmbracoPrism.Core.Services
@using Umbraco.Cms.Core.Models
@using Umbraco.Cms.Core.Models.Blocks
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@inject IPrismContext PrismContext
@{
    // 1. Resolve the Tenant once at the top level
    var tenant = PrismContext.CurrentTenant;

    var rootContent = Umbraco.ContentAtRoot().ToList();

    // 2. Resolve site-wide Settings node (Paul Seal pattern)
    var settings = TestSiteSeedContract.FindPublishedByAlias(rootContent, TestSiteSeedContract.SettingsAlias);
    var mobileNavLinks = settings?.Value<BlockListModel>("mobileNavLinks");
    var webNavLinks = settings?.Value<BlockListModel>("webNavLinks");

    // SEC-PT2-004 CSP follow-up: Prism no longer auto-injects the mobile shell / biometric
    // scripts into the response — they're plain static assets (and, for branding, a plain
    // stylesheet endpoint) a host references explicitly, exactly like prism-mobile-nav.js
    // below. See docs/walkthroughs/building-a-mobile-app.md for the integration contract any
    // consuming host follows.
    var isPrismMobileRequest = PrismMobileRequestDetection.IsPrismMobileRequest(Context);
    var biometricLoginEnabled = isPrismMobileRequest && (tenant?.AllowBiometricLogin ?? false);
    var isAuthenticated = Context.User.Identity?.IsAuthenticated == true;

    // The UA-mock toggle is a dev/QA aid for exercising mobile rendering from a desktop
    // browser without installing the app — it must stay reachable on ANY browser, in ANY
    // environment, including prismreference.com itself (implementers testing mobile rendering
    // from the web is a real, wanted use of the reference app), and including while a cookie
    // currently has mobile faked ON — that's exactly when it's needed most, to turn the fake
    // back off (found live: gating this off outside Development left no way to undo a stuck
    // cookie on a deployed site). IsNativeMobileRequest, not IsPrismMobileRequest, is the only
    // check that belongs here: it looks solely at the raw User-Agent header (unfakeable from a
    // normal browser), so it's the one signal that's actually true only inside the genuine
    // compiled app — see its own doc comment for why the plain negation of
    // IsPrismMobileRequest would be wrong (the real app's own first page load carries
    // ?prismMobile=1, which would misread as "not native").
    var showMobileUaDemo = !PrismMobileRequestDetection.IsNativeMobileRequest(Context);
}

<!DOCTYPE html>
<html lang="en" class="govuk-template">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>@(tenant?.Name ?? "Prism") - @Model.Name</title>

    <!-- GOV.UK Design System CSS (loaded first) -->
    <link rel="stylesheet" href="/css/govuk-frontend.min.css" />

    <!-- Wayfinder.Rendering.GovUk's own component CSS (slider/stat-group/chart/bulk-data-review). -->
    <link rel="stylesheet" href="/_content/Wayfinder.Rendering.GovUk/css/wayfinder-components.css" />

    <!-- Site CSS (ITCSS layer order) -->
    <link rel="stylesheet" href="/css/base.css" />
    <link rel="stylesheet" href="/css/layout.css" />
    <link rel="stylesheet" href="/css/components.css" />
    <link rel="stylesheet" href="/css/utilities.css" />

    <!-- Branding CSS (feature showcase - tenant-specific CSS variable overrides) -->
    <!--
        Loaded after site CSS so tenant branding can safely override defaults.
        This keeps the demo honest: the branding layer is what partners will edit.
    -->
    <link rel="stylesheet" href="/branding/prism-branding.css" />

    <!-- Per-tenant branding overrides (SEC-PT2-004: served as its own resource, not spliced
         inline, so it needs no CSP unsafe-inline/nonce exception). Loaded last so tenant
         overrides win the cascade; always a valid — if possibly empty — stylesheet. -->
    <link rel="stylesheet" href="/umbraco/prism/branding.css" />

    @if (isPrismMobileRequest)
    {
        <link rel="stylesheet" href="/App_Plugins/UmbracoPrism/mobile-shell/prism-mobile-shell.css" />
    }

</head>
<body class="govuk-template__body">

    <a href="#main-content" class="skip-link">Skip to main content</a>

    @if (showMobileUaDemo)
    {
        <prism-mobile-user-agent-demo />
    }

    <header class="header">
        <div class="logo">
            <strong>@(tenant?.Name ?? "Prism Portal")</strong>
        </div>
        @if (!isPrismMobileRequest)
        {
            @await Html.PartialAsync("_DesktopNav", webNavLinks)
        }
    </header>

    <main id="main-content" class="container">
        @RenderBody()
    </main>

    <footer class="footer">
        <p>&copy; @DateTime.Now.Year @(tenant?.Name ?? "Prism Portal") &mdash; Powered by Prism Multi-Tenant Engine</p>
    </footer>

    @if (isPrismMobileRequest && mobileNavLinks != null)
    {
        @await Html.PartialAsync("_MobileShellNav", mobileNavLinks)
    }

    <!-- GOV.UK Frontend JavaScript bootstrap (100% static — see the file's own comment for
         why it's a module). Externalized (not spliced inline) so it needs no CSP
         unsafe-inline/nonce exception for script-src, same rationale as the branding/
         mobile-shell/biometric assets and the mobile-UA-demo widget. -->
    <script type="module" src="/js/govuk-frontend-bootstrap.js"></script>

    <!-- Service request validation script -->
    <script src="/js/prism-service-request-validation.js" defer></script>

    <!-- Conditional fields script -->
    <script src="/js/prism-conditional-fields.js" defer></script>

    <!-- Wayfinder.Rendering.GovUk's own bulk-data-review script — the component is entirely
         client-fetched, so this has no server-side equivalent. -->
    <script src="/_content/Wayfinder.Rendering.GovUk/js/wayfinder-bulk-data-review.js"></script>

    @if (isPrismMobileRequest)
    {
        <script src="/App_Plugins/UmbracoPrism/mobile-shell/prism-mobile-shell-guard.js"></script>
        @* Feeds the native paint-holding pipeline's cached-frame refresh — see the script's own
           remarks for why this replaced an earlier native WKUserScript-based attempt entirely.
           Unconditional on every mobile page, not gated on authentication, since paint-holding
           matters everywhere in the app, not just signed-in pages. *@
        <script src="/App_Plugins/UmbracoPrism/mobile-shell/prism-mobile-content-watcher.js"></script>
    }

    @if (biometricLoginEnabled)
    {
        @* Enroll if a session already exists to enroll a device against; otherwise attempt
           silent auto-login from a previously-enrolled device's stored credential. *@
        if (isAuthenticated)
        {
            <script src="/App_Plugins/UmbracoPrism/mobile-shell/prism-biometric-enroll.js"></script>
        }
        else
        {
            <script src="/App_Plugins/UmbracoPrism/mobile-shell/prism-biometric-autologin.js"></script>
        }
    }

    @if (isPrismMobileRequest && isAuthenticated)
    {
        @* Deliberately not gated on biometricLoginEnabled — the silent-logout half of this
           script (avoiding Entra's own account-picker interstitial inside the app's one
           WebView) matters for every mobile sign-out, not just biometric-enabled tenants; the
           biometric-revoke calls it also makes are harmless no-ops when nothing was ever
           enrolled. See the script's own remarks.

           data-prism-idp-hosts feeds the native cookie-store cleanup this script also fires —
           the concrete host(s) the current tenant's IdP sets its own SSO session cookie on,
           resolved server-side (the same tenant data PrismSecurityHeadersMiddleware already
           derives CSP hosts from) since the client has no other way to know it. *@
        <script src="/App_Plugins/UmbracoPrism/mobile-shell/prism-biometric-signout.js"
                data-prism-idp-hosts="@string.Join(",", PrismIdentityProviderHosts.Resolve(tenant))"></script>

        @* Same reasoning as above, applied to push: whether the native FirebaseMessaging plugin
           is actually compiled into this build is a bundle-generation-time decision
           (--push-notifications, see MobileBundleService.cs), not a per-tenant runtime toggle
           like AllowBiometricLogin, so there's no equivalent AllowPushNotifications tenant flag
           to gate on here. On a build without the plugin, the nativePromise calls inside just
           throw and are caught — a harmless no-op, same as the biometric-revoke calls above. *@
        <script src="/App_Plugins/UmbracoPrism/mobile-shell/prism-push-register.js"></script>
    }

</body>
</html>
