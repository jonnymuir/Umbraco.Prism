@using UmbracoPrism.Core.Models
@using Umbraco.Cms.Core.Models
@using Umbraco.Cms.Core.Models.Blocks
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@inject IPrismContext PrismContext
@{
    // 1. Resolve the Tenant once at the top level
    var tenant = PrismContext.CurrentTenant;

    var rootContent = Umbraco.ContentAtRoot().ToList();

    // 2. Resolve site-wide Settings node (Paul Seal pattern)
    var settings = TestSiteSeedContract.FindPublishedByAlias(rootContent, TestSiteSeedContract.SettingsAlias);
    var mobileNavLinks = settings?.Value<BlockListModel>("mobileNavLinks");
    var webNavLinks = settings?.Value<BlockListModel>("webNavLinks");
}

<!DOCTYPE html>
<html lang="en" class="govuk-template">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>@(tenant?.Name ?? "Prism") - @Model.Name</title>

    <!-- GOV.UK Design System CSS (loaded first) -->
    <link rel="stylesheet" href="/css/govuk-frontend.min.css" />

    <!-- Site CSS (ITCSS layer order) -->
    <link rel="stylesheet" href="/css/base.css" />
    <link rel="stylesheet" href="/css/layout.css" />
    <link rel="stylesheet" href="/css/components.css" />
    <link rel="stylesheet" href="/css/utilities.css" />

    <!-- Branding CSS (feature showcase - tenant-specific CSS variable overrides) -->
    <!--
        Loaded after site CSS so tenant branding can safely override defaults.
        This keeps the demo honest: the branding layer is what partners will edit.
    -->
    <link rel="stylesheet" href="/branding/prism-branding.css" />

</head>
<body class="govuk-template__body">

    <a href="#main-content" class="skip-link">Skip to main content</a>

    <prism-mobile-user-agent-demo />

    <header class="header">
        <div class="logo">
            <strong>@(tenant?.Name ?? "Prism Portal")</strong>
        </div>
        @await Html.PartialAsync("_DesktopNav", webNavLinks)
    </header>

    <main id="main-content" class="container">
        @RenderBody()
    </main>

    <footer class="footer">
        <p>&copy; @DateTime.Now.Year @(tenant?.Name ?? "Prism Portal") &mdash; Powered by Prism Multi-Tenant Engine</p>
    </footer>

    @if (mobileNavLinks != null)
    {
        @await Html.PartialAsync("_MobileShellNav", mobileNavLinks)
    }

    <!-- GOV.UK Frontend JavaScript — v5 ships as an ES module (see the dist file's own
         README), not a UMD/global-attaching bundle, so it must be loaded with type="module"
         and initAll imported explicitly. window.GOVUKFrontend is assigned here purely so
         existing call sites (and this behaviour's own regression test) can keep checking
         it, matching the shape the previous classic-script version exposed. -->
    <script type="module">
        import { initAll } from '/js/govuk-frontend.min.js';
        window.GOVUKFrontend = { initAll };
        initAll();
    </script>

    <!-- Service request validation script -->
    <script src="/js/prism-service-request-validation.js" defer></script>
    
    <!-- Conditional fields script -->
    <script src="/js/prism-conditional-fields.js" defer></script>

</body>
</html>
