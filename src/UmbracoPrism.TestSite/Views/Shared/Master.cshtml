@using UmbracoPrism.Core.Extensions
@using UmbracoPrism.Core.Models
@using Umbraco.Cms.Core.Models
@using Umbraco.Cms.Core.Models.Blocks
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@inject IPrismContext PrismContext
@{
    // 1. Resolve the Tenant once at the top level
    var tenant = PrismContext.CurrentTenant;

    var rootContent = Umbraco.ContentAtRoot().ToList();

    // 2. Resolve site-wide Settings node (Paul Seal pattern)
    var settings = TestSiteSeedContract.FindPublishedByAlias(rootContent, TestSiteSeedContract.SettingsAlias);
    var mobileNavLinks = settings?.Value<BlockListModel>("mobileNavLinks");
    var webNavLinks = settings?.Value<BlockListModel>("webNavLinks");

    // SEC-PT2-004 CSP follow-up: Prism no longer auto-injects the mobile shell / biometric
    // scripts into the response — they're plain static assets (and, for branding, a plain
    // stylesheet endpoint) a host references explicitly, exactly like prism-mobile-nav.js
    // below. See docs/walkthroughs/building-a-mobile-app.md for the integration contract any
    // consuming host follows.
    var isPrismMobileRequest = PrismMobileRequestDetection.IsPrismMobileRequest(Context);
    var biometricLoginEnabled = isPrismMobileRequest && (tenant?.AllowBiometricLogin ?? false);
    var isAuthenticated = Context.User.Identity?.IsAuthenticated == true;
}

<!DOCTYPE html>
<html lang="en" class="govuk-template">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>@(tenant?.Name ?? "Prism") - @Model.Name</title>

    <!-- GOV.UK Design System CSS (loaded first) -->
    <link rel="stylesheet" href="/css/govuk-frontend.min.css" />

    <!-- Wayfinder.Rendering.GovUk's own component CSS (slider/stat-group/chart/bulk-data-review). -->
    <link rel="stylesheet" href="/_content/Wayfinder.Rendering.GovUk/css/wayfinder-components.css" />

    <!-- Site CSS (ITCSS layer order) -->
    <link rel="stylesheet" href="/css/base.css" />
    <link rel="stylesheet" href="/css/layout.css" />
    <link rel="stylesheet" href="/css/components.css" />
    <link rel="stylesheet" href="/css/utilities.css" />

    <!-- Branding CSS (feature showcase - tenant-specific CSS variable overrides) -->
    <!--
        Loaded after site CSS so tenant branding can safely override defaults.
        This keeps the demo honest: the branding layer is what partners will edit.
    -->
    <link rel="stylesheet" href="/branding/prism-branding.css" />

    <!-- Per-tenant branding overrides (SEC-PT2-004: served as its own resource, not spliced
         inline, so it needs no CSP unsafe-inline/nonce exception). Loaded last so tenant
         overrides win the cascade; always a valid — if possibly empty — stylesheet. -->
    <link rel="stylesheet" href="/umbraco/prism/branding.css" />

    @if (isPrismMobileRequest)
    {
        <link rel="stylesheet" href="/App_Plugins/UmbracoPrism/mobile-shell/prism-mobile-shell.css" />
    }

</head>
<body class="govuk-template__body">

    <a href="#main-content" class="skip-link">Skip to main content</a>

    <prism-mobile-user-agent-demo />

    <header class="header">
        <div class="logo">
            <strong>@(tenant?.Name ?? "Prism Portal")</strong>
        </div>
        @await Html.PartialAsync("_DesktopNav", webNavLinks)
    </header>

    <main id="main-content" class="container">
        @RenderBody()
    </main>

    <footer class="footer">
        <p>&copy; @DateTime.Now.Year @(tenant?.Name ?? "Prism Portal") &mdash; Powered by Prism Multi-Tenant Engine</p>
    </footer>

    @if (mobileNavLinks != null)
    {
        @await Html.PartialAsync("_MobileShellNav", mobileNavLinks)
    }

    <!-- GOV.UK Frontend JavaScript — v5 ships as an ES module (see the dist file's own
         README), not a UMD/global-attaching bundle, so it must be loaded with type="module"
         and initAll imported explicitly. window.GOVUKFrontend is assigned here purely so
         existing call sites (and this behaviour's own regression test) can keep checking
         it, matching the shape the previous classic-script version exposed. -->
    <script type="module">
        import { initAll } from '/js/govuk-frontend.min.js';
        window.GOVUKFrontend = { initAll };
        initAll();
    </script>

    <!-- Service request validation script -->
    <script src="/js/prism-service-request-validation.js" defer></script>

    <!-- Conditional fields script -->
    <script src="/js/prism-conditional-fields.js" defer></script>

    <!-- Wayfinder.Rendering.GovUk's own bulk-data-review script — the component is entirely
         client-fetched, so this has no server-side equivalent. -->
    <script src="/_content/Wayfinder.Rendering.GovUk/js/wayfinder-bulk-data-review.js"></script>

    @if (isPrismMobileRequest)
    {
        <script src="/App_Plugins/UmbracoPrism/mobile-shell/prism-mobile-shell-guard.js"></script>
    }

    @if (biometricLoginEnabled)
    {
        @* Enroll if a session already exists to enroll a device against; otherwise attempt
           silent auto-login from a previously-enrolled device's stored credential. *@
        if (isAuthenticated)
        {
            <script src="/App_Plugins/UmbracoPrism/mobile-shell/prism-biometric-enroll.js"></script>
        }
        else
        {
            <script src="/App_Plugins/UmbracoPrism/mobile-shell/prism-biometric-autologin.js"></script>
        }
    }

</body>
</html>
