@using UmbracoPrism.Core.Models
@using Umbraco.Cms.Core.Models
@using Umbraco.Cms.Core.Models.Blocks
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@inject IPrismContext PrismContext
@{
    // 1. Resolve the Tenant once at the top level
    var tenant = PrismContext.CurrentTenant;
    var brandColor = tenant?.ThemeColor ?? "#3544b1";
    
    // 2. Resolve site-wide Settings node (Paul Seal pattern)
    var settings = Umbraco.ContentAtRoot().FirstOrDefault(x => x.ContentType.Alias == "settings");
    var mobileNavLinks = settings?.Value<BlockListModel>("mobileNavLinks");
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>@(tenant?.Name ?? "Prism") - @Model.Name</title>

    <!-- Branding CSS (feature showcase - tenant-specific CSS variable overrides) -->
    <link rel="stylesheet" href="/branding/prism-branding.css" />

    <!-- Site CSS (ITCSS layer order) -->
    <link rel="stylesheet" href="/css/base.css" />
    <link rel="stylesheet" href="/css/layout.css" />
    <link rel="stylesheet" href="/css/components.css" />
    <link rel="stylesheet" href="/css/utilities.css" />

    <style>
        :root {
            /* --tenant-primary is set by the Prism Dashboard and injected server-side */
            --tenant-primary: @brandColor;
        }
    </style>
</head>
<body>

    <prism-mobile-user-agent-demo />

    <header class="header">
        <div class="logo">
            <strong>@(tenant?.Name ?? "Prism Portal")</strong>
        </div>
        <nav>
            <span style="font-size: 0.8rem; opacity: 0.8;">@Context.Request.Host</span>
        </nav>
    </header>

    <div class="container">
        @RenderBody()
    </div>

    <footer class="footer">
        &copy; @DateTime.Now.Year - Managed by Prism Multi-Tenant Engine
    </footer>

    @if (mobileNavLinks != null)
    {
        @Html.Partial("_MobileShellNav", mobileNavLinks)
    }

</body>
</html>