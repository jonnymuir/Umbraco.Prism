@using UmbracoPrism.Core.Models.Workflow
@model FieldRenderPayload

@{
    var hasHint = !string.IsNullOrEmpty(Model.Hint);
    var hintId = $"{Model.FieldKey}-hint";
    var fieldError = ViewData["fieldError"] as string;
    var hasFieldError = !string.IsNullOrEmpty(fieldError);
    var errorId = $"{Model.FieldKey}-error";
    
    // Build aria-describedby to include hint and/or error
    var describedByParts = new System.Collections.Generic.List<string>();
    if (hasHint) describedByParts.Add(hintId);
    if (hasFieldError) describedByParts.Add(errorId);
    var describedBy = describedByParts.Count > 0 ? $@" aria-describedby=""{string.Join(" ", describedByParts)}""" : string.Empty;
    
    var ariaRequired = Model.Required ? @" aria-required=""true""" : string.Empty;
    var ariaInvalid = hasFieldError ? @" aria-invalid=""true""" : string.Empty;
    var requiredAttr = Model.Required ? " required" : string.Empty;
    var fieldType = Model.FieldType?.ToLowerInvariant() ?? "text";
    
    // HTML5 constraint attributes
    var minLengthAttr = Model.MinLength.HasValue ? $@" minlength=""{Model.MinLength.Value}""" : string.Empty;
    var maxLengthAttr = Model.MaxLength.HasValue ? $@" maxlength=""{Model.MaxLength.Value}""" : string.Empty;
    var patternAttr = !string.IsNullOrEmpty(Model.Pattern) ? $@" pattern=""{Model.Pattern}""" : string.Empty;
    var minAttr = Model.Min.HasValue ? $@" min=""{Model.Min.Value}""" : string.Empty;
    var maxAttr = Model.Max.HasValue ? $@" max=""{Model.Max.Value}""" : string.Empty;
    
    // Conditional field attributes
    var isConditional = !string.IsNullOrEmpty(Model.ConditionalOn);
    var conditionalClass = isConditional ? " prism-field--conditional" : string.Empty;
    var conditionalOnAttr = $@" data-conditional-on=""{Model.ConditionalOn ?? string.Empty}""";
    var visibleWhenAttr = $@" data-visible-when=""{Model.VisibleWhen ?? string.Empty}""";
    var hiddenAttr = isConditional ? " hidden" : string.Empty;
    var ariaHidden = isConditional ? @" aria-hidden=""true""" : string.Empty;
}

<div class="prism-form-group @(hasFieldError ? "prism-form-group--error" : "")@conditionalClass"@Html.Raw(conditionalOnAttr)@Html.Raw(visibleWhenAttr)@Html.Raw(hiddenAttr)@Html.Raw(ariaHidden)>

    @if (fieldType == "boolean")
    {
        <div class="prism-form-group__checkbox-wrapper">
            <input class="prism-checkbox"
                   type="checkbox"
                   id="@Model.FieldKey"
                   name="fields[@Model.FieldKey]"
                   value="true"
                   @(Model.Value is true || "true".Equals(Model.Value?.ToString(), StringComparison.OrdinalIgnoreCase) ? "checked" : "")
                   @Html.Raw(requiredAttr)
                   @Html.Raw(ariaRequired)
                   @Html.Raw(ariaInvalid)
                   @Html.Raw(describedBy) />
            <label class="prism-label prism-label--inline" for="@Model.FieldKey">
                @Model.Label
                @if (Model.Required)
                {
                    <span class="prism-required" aria-hidden="true">*</span>
                }
            </label>
        </div>
    }
    else if (fieldType == "radio")
    {
        <fieldset class="prism-fieldset">
            <legend class="prism-legend">
                @Model.Label
                @if (Model.Required)
                {
                    <span class="prism-required" aria-hidden="true">*</span>
                }
            </legend>
            @if (hasHint)
            {
                <div class="prism-hint" id="@hintId">@Model.Hint</div>
            }
            @if (Model.Options != null)
            {
                foreach (var option in Model.Options)
                {
                    var radioId = $"{Model.FieldKey}-{option.ToLowerInvariant().Replace(" ", "-")}";
                    <div class="prism-radio-item">
                        <input class="prism-radio"
                               type="radio"
                               id="@radioId"
                               name="fields[@Model.FieldKey]"
                               value="@option"
                               @(option.Equals(Model.Value?.ToString(), StringComparison.OrdinalIgnoreCase) ? "checked" : "")
                               @Html.Raw(requiredAttr)
                               @Html.Raw(ariaRequired)
                               @Html.Raw(ariaInvalid) />
                        <label class="prism-label prism-label--inline" for="@radioId">@option</label>
                    </div>
                }
            }
        </fieldset>
    }
    else if (fieldType == "checkboxlist")
    {
        <fieldset class="prism-fieldset">
            <legend class="prism-legend">
                @Model.Label
                @if (Model.Required)
                {
                    <span class="prism-required" aria-hidden="true">*</span>
                }
            </legend>
            @if (hasHint)
            {
                <div class="prism-hint" id="@hintId">@Model.Hint</div>
            }
            @if (hasFieldError)
            {
                <p class="prism-field-error" id="@errorId" role="alert">@fieldError</p>
            }
            @if (Model.Options != null)
            {
                foreach (var option in Model.Options)
                {
                    var cbId = $"{Model.FieldKey}-{option.ToLowerInvariant().Replace(" ", "-")}";
                    <div class="prism-checkbox-item">
                        <input class="prism-checkbox"
                               type="checkbox"
                               id="@cbId"
                               name="fields[@Model.FieldKey]"
                               value="@option"
                               @Html.Raw(requiredAttr)
                               @Html.Raw(ariaRequired)
                               @Html.Raw(ariaInvalid) />
                        <label class="prism-label prism-label--inline" for="@cbId">@option</label>
                    </div>
                }
            }
        </fieldset>
    }
    else if (fieldType == "select")
    {
        <label class="prism-label" for="@Model.FieldKey">
            @Model.Label
            @if (Model.Required)
            {
                <span class="prism-required" aria-hidden="true">*</span>
            }
        </label>
        @if (hasHint)
        {
            <div class="prism-hint" id="@hintId">@Model.Hint</div>
        }
        @if (hasFieldError)
        {
            <p class="prism-field-error" id="@errorId" role="alert">@fieldError</p>
        }
        <select class="prism-select"
                id="@Model.FieldKey"
                name="fields[@Model.FieldKey]"
                @Html.Raw(requiredAttr)
                @Html.Raw(ariaRequired)
                @Html.Raw(ariaInvalid)
                @Html.Raw(describedBy)>
            <option value="">-- Select --</option>
            @if (Model.Options != null)
            {
                foreach (var option in Model.Options)
                {
                    var isSelected = option.Equals(Model.Value?.ToString(), StringComparison.OrdinalIgnoreCase);
                    if (isSelected)
                    {
                        <option value="@option" selected="selected">@option</option>
                    }
                    else
                    {
                        <option value="@option">@option</option>
                    }
                }
            }
        </select>
    }
    else if (fieldType == "textarea")
    {
        <label class="prism-label" for="@Model.FieldKey">
            @Model.Label
            @if (Model.Required)
            {
                <span class="prism-required" aria-hidden="true">*</span>
            }
        </label>
        @if (hasHint)
        {
            <div class="prism-hint" id="@hintId">@Model.Hint</div>
        }
        @if (hasFieldError)
        {
            <p class="prism-field-error" id="@errorId" role="alert">@fieldError</p>
        }
        <textarea class="prism-textarea"
                  id="@Model.FieldKey"
                  name="fields[@Model.FieldKey]"
                  rows="5"
                  @Html.Raw(requiredAttr)
                  @Html.Raw(minLengthAttr)
                  @Html.Raw(maxLengthAttr)
                  @Html.Raw(ariaRequired)
                  @Html.Raw(ariaInvalid)
                  @Html.Raw(describedBy)>@Model.Value</textarea>
    }
    else
    {
        @* Handles: text, email, number, decimal, date, datetime, and unknown fallback *@
        var inputType = fieldType switch
        {
            "email" => "email",
            "number" or "decimal" => "number",
            "date" => "date",
            "datetime" => "datetime-local",
            _ => "text"
        };
        var step = fieldType == "decimal" ? @" step=""any""" : string.Empty;

        <label class="prism-label" for="@Model.FieldKey">
            @Model.Label
            @if (Model.Required)
            {
                <span class="prism-required" aria-hidden="true">*</span>
            }
        </label>
        @if (hasHint)
        {
            <div class="prism-hint" id="@hintId">@Model.Hint</div>
        }
        @if (hasFieldError)
        {
            <p class="prism-field-error" id="@errorId" role="alert">@fieldError</p>
        }
        var constraintAttrs = string.Empty;
        if (inputType == "text" || inputType == "email")
        {
            constraintAttrs = minLengthAttr + maxLengthAttr + patternAttr;
        }
        else if (inputType == "number")
        {
            constraintAttrs = minAttr + maxAttr;
        }
        <input class="prism-input"
               type="@inputType"
               id="@Model.FieldKey"
               name="fields[@Model.FieldKey]"
               value="@Model.Value"
               @Html.Raw(step)
               @Html.Raw(requiredAttr)
               @Html.Raw(constraintAttrs)
               @Html.Raw(ariaRequired)
               @Html.Raw(ariaInvalid)
               @Html.Raw(describedBy) />
    }


</div>
