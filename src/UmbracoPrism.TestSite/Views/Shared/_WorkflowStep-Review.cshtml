@using UmbracoPrism.Core.Models.Workflow
@model WorkflowRenderPayload

<div class="prism-workflow prism-workflow--review">
    <h2 class="prism-workflow__heading">@Model.StateDisplayName</h2>

    @foreach (var group in Model.FieldGroups)
    {
        <section class="prism-review__group" aria-label="@group.DisplayName">
            @if (!string.IsNullOrEmpty(group.DisplayName))
            {
                <h3 class="prism-review__group-title">@group.DisplayName</h3>
            }

            <dl class="prism-review__list">
                @foreach (var field in group.Fields)
                {
                    <div class="prism-review__item">
                        <dt class="prism-review__label">@field.Label</dt>
                        <dd class="prism-review__value">
                            @if (field.Value != null)
                            {
                                @field.Value.ToString()
                            }
                            else
                            {
                                <span class="prism-review__empty">Not provided</span>
                            }
                        </dd>
                    </div>
                }
            </dl>
        </section>
    }

    <form method="post" novalidate>
        @Html.AntiForgeryToken()
        <div class="prism-workflow__actions">
            @foreach (var action in Model.AvailableActions)
            {
                var buttonClass = action.Style switch
                {
                    "primary" => "prism-button prism-button--primary",
                    "destructive" => "prism-button prism-button--destructive",
                    _ => "prism-button prism-button--secondary"
                };
                <button type="submit"
                        name="action"
                        value="@action.ActionKey"
                        class="@buttonClass">
                    @action.Label
                </button>
            }
        </div>
    </form>
</div>
