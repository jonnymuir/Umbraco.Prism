@using UmbracoPrism.Core.Models.Workflow
@model WorkflowRenderPayload

@{
    var backAction = Model.AvailableActions.FirstOrDefault(a =>
        a.ActionKey.Equals("back", StringComparison.OrdinalIgnoreCase));
    var primaryActions = Model.AvailableActions.Where(a =>
        !a.ActionKey.Equals("back", StringComparison.OrdinalIgnoreCase)).ToList();
}

<div class="prism-workflow">
    <form method="post" novalidate>
        @Html.AntiForgeryToken()

        @foreach (var group in Model.FieldGroups)
        {
            <fieldset class="prism-workflow__fieldset">
                <legend class="prism-workflow__legend">@group.DisplayName</legend>
                @foreach (var field in group.Fields)
                {
                    @Html.Partial("_WorkflowField", field)
                }
            </fieldset>
        }

        <div class="prism-workflow__actions">
            @if (backAction != null)
            {
                <button type="submit"
                        name="action"
                        value="@backAction.ActionKey"
                        class="prism-button prism-button--secondary">
                    &larr; Back
                </button>
            }

            @foreach (var action in primaryActions)
            {
                var buttonClass = action.Style switch
                {
                    "primary" => "prism-button prism-button--primary",
                    "destructive" => "prism-button prism-button--destructive",
                    _ => "prism-button prism-button--secondary"
                };
                <button type="submit"
                        name="action"
                        value="@action.ActionKey"
                        class="@buttonClass">
                    @action.Label
                </button>
            }
        </div>
    </form>
</div>
