@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
    Layout = "~/Views/Shared/Master.cshtml";
    var genreName = Model.Value<string>("genre") ?? Model.Name;
    var description = Model.Value<string>("description") ?? "";
    
    // Get all vinyl records in this genre
    var vinyls = Model.Children()
        .Where(child => child.ContentType.Alias == "vinylRecord")
        .ToList();
}

<div class="genre-landing">
    <div class="genre-header">
        <h1>@genreName</h1>
        @if (!string.IsNullOrWhiteSpace(description))
        {
            <p class="genre-description">@description</p>
        }
        
        @* Subscription button - will be wired to notification API *@
        <button class="btn-subscribe" data-action="toggle-subscription" data-genre="@genreName">
            🔔 Subscribe to @genreName Notifications
        </button>
    </div>

    <div class="vinyl-collection">
        <h2>Available Records (@vinyls.Count)</h2>
        <div class="vinyl-grid">
            @foreach (var vinyl in vinyls)
            {
                var title = vinyl.Value<string>("title") ?? vinyl.Name;
                var artist = vinyl.Value<string>("artist") ?? "";
                var releaseYear = vinyl.Value<int?>("releaseYear");
                var inStock = vinyl.Value<bool>("inStock");
                var isLimitedEdition = vinyl.Value<bool>("isLimitedEdition");
                
                <a href="@vinyl.Url()" class="vinyl-card @(!inStock ? "out-of-stock" : "")">
                    <div class="vinyl-cover">
                        @* Cover image placeholder *@
                        <div class="placeholder-cover">🎶</div>
                    </div>
                    <div class="vinyl-info">
                        <h3>@artist</h3>
                        <p class="vinyl-title">@title</p>
                        @if (releaseYear.HasValue)
                        {
                            <p class="vinyl-year">@releaseYear.Value</p>
                        }
                        <div class="vinyl-badges">
                            @if (!inStock)
                            {
                                <span class="badge badge-out-of-stock">Out of Stock</span>
                            }
                            else if (isLimitedEdition)
                            {
                                <span class="badge badge-limited">Limited Edition</span>
                            }
                            else
                            {
                                <span class="badge badge-in-stock">In Stock</span>
                            }
                        </div>
                    </div>
                </a>
            }
        </div>
    </div>
</div>

<!-- Subscribe demo action (SEC-PT2-004: externalized, not spliced inline). -->
<script src="/js/vinyl-genre-landing-actions.js"></script>
