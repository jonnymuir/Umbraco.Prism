@using System.Net.Http
@using System.Net.Http.Headers
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage

@{
    Layout = null;

    async Task<string> CallBackOfficeAsync()
    {
        try
        {
            using var client = new HttpClient();

            // This could throw if Key Vault is down or Refresh Token is rejected
            var authHeader = await PrismContext.GetAuthorizationHeaderAsync();

            if (authHeader == null)
            {
                return "User is not authenticated or session has expired.";
            }

            client.DefaultRequestHeaders.Authorization = authHeader;

            // Standard timeout to prevent hanging the UI
            client.Timeout = TimeSpan.FromSeconds(10);

            var response = await client.GetAsync("http://localhost:5163/api/backoffice/me");

            if (response.IsSuccessStatusCode)
            {
                return await response.Content.ReadAsStringAsync();
            }

            // Handle specific status codes if needed
            if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                return "API Error: Unauthorized. Your session is invalid. Please log in again.";
            }

            return $"API Error: {response.StatusCode} - {await response.Content.ReadAsStringAsync()}";
        }
        catch (HttpRequestException ex)
        {
            // Network-level issues (DNS, connection refused, etc.)
            return $"Network Error: Could not reach the Back Office. {ex.Message}";
        }
        catch (Exception ex)
        {
            // Catch-all for unexpected logic errors or vault failures
            return $"System Error: {ex.Message}";
        }
    }

    string apiResult = "Not called yet.";
    if (Context.Request.Query.ContainsKey("callApi"))
    {
        apiResult = await CallBackOfficeAsync();
    }

    var heroImage = Model?.Value<IPublishedContent>("heroImage");
    var cardImage = Model?.Value<IPublishedContent>("cardImage");
    var heroImageUrl = heroImage?.Url();
    var cardImageUrl = cardImage?.Url();
    var hasImageryOverrides = !string.IsNullOrWhiteSpace(heroImageUrl) || !string.IsNullOrWhiteSpace(cardImageUrl);

    var imageryCss = new System.Text.StringBuilder();
    if (hasImageryOverrides)
    {
        imageryCss.Append(":root{");
        if (!string.IsNullOrWhiteSpace(heroImageUrl))
        {
            imageryCss.Append($"--prism-hero-image:url('{heroImageUrl}');");
        }
        if (!string.IsNullOrWhiteSpace(cardImageUrl))
        {
            imageryCss.Append($"--prism-card-image:url('{cardImageUrl}');");
        }
        imageryCss.Append('}');
    }
}

<!DOCTYPE html>
<html>

<head>
    <title>Prism Home</title>
    <link rel="stylesheet" href="/branding/prism-colors.css" />
    <link rel="stylesheet" href="/branding/prism-typography.css" />
    <link rel="stylesheet" href="/branding/prism-layout.css" />
    <link rel="stylesheet" href="/branding/prism-imagery.css" />
    <link rel="stylesheet" href="/branding/prism-components.css" />
    @if (hasImageryOverrides)
    {
        <style>
            @Html.Raw(imageryCss.ToString())
        </style>
    }
    <style>
        body {
            font-family: var(--prism-font-body, -apple-system, sans-serif);
            line-height: 1.6;
            margin: 0;
            padding: 0;
            color: var(--prism-text, #0f172a);
            background: var(--prism-surface-alt, #f8fafc);
        }

        .page {
            max-width: var(--prism-page-max, 1100px);
            margin: 0 auto;
            padding: 32px var(--prism-page-gutter, 24px) 60px;
        }

        .hero {
            background-color: var(--prism-primary, #4f46e5);
            background-image: var(--prism-hero-image, none), var(--prism-hero-bg, none);
            background-size: cover;
            background-position: center;
            color: var(--prism-hero-text, #ffffff);
            border-radius: var(--prism-radius, 16px);
            padding: var(--prism-hero-padding, 40px);
            box-shadow: var(--prism-card-shadow, 0 10px 30px rgba(15, 23, 42, 0.12));
        }

        .hero-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 6px 12px;
            border-radius: 999px;
            background: var(--prism-hero-badge, rgba(255, 255, 255, 0.2));
            font-size: var(--prism-text-size-sm, 12px);
            letter-spacing: var(--prism-letter-spacing-caps, 0.08em);
            text-transform: uppercase;
        }

        .hero h1 {
            margin: 16px 0 12px;
            font-family: var(--prism-font-display, var(--prism-font-body));
            font-size: var(--prism-text-size-xl, 40px);
            font-weight: var(--prism-heading-weight, 700);
        }

        .hero p {
            margin: 0 0 20px;
            max-width: 640px;
            color: rgba(255, 255, 255, 0.9);
            font-size: var(--prism-text-size-lg, 22px);
        }

        .hero-actions {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
        }

        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 10px 18px;
            border-radius: 10px;
            font-weight: 600;
            text-decoration: none;
            border: 1px solid transparent;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

        .btn-primary {
            background: var(--prism-button-bg, #4f46e5);
            color: var(--prism-button-text, #ffffff);
            box-shadow: 0 8px 16px rgba(79, 70, 229, 0.3);
        }

        .btn-primary:hover {
            background: var(--prism-button-hover, #4338ca);
            transform: translateY(-1px);
        }

        .btn-ghost {
            background: rgba(255, 255, 255, 0.15);
            color: #ffffff;
            border-color: rgba(255, 255, 255, 0.4);
        }

        .grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(var(--prism-grid-min, 240px), 1fr));
            gap: 20px;
            margin-top: var(--prism-section-gap, 28px);
        }

        .card {
            background: var(--prism-surface, #ffffff);
            border-radius: var(--prism-radius, 16px);
            padding: 20px;
            border: 1px solid var(--prism-border, #e2e8f0);
            box-shadow: var(--prism-card-shadow, 0 10px 30px rgba(15, 23, 42, 0.12));
        }

        .card h3 {
            margin-top: 0;
        }

        .chip {
            display: inline-flex;
            align-items: center;
            padding: 6px 10px;
            border-radius: 999px;
            background: var(--prism-chip-bg, rgba(79, 70, 229, 0.12));
            color: var(--prism-chip-text, #3730a3);
            font-size: var(--prism-text-size-sm, 12px);
            font-weight: 600;
        }

        .token-row {
            display: flex;
            align-items: center;
            gap: 12px;
            margin: 12px 0;
        }

        .token-swatch {
            width: 36px;
            height: 36px;
            border-radius: 12px;
            border: 1px solid var(--prism-border, #e2e8f0);
        }

        .token-label {
            font-size: var(--prism-text-size-sm, 13px);
            color: var(--prism-muted, #64748b);
        }

        .section-title {
            margin: 32px 0 8px;
            font-size: var(--prism-text-size-lg, 22px);
            font-weight: var(--prism-heading-weight, 700);
        }

        .section-subtitle {
            margin: 0 0 20px;
            color: var(--prism-muted, #64748b);
        }

        .type-stack {
            display: grid;
            gap: 10px;
        }

        .type-sample {
            font-family: var(--prism-font-display, var(--prism-font-body));
            font-size: 28px;
            font-weight: var(--prism-heading-weight, 700);
        }

        .type-body {
            font-size: var(--prism-text-size-md, 16px);
            font-weight: var(--prism-body-weight, 500);
        }

        .type-mono {
            font-family: var(--prism-font-mono, "Courier New", monospace);
            font-size: var(--prism-text-size-sm, 13px);
            color: var(--prism-muted, #64748b);
        }

        .imagery-card {
            min-height: 220px;
            border-radius: var(--prism-image-radius, 20px);
            background-image: var(--prism-card-image, linear-gradient(120deg, #4f46e5, #22d3ee));
            background-size: cover;
            background-position: center;
            border: 1px solid var(--prism-border, #e2e8f0);
            display: flex;
            align-items: flex-end;
            padding: 16px;
            color: #ffffff;
            font-weight: 600;
            text-shadow: 0 2px 10px rgba(15, 23, 42, 0.4);
        }

        .api-container {
            margin-top: 30px;
            border: 1px solid var(--prism-border, #e2e8f0);
            border-radius: 12px;
            overflow: hidden;
            background: var(--prism-surface, #ffffff);
            box-shadow: var(--prism-card-shadow, 0 10px 30px rgba(15, 23, 42, 0.12));
        }

        .api-header {
            background: var(--prism-surface-alt, #f8fafc);
            padding: 16px 20px;
            border-bottom: 1px solid var(--prism-border, #e2e8f0);
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 16px;
            flex-wrap: wrap;
        }

        .api-content {
            background: #0f172a;
            color: #e2e8f0;
            padding: 20px;
            margin: 0;
            font-family: var(--prism-font-mono, "SFMono-Regular", "Courier New", monospace);
            min-height: 100px;
            white-space: pre-wrap;
        }
    </style>
</head>

<body>

    <div class="page">
        <header class="hero">
            <span class="hero-badge">Prism Branding Demo</span>
            <h1>Welcome to the Prism Site</h1>
            <p>
                This page reads CSS variables from the Prism branding files. Update the tenant
                overrides and watch the theme, buttons, and tokens adapt instantly.
            </p>
            <div class="hero-actions">
                <a href="/umbraco" class="btn btn-primary">Open Back Office</a>
                <a href="#branding" class="btn btn-ghost">View Branding Tokens</a>
                <prism-mobile-user-agent-demo inline="true" compact="true" title="Simulate PrismMobile" />
            </div>
        </header>

        <h2 class="section-title">Design system tokens</h2>
        <p class="section-subtitle">
            Categories mirror real design systems: color, typography, layout, imagery, and components.
        </p>

        <section class="grid" id="branding">
            <div class="card">
                <div class="chip">Color</div>
                <h3>Primary palette</h3>
                <p>Swap values in the branding panel to change cards, buttons, and accents.</p>
                <div class="token-row">
                    <div class="token-swatch" style="background: var(--prism-primary);"></div>
                    <div>
                        <div class="token-label">Primary</div>
                        <strong>--prism-primary</strong>
                    </div>
                </div>
                <div class="token-row">
                    <div class="token-swatch" style="background: var(--prism-accent);"></div>
                    <div>
                        <div class="token-label">Accent</div>
                        <strong>--prism-accent</strong>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="chip">Layout</div>
                <h3>Surfaces and spacing</h3>
                <p>Layout tokens control density, elevation, and radius across the system.</p>
                <div class="token-row">
                    <div class="token-swatch" style="background: var(--prism-surface);"></div>
                    <div>
                        <div class="token-label">Surface</div>
                        <strong>--prism-surface</strong>
                    </div>
                </div>
                <div class="token-row">
                    <div class="token-swatch" style="background: var(--prism-surface-alt);"></div>
                    <div>
                        <div class="token-label">Surface alt</div>
                        <strong>--prism-surface-alt</strong>
                    </div>
                </div>
                <div class="token-row">
                    <div class="token-swatch" style="background: var(--prism-primary);"></div>
                    <div>
                        <div class="token-label">Radius</div>
                        <strong>--prism-radius</strong>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="chip">Typography</div>
                <h3>Type scale</h3>
                <p>Fonts and sizes are a first-class token group in most design systems.</p>
                <div class="type-stack">
                    <div class="type-sample">Prism Display</div>
                    <div class="type-body">Body copy uses the system font to keep pages fast.</div>
                    <div class="type-mono">--prism-font-mono for code and tokens</div>
                </div>
            </div>

            <div class="card">
                <div class="chip">Imagery</div>
                <h3>Media and art direction</h3>
                <p>Background imagery is tokenized so tenant overrides can swap assets.</p>
                <div class="imagery-card">Hero image token</div>
                <div class="token-label" style="margin-top: 12px;">
                    Add media pickers named <strong>heroImage</strong> and <strong>cardImage</strong> on the Home page.
                    Use Slimsy for responsive crops and lazy loading when rendering media URLs.
                </div>
            </div>
        </section>

        <prism-debug />

        <div class="api-container">
            <div class="api-header">
                <strong>Mock Back-Office Connection</strong>
                <a href="?callApi=true" class="btn btn-primary">Execute Server-to-Server Call</a>
            </div>
            <pre class="api-content">@apiResult</pre>
        </div>
    </div>

</body>

</html>