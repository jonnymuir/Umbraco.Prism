@using System.Security.Claims
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage

@{
    Layout = null;

    var heroImage = Model?.Value<IPublishedContent>("heroImage");
    var cardImage = Model?.Value<IPublishedContent>("cardImage");
    var heroImageUrl = heroImage?.Url();
    var cardImageUrl = cardImage?.Url();
    var isAuthenticated = Context.User.Identity?.IsAuthenticated == true;
    var displayName = Context.User.FindFirst("name")?.Value
                      ?? Context.User.FindFirst("preferred_username")?.Value
                      ?? "Member";
    var mobileAuthHref = isAuthenticated ? "/auth/logout" : "/auth/login";
    var mobileAuthLabel = isAuthenticated ? "Sign Out" : "Sign In";
    var hasImageryOverrides = !string.IsNullOrWhiteSpace(heroImageUrl) || !string.IsNullOrWhiteSpace(cardImageUrl);

    var imageryCss = new System.Text.StringBuilder();
    if (hasImageryOverrides)
    {
        imageryCss.Append(":root{");
        if (!string.IsNullOrWhiteSpace(heroImageUrl))
        {
            imageryCss.Append($"--prism-hero-image:url('{heroImageUrl}');");
        }
        if (!string.IsNullOrWhiteSpace(cardImageUrl))
        {
            imageryCss.Append($"--prism-card-image:url('{cardImageUrl}');");
        }
        imageryCss.Append('}');
    }
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>@(PrismContext.CurrentTenant?.Name ?? "Prism") — Welcome</title>

    <link rel="stylesheet" href="/branding/prism-colors.css" />
    <link rel="stylesheet" href="/branding/prism-typography.css" />
    <link rel="stylesheet" href="/branding/prism-layout.css" />
    <link rel="stylesheet" href="/branding/prism-imagery.css" />
    <link rel="stylesheet" href="/branding/prism-components.css" />
    @if (hasImageryOverrides)
    {
        <style>
            @Html.Raw(imageryCss.ToString())
        </style>
    }
    <style>
        body {
            font-family: var(--prism-font-body, -apple-system, sans-serif);
            line-height: 1.6;
            margin: 0;
            padding: 0;
            color: var(--prism-text, #0f172a);
            background: var(--prism-surface-alt, #f8fafc);
        }

        .portal-header {
            background: var(--prism-primary, #4f46e5);
            color: var(--prism-primary-contrast, #ffffff);
            padding: 0 var(--prism-page-gutter, 24px);
            display: flex;
            justify-content: space-between;
            align-items: center;
            height: 56px;
        }

        .portal-header__brand {
            font-weight: 700;
            font-size: 1.1rem;
        }

        .portal-header__nav {
            display: flex;
            gap: 16px;
            align-items: center;
        }

        .portal-header__link {
            color: rgba(255, 255, 255, 0.85);
            text-decoration: none;
            font-size: var(--prism-text-size-sm, 13px);
            font-weight: 600;
        }

        .portal-header__link:hover {
            color: #ffffff;
        }

        .page {
            max-width: var(--prism-page-max, 1100px);
            margin: 0 auto;
            padding: 0 var(--prism-page-gutter, 24px) 60px;
        }

        /* Hero */
        .hero {
            background-color: var(--prism-primary, #4f46e5);
            background-image: var(--prism-hero-image, none), var(--prism-hero-bg, none);
            background-size: cover;
            background-position: center;
            color: var(--prism-hero-text, #ffffff);
            border-radius: var(--prism-radius, 16px);
            padding: var(--prism-hero-padding, 40px);
            margin-top: 32px;
            box-shadow: var(--prism-card-shadow, 0 10px 30px rgba(15, 23, 42, 0.12));
        }

        .hero-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 6px 12px;
            border-radius: 999px;
            background: var(--prism-hero-badge, rgba(255, 255, 255, 0.2));
            font-size: var(--prism-text-size-sm, 12px);
            letter-spacing: var(--prism-letter-spacing-caps, 0.08em);
            text-transform: uppercase;
        }

        .hero h1 {
            margin: 16px 0 12px;
            font-family: var(--prism-font-display, var(--prism-font-body));
            font-size: var(--prism-text-size-xl, 40px);
            font-weight: var(--prism-heading-weight, 700);
        }

        .hero p {
            margin: 0 0 24px;
            max-width: 640px;
            color: rgba(255, 255, 255, 0.9);
            font-size: var(--prism-text-size-lg, 22px);
        }

        .hero-actions {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
        }

        /* Buttons */
        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 12px 24px;
            border-radius: 10px;
            font-weight: 600;
            text-decoration: none;
            border: 1px solid transparent;
            cursor: pointer;
            font-size: var(--prism-text-size-md, 16px);
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

        .btn-primary {
            background: var(--prism-button-bg, #4f46e5);
            color: var(--prism-button-text, #ffffff);
            box-shadow: 0 8px 16px rgba(79, 70, 229, 0.3);
        }

        .btn-primary:hover {
            background: var(--prism-button-hover, #4338ca);
            transform: translateY(-1px);
        }

        .btn-ghost {
            background: rgba(255, 255, 255, 0.15);
            color: #ffffff;
            border-color: rgba(255, 255, 255, 0.4);
        }

        .btn-ghost:hover {
            background: rgba(255, 255, 255, 0.25);
        }

        .btn-secondary {
            background: var(--prism-surface, #ffffff);
            color: var(--prism-primary, #4f46e5);
            border-color: var(--prism-border, #e2e8f0);
        }

        .btn-secondary:hover {
            background: var(--prism-surface-alt, #f8fafc);
            transform: translateY(-1px);
        }

        .btn-mobile-signin {
            display: none;
        }

        /* Feature cards */
        .features {
            margin-top: var(--prism-section-gap, 28px);
        }

        .features h2 {
            font-family: var(--prism-font-display, var(--prism-font-body));
            font-size: var(--prism-text-size-lg, 22px);
            font-weight: var(--prism-heading-weight, 700);
            margin: 0 0 8px;
        }

        .features > p {
            color: var(--prism-muted, #64748b);
            margin: 0 0 20px;
        }

        .grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(var(--prism-grid-min, 240px), 1fr));
            gap: 20px;
        }

        .card {
            background: var(--prism-surface, #ffffff);
            border-radius: var(--prism-radius, 16px);
            padding: 24px;
            border: 1px solid var(--prism-border, #e2e8f0);
            box-shadow: var(--prism-card-shadow, 0 10px 30px rgba(15, 23, 42, 0.12));
        }

        .card__icon {
            width: 48px;
            height: 48px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.4rem;
            margin-bottom: 16px;
        }

        .card__icon--security { background: rgba(79, 70, 229, 0.12); color: var(--prism-primary); }
        .card__icon--tenancy  { background: rgba(34, 197, 94, 0.12); color: var(--prism-accent); }
        .card__icon--mobile   { background: rgba(245, 158, 11, 0.12); color: var(--prism-warning); }

        .card h3 { margin: 0 0 8px; }
        .card p  { margin: 0; color: var(--prism-muted, #64748b); }

        /* Prism debug block */
        .prism-debug-section {
            margin-top: var(--prism-section-gap, 28px);
        }

        /* Footer */
        .portal-footer {
            text-align: center;
            padding: 32px var(--prism-page-gutter, 24px);
            color: var(--prism-muted, #64748b);
            font-size: var(--prism-text-size-sm, 13px);
        }

        /* Mobile overrides */
        .mobile-mode-banner {
            display: none;
            margin-top: 16px;
            padding: 10px 14px;
            border-radius: 12px;
            background: rgba(15, 23, 42, 0.45);
            border: 1px solid rgba(255, 255, 255, 0.25);
            color: #ffffff;
            font-size: var(--prism-text-size-sm, 13px);
            font-weight: 600;
        }

        html.prism-mobile body {
            background: #0f172a;
            color: #e2e8f0;
        }

        html.prism-mobile .portal-header {
            padding-top: env(safe-area-inset-top);
            height: calc(56px + env(safe-area-inset-top));
        }

        html.prism-mobile .page {
            max-width: 460px;
            padding: 16px 12px 88px;
        }

        html.prism-mobile .hero {
            border-radius: 22px;
            padding: 20px 16px;
            min-height: 280px;
            display: flex;
            flex-direction: column;
            justify-content: flex-end;
        }

        html.prism-mobile .hero h1 {
            font-size: clamp(1.7rem, 5.8vw, 2.1rem);
        }

        html.prism-mobile .hero p {
            font-size: 1rem;
        }

        html.prism-mobile .hero-actions {
            width: 100%;
            display: grid;
            grid-template-columns: minmax(0, 1fr);
            gap: 10px;
        }

        html.prism-mobile .hero-actions .btn {
            width: 100%;
            box-sizing: border-box;
        }

        html.prism-mobile .btn-mobile-signin {
            display: inline-flex;
        }

        html.prism-mobile .mobile-mode-banner {
            display: block;
        }

        html.prism-mobile .grid {
            grid-template-columns: 1fr;
            gap: 12px;
            margin-top: 16px;
        }

        html.prism-mobile .card {
            border-radius: 14px;
            padding: 16px;
            color: var(--prism-text, #0f172a);
            background: var(--prism-surface, #ffffff);
        }

        html.prism-mobile .card p {
            color: var(--prism-muted, #64748b);
        }

        html.prism-mobile .prism-debug-root {
            display: none;
        }
    </style>
</head>

<body>

    <header class="portal-header">
        <div class="portal-header__brand">@(PrismContext.CurrentTenant?.Name ?? "Prism Portal")</div>
        <nav class="portal-header__nav">
            @if (isAuthenticated)
            {
                <a href="/dashboard" class="portal-header__link">Dashboard</a>
                <a href="/auth/logout" class="portal-header__link">Sign Out</a>
            }
            else
            {
                <a href="/auth/login" class="portal-header__link">Sign In</a>
                <a href="/auth/register" class="portal-header__link">Register</a>
            }
        </nav>
    </header>

    <div class="page">

        @if (isAuthenticated)
        {
            <!-- Authenticated: brief welcome + dashboard link -->
            <header class="hero">
                <span class="hero-badge">✓ Signed in</span>
                <h1>Welcome back, @displayName</h1>
                <p>Your secure portal is ready. Head to your dashboard to manage your account.</p>
                <div class="mobile-mode-banner">Prism mobile mode active</div>
                <div class="hero-actions">
                    <a href="/dashboard" class="btn btn-primary">Go to Dashboard</a>
                    <a href="/auth/logout" class="btn btn-ghost">Sign Out</a>
                    <prism-mobile-user-agent-demo inline="true" compact="true" title="Simulate PrismMobile" />
                </div>
            </header>
        }
        else
        {
            <!-- Unauthenticated: welcoming hero with Sign In + Register CTAs -->
            <header class="hero">
                <span class="hero-badge">Secure Member Portal</span>
                <h1>Your account, your&nbsp;way</h1>
                <p>
                    Access your documents, manage your preferences, and stay in control — all
                    in one secure place.
                </p>
                <div class="mobile-mode-banner">Prism mobile mode active</div>
                <div class="hero-actions">
                    <a href="/auth/login" class="btn btn-primary">Sign In</a>
                    <a href="/auth/register" class="btn btn-ghost">Create Account</a>
                    <a href="@mobileAuthHref" class="btn btn-ghost btn-mobile-signin">@mobileAuthLabel</a>
                    <prism-mobile-user-agent-demo inline="true" compact="true" title="Simulate PrismMobile" />
                </div>
            </header>
        }

        <section class="features">
            <h2>Built for security and scale</h2>
            <p>Powered by Umbraco Prism — multi-tenant identity, branding, and mobile in one package.</p>

            <div class="grid">
                <div class="card">
                    <div class="card__icon card__icon--security">🔐</div>
                    <h3>Enterprise Authentication</h3>
                    <p>Sign in with your organisation's identity provider. Powered by Entra ID with PKCE, token refresh, and biometric login on mobile.</p>
                </div>
                <div class="card">
                    <div class="card__icon card__icon--tenancy">🏢</div>
                    <h3>Multi-Tenant Branding</h3>
                    <p>Every tenant gets its own colours, typography, imagery, and layout — resolved automatically from the request hostname.</p>
                </div>
                <div class="card">
                    <div class="card__icon card__icon--mobile">📱</div>
                    <h3>Native Mobile Experience</h3>
                    <p>The same portal works inside iOS and Android apps with safe-area handling, biometric auth, and app-native navigation.</p>
                </div>
            </div>
        </section>

        <div class="prism-debug-section">
            <prism-debug />
        </div>
    </div>

    <footer class="portal-footer">
        &copy; @DateTime.Now.Year @(PrismContext.CurrentTenant?.Name ?? "Prism") &mdash; Powered by Umbraco Prism
    </footer>

    @{
        var navSettings = Umbraco.ContentAtRoot().FirstOrDefault(x => x.ContentType.Alias == "settings");
        var mobileNavLinks = navSettings?.Value<IEnumerable<Link>>("mobileNavLinks");
    }
    @Html.Partial("_MobileShellNav", mobileNavLinks)

</body>
