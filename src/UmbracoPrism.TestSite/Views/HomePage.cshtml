@using System.Security.Claims
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage

@{
    Layout = "Master";

    var heroImage = Model?.Value<IPublishedContent>("heroImage");
    var cardImage = Model?.Value<IPublishedContent>("cardImage");
    var heroImageUrl = heroImage?.Url();
    var cardImageUrl = cardImage?.Url();
    var isAuthenticated = Context.User.Identity?.IsAuthenticated == true;
    var displayName = Context.User.FindFirst("name")?.Value
                      ?? Context.User.FindFirst("preferred_username")?.Value
                      ?? "Member";
    var hasImageryOverrides = !string.IsNullOrWhiteSpace(heroImageUrl) || !string.IsNullOrWhiteSpace(cardImageUrl);

    var imageryCss = new System.Text.StringBuilder();
    if (hasImageryOverrides)
    {
        imageryCss.Append(":root{");
        if (!string.IsNullOrWhiteSpace(heroImageUrl))
        {
            imageryCss.Append($"--prism-hero-image:url('{heroImageUrl}');");
        }
        if (!string.IsNullOrWhiteSpace(cardImageUrl))
        {
            imageryCss.Append($"--prism-card-image:url('{cardImageUrl}');");
        }
        imageryCss.Append('}');
    }
}

    @if (hasImageryOverrides)
    {
        <style>
            @Html.Raw(imageryCss.ToString())
        </style>
    }

<div class="page">

        @if (isAuthenticated)
        {
            <!-- Authenticated: brief welcome + dashboard link -->
            <header class="hero">
                <span class="hero-badge">✓ Signed in</span>
                <h1>Welcome back, @displayName</h1>
                <p>Your secure portal is ready. Head to your dashboard to manage your account.</p>
                <div class="hero-actions">
                    <a href="/dashboard" class="btn btn-primary">Go to Dashboard</a>
                    <a href="/auth/logout" class="btn btn-ghost">Sign Out</a>
                </div>
            </header>
        }
        else
        {
            <!-- Unauthenticated: welcoming hero with Sign In + Register CTAs -->
            <header class="hero">
                <span class="hero-badge">Secure Member Portal</span>
                <h1>Your account, your&nbsp;way</h1>
                <p>
                    Access your documents, manage your preferences, and stay in control — all
                    in one secure place.
                </p>
                <div class="hero-actions">
                    <a href="/auth/login" class="btn btn-primary">Sign In</a>
                    <a href="/auth/register" class="btn btn-ghost">Create Account</a>
                </div>
            </header>
        }

        <section class="features">
            <h2>Built for security and scale</h2>
            <p>Powered by Umbraco Prism — multi-tenant identity, branding, and mobile in one package.</p>

            <div class="grid">
                <div class="card">
                    <div class="card__icon card__icon--security">🔐</div>
                    <h3>Enterprise Authentication</h3>
                    <p>Sign in with your organisation's identity provider. Powered by Entra ID with PKCE, token refresh, and biometric login on mobile.</p>
                </div>
                <div class="card">
                    <div class="card__icon card__icon--tenancy">🏢</div>
                    <h3>Multi-Tenant Branding</h3>
                    <p>Every tenant gets its own colours, typography, imagery, and layout — resolved automatically from the request hostname.</p>
                </div>
                <div class="card">
                    <div class="card__icon card__icon--mobile">📱</div>
                    <h3>Native Mobile Experience</h3>
                    <p>The same portal works inside iOS and Android apps with safe-area handling, biometric auth, and app-native navigation.</p>
                </div>
            </div>
        </section>

        <section class="ds-section" id="design-tokens">
            <div class="ds-section__header">
                <h2>Design system tokens</h2>
                <p>Every visual property on this page is driven by a CSS custom property. Change tenant branding in the back office and watch this page update in real&nbsp;time.</p>
                <p class="ds-section__link"><a href="/umbraco" class="btn btn-secondary">→ Open Back Office</a></p>
            </div>

            <div class="ds-grid">
                <div class="card ds-card ds-card--wide">
                    <h3>Colour</h3>
                    <p class="ds-card__subtitle">Full palette of brand colours</p>
                    <div class="token-palette">
                        <div class="token-swatch">
                            <div class="token-swatch__color" style="background: var(--prism-primary);"></div>
                            <div class="token-swatch__label">
                                <span class="token-chip">--prism-primary</span>
                            </div>
                        </div>
                        <div class="token-swatch">
                            <div class="token-swatch__color" style="background: var(--prism-accent);"></div>
                            <div class="token-swatch__label">
                                <span class="token-chip">--prism-accent</span>
                            </div>
                        </div>
                        <div class="token-swatch">
                            <div class="token-swatch__color" style="background: var(--prism-surface);"></div>
                            <div class="token-swatch__label">
                                <span class="token-chip">--prism-surface</span>
                            </div>
                        </div>
                        <div class="token-swatch">
                            <div class="token-swatch__color" style="background: var(--prism-surface-alt);"></div>
                            <div class="token-swatch__label">
                                <span class="token-chip">--prism-surface-alt</span>
                            </div>
                        </div>
                        <div class="token-swatch">
                            <div class="token-swatch__color" style="background: var(--prism-text);"></div>
                            <div class="token-swatch__label">
                                <span class="token-chip">--prism-text</span>
                            </div>
                        </div>
                        <div class="token-swatch">
                            <div class="token-swatch__color" style="background: var(--prism-muted);"></div>
                            <div class="token-swatch__label">
                                <span class="token-chip">--prism-muted</span>
                            </div>
                        </div>
                        <div class="token-swatch">
                            <div class="token-swatch__color" style="background: var(--prism-border);"></div>
                            <div class="token-swatch__label">
                                <span class="token-chip">--prism-border</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card ds-card">
                    <h3>Typography</h3>
                    <p class="ds-card__subtitle">Type scale and font families</p>
                    <div class="type-scale">
                        <div class="type-scale__sample">
                            <div class="type-scale__text" style="font-family: var(--prism-font-display); font-size: var(--prism-text-size-xl); font-weight: var(--prism-heading-weight);">Display Heading</div>
                            <span class="token-chip">--prism-font-display / --prism-text-size-xl</span>
                        </div>
                        <div class="type-scale__sample">
                            <div class="type-scale__text" style="font-family: var(--prism-font-body); font-size: var(--prism-text-size-md); font-weight: var(--prism-body-weight);">Body copy using the primary font family</div>
                            <span class="token-chip">--prism-font-body / --prism-text-size-md</span>
                        </div>
                        <div class="type-scale__sample">
                            <div class="type-scale__text" style="font-size: var(--prism-text-size-sm); letter-spacing: var(--prism-letter-spacing-caps); text-transform: uppercase;">Small Label</div>
                            <span class="token-chip">--prism-text-size-sm</span>
                        </div>
                        <div class="type-scale__sample">
                            <div class="type-scale__text" style="font-family: var(--prism-font-mono); font-size: var(--prism-text-size-sm);">const token = "monospace";</div>
                            <span class="token-chip">--prism-font-mono</span>
                        </div>
                    </div>
                </div>

                <div class="card ds-card">
                    <h3>Layout</h3>
                    <p class="ds-card__subtitle">Spacing and elevation tokens</p>
                    <div class="layout-tokens">
                        <div class="layout-tokens__row">
                            <span class="layout-tokens__label">Border radius</span>
                            <div class="radius-demo-group">
                                <div class="radius-demo radius-demo--full"></div>
                                <div class="radius-demo radius-demo--half"></div>
                                <div class="radius-demo radius-demo--none"></div>
                            </div>
                        </div>
                        <div class="layout-tokens__row">
                            <span class="layout-tokens__label">Card shadow</span>
                            <div class="shadow-demo"></div>
                        </div>
                        <div class="layout-tokens__row">
                            <span class="layout-tokens__label">Page gutter</span>
                            <div class="gutter-demo">
                                <span class="token-chip">--prism-page-gutter</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card ds-card">
                    <h3>Imagery</h3>
                    <p class="ds-card__subtitle">Tenant-specific images and backgrounds</p>
                    <div class="imagery-preview">
                        <div class="imagery-preview__sample"></div>
                        <span class="token-chip">--prism-card-image</span>
                        <p class="imagery-preview__note">Set via media picker in the Umbraco back office</p>
                    </div>
                </div>

                <div class="card ds-card ds-card--wide">
                    <h3>Components</h3>
                    <p class="ds-card__subtitle">Live UI components driven by tokens</p>
                    <div class="component-showcase">
                        <div class="component-showcase__item">
                            <button class="btn btn-primary">Primary Button</button>
                            <span class="token-chip">--prism-button-bg / --prism-button-text</span>
                        </div>
                        <div class="component-showcase__item">
                            <span class="showcase-chip">Chip / Badge</span>
                            <span class="token-chip">--prism-chip-bg / --prism-chip-text</span>
                        </div>
                        <div class="component-showcase__item component-showcase__item--card">
                            <div class="mini-card">
                                <div class="mini-card__icon">✨</div>
                                <div class="mini-card__content">
                                    <strong>Card Component</strong>
                                    <p>Uses surface, border, and shadow tokens</p>
                                </div>
                            </div>
                            <span class="token-chip">--prism-surface / --prism-border / --prism-card-shadow</span>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="design-system-section" id="design-system">
            <div class="design-system-header">
                <h2>Live Design System</h2>
                <p>Every value on this page reads from your tenant's CSS variables. Change a colour, font, or layout token in the Umbraco back office and watch it update here instantly.</p>
            </div>

            <!-- Colour Palette -->
            <div class="ds-subsection">
                <h3 class="ds-subsection-title">Colour</h3>
                
                <div class="ds-color-group">
                    <h4 class="ds-color-group-label">Brand</h4>
                    <div class="ds-color-grid">
                        <div class="ds-color-swatch">
                            <div class="ds-swatch" style="background: var(--prism-primary);"></div>
                            <div class="ds-swatch-label">Primary</div>
                            <code class="ds-var-name">--prism-primary</code>
                        </div>
                        <div class="ds-color-swatch">
                            <div class="ds-swatch" style="background: var(--prism-accent);"></div>
                            <div class="ds-swatch-label">Accent</div>
                            <code class="ds-var-name">--prism-accent</code>
                        </div>
                        <div class="ds-color-swatch">
                            <div class="ds-swatch" style="background: var(--prism-button-bg);"></div>
                            <div class="ds-swatch-label">Button</div>
                            <code class="ds-var-name">--prism-button-bg</code>
                        </div>
                        <div class="ds-color-swatch">
                            <div class="ds-swatch" style="background: var(--prism-button-hover);"></div>
                            <div class="ds-swatch-label">Button Hover</div>
                            <code class="ds-var-name">--prism-button-hover</code>
                        </div>
                        <div class="ds-color-swatch">
                            <div class="ds-swatch" style="background: var(--prism-focus);"></div>
                            <div class="ds-swatch-label">Focus</div>
                            <code class="ds-var-name">--prism-focus</code>
                        </div>
                    </div>
                </div>

                <div class="ds-color-group">
                    <h4 class="ds-color-group-label">Surfaces</h4>
                    <div class="ds-color-grid">
                        <div class="ds-color-swatch">
                            <div class="ds-swatch" style="background: var(--prism-surface); border: 1px solid var(--prism-border);"></div>
                            <div class="ds-swatch-label">Surface</div>
                            <code class="ds-var-name">--prism-surface</code>
                        </div>
                        <div class="ds-color-swatch">
                            <div class="ds-swatch" style="background: var(--prism-surface-alt); border: 1px solid var(--prism-border);"></div>
                            <div class="ds-swatch-label">Surface Alt</div>
                            <code class="ds-var-name">--prism-surface-alt</code>
                        </div>
                        <div class="ds-color-swatch">
                            <div class="ds-swatch" style="background: var(--prism-border);"></div>
                            <div class="ds-swatch-label">Border</div>
                            <code class="ds-var-name">--prism-border</code>
                        </div>
                        <div class="ds-color-swatch">
                            <div class="ds-swatch" style="background: var(--prism-chip-bg);"></div>
                            <div class="ds-swatch-label">Chip</div>
                            <code class="ds-var-name">--prism-chip-bg</code>
                        </div>
                    </div>
                </div>

                <div class="ds-color-group">
                    <h4 class="ds-color-group-label">Semantic</h4>
                    <div class="ds-color-grid">
                        <div class="ds-color-swatch">
                            <div class="ds-swatch" style="background: var(--prism-success);"></div>
                            <div class="ds-swatch-label">Success</div>
                            <code class="ds-var-name">--prism-success</code>
                        </div>
                        <div class="ds-color-swatch">
                            <div class="ds-swatch" style="background: var(--prism-warning);"></div>
                            <div class="ds-swatch-label">Warning</div>
                            <code class="ds-var-name">--prism-warning</code>
                        </div>
                        <div class="ds-color-swatch">
                            <div class="ds-swatch" style="background: var(--prism-danger);"></div>
                            <div class="ds-swatch-label">Danger</div>
                            <code class="ds-var-name">--prism-danger</code>
                        </div>
                    </div>
                </div>

                <div class="ds-color-group">
                    <h4 class="ds-color-group-label">Text</h4>
                    <div class="ds-color-grid">
                        <div class="ds-color-swatch">
                            <div class="ds-swatch" style="background: var(--prism-text);"></div>
                            <div class="ds-swatch-label">Text</div>
                            <code class="ds-var-name">--prism-text</code>
                        </div>
                        <div class="ds-color-swatch">
                            <div class="ds-swatch" style="background: var(--prism-muted);"></div>
                            <div class="ds-swatch-label">Muted</div>
                            <code class="ds-var-name">--prism-muted</code>
                        </div>
                        <div class="ds-color-swatch">
                            <div class="ds-swatch" style="background: var(--prism-link);"></div>
                            <div class="ds-swatch-label">Link</div>
                            <code class="ds-var-name">--prism-link</code>
                        </div>
                        <div class="ds-color-swatch">
                            <div class="ds-swatch" style="background: var(--prism-button-text);"></div>
                            <div class="ds-swatch-label">Button Text</div>
                            <code class="ds-var-name">--prism-button-text</code>
                        </div>
                    </div>
                </div>

                <div class="ds-color-group">
                    <h4 class="ds-color-group-label">Data Visualisation</h4>
                    <div class="ds-color-grid">
                        <div class="ds-color-swatch">
                            <div class="ds-swatch" style="background: var(--prism-graph-1);"></div>
                            <div class="ds-swatch-label">Graph 1</div>
                            <code class="ds-var-name">--prism-graph-1</code>
                        </div>
                        <div class="ds-color-swatch">
                            <div class="ds-swatch" style="background: var(--prism-graph-2);"></div>
                            <div class="ds-swatch-label">Graph 2</div>
                            <code class="ds-var-name">--prism-graph-2</code>
                        </div>
                        <div class="ds-color-swatch">
                            <div class="ds-swatch" style="background: var(--prism-graph-3);"></div>
                            <div class="ds-swatch-label">Graph 3</div>
                            <code class="ds-var-name">--prism-graph-3</code>
                        </div>
                    </div>
                </div>

                <div class="ds-color-group">
                    <h4 class="ds-color-group-label">Hero</h4>
                    <div class="ds-color-grid">
                        <div class="ds-color-swatch">
                            <div class="ds-swatch" style="background: var(--prism-hero-bg);"></div>
                            <div class="ds-swatch-label">Hero BG</div>
                            <code class="ds-var-name">--prism-hero-bg</code>
                        </div>
                        <div class="ds-color-swatch">
                            <div class="ds-swatch" style="background: var(--prism-hero-text);"></div>
                            <div class="ds-swatch-label">Hero Text</div>
                            <code class="ds-var-name">--prism-hero-text</code>
                        </div>
                        <div class="ds-color-swatch">
                            <div class="ds-swatch" style="background: var(--prism-hero-badge);"></div>
                            <div class="ds-swatch-label">Hero Badge</div>
                            <code class="ds-var-name">--prism-hero-badge</code>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Typography -->
            <div class="ds-subsection">
                <h3 class="ds-subsection-title">Typography</h3>
                
                <div class="ds-type-demo">
                    <h4 class="ds-type-group-label">Font Families</h4>
                    <div class="ds-type-sample" style="font-family: var(--prism-font-display);">
                        <div class="ds-type-label">Display Font</div>
                        <div class="ds-type-specimen">The quick brown fox jumps over the lazy dog</div>
                        <code class="ds-var-name">--prism-font-display</code>
                    </div>
                    <div class="ds-type-sample" style="font-family: var(--prism-font-body);">
                        <div class="ds-type-label">Body Font</div>
                        <div class="ds-type-specimen">The quick brown fox jumps over the lazy dog</div>
                        <code class="ds-var-name">--prism-font-body</code>
                    </div>
                    <div class="ds-type-sample" style="font-family: var(--prism-font-mono);">
                        <div class="ds-type-label">Mono Font</div>
                        <div class="ds-type-specimen">--prism-primary: #4f46e5;</div>
                        <code class="ds-var-name">--prism-font-mono</code>
                    </div>
                </div>

                <div class="ds-type-demo">
                    <h4 class="ds-type-group-label">Type Scale</h4>
                    <div class="ds-type-sample">
                        <div class="ds-type-label">Small</div>
                        <div class="ds-type-specimen" style="font-size: var(--prism-text-size-sm);">The five boxing wizards jump quickly.</div>
                        <code class="ds-var-name">--prism-text-size-sm</code>
                    </div>
                    <div class="ds-type-sample">
                        <div class="ds-type-label">Medium</div>
                        <div class="ds-type-specimen" style="font-size: var(--prism-text-size-md);">The five boxing wizards jump quickly.</div>
                        <code class="ds-var-name">--prism-text-size-md</code>
                    </div>
                    <div class="ds-type-sample">
                        <div class="ds-type-label">Large</div>
                        <div class="ds-type-specimen" style="font-size: var(--prism-text-size-lg);">The five boxing wizards jump quickly.</div>
                        <code class="ds-var-name">--prism-text-size-lg</code>
                    </div>
                    <div class="ds-type-sample">
                        <div class="ds-type-label">Extra Large</div>
                        <div class="ds-type-specimen" style="font-size: var(--prism-text-size-xl); font-family: var(--prism-font-display); font-weight: var(--prism-heading-weight);">The five boxing wizards jump quickly.</div>
                        <code class="ds-var-name">--prism-text-size-xl</code>
                    </div>
                </div>

                <div class="ds-type-demo">
                    <h4 class="ds-type-group-label">Font Weights</h4>
                    <div class="ds-type-sample">
                        <div class="ds-type-label">Body Weight</div>
                        <div class="ds-type-specimen" style="font-weight: var(--prism-body-weight);">The quick brown fox jumps over the lazy dog</div>
                        <code class="ds-var-name">--prism-body-weight</code>
                    </div>
                    <div class="ds-type-sample">
                        <div class="ds-type-label">Heading Weight</div>
                        <div class="ds-type-specimen" style="font-weight: var(--prism-heading-weight);">The quick brown fox jumps over the lazy dog</div>
                        <code class="ds-var-name">--prism-heading-weight</code>
                    </div>
                </div>
            </div>

            <!-- Layout -->
            <div class="ds-subsection">
                <h3 class="ds-subsection-title">Layout</h3>
                
                <div class="ds-layout-demos">
                    <div class="ds-layout-item">
                        <div class="ds-layout-label">Border Radius</div>
                        <div class="ds-radius-demo" style="border-radius: var(--prism-radius); background: var(--prism-primary);"></div>
                        <code class="ds-var-name">--prism-radius</code>
                    </div>
                    
                    <div class="ds-layout-item">
                        <div class="ds-layout-label">Card Shadow</div>
                        <div class="ds-shadow-demo" style="box-shadow: var(--prism-card-shadow); background: var(--prism-surface);"></div>
                        <code class="ds-var-name">--prism-card-shadow</code>
                    </div>

                    <div class="ds-layout-item">
                        <div class="ds-layout-label">Section Gap</div>
                        <div class="ds-gap-demo">
                            <div style="background: var(--prism-accent); height: 20px; border-radius: 4px;"></div>
                            <div style="margin-top: var(--prism-section-gap); background: var(--prism-accent); height: 20px; border-radius: 4px;"></div>
                        </div>
                        <code class="ds-var-name">--prism-section-gap</code>
                    </div>
                </div>

                <div class="ds-layout-item ds-layout-item--full">
                    <div class="ds-layout-label">Grid System</div>
                    <div class="ds-grid-demo">
                        <div style="background: var(--prism-graph-1); padding: 12px; border-radius: 8px; color: white; text-align: center;">Column</div>
                        <div style="background: var(--prism-graph-2); padding: 12px; border-radius: 8px; color: white; text-align: center;">Column</div>
                        <div style="background: var(--prism-graph-3); padding: 12px; border-radius: 8px; color: white; text-align: center;">Column</div>
                    </div>
                    <code class="ds-var-name">grid-template-columns: repeat(auto-fit, minmax(var(--prism-grid-min), 1fr))</code>
                </div>

                <div class="ds-layout-item ds-layout-item--full">
                    <div class="ds-layout-label">Spacing Tokens</div>
                    <div class="ds-spacing-list">
                        <div class="ds-spacing-row">
                            <code class="ds-var-name">--prism-page-max</code>
                            <span class="ds-spacing-value" style="font-family: var(--prism-font-mono); color: var(--prism-muted);">Max content width</span>
                        </div>
                        <div class="ds-spacing-row">
                            <code class="ds-var-name">--prism-page-gutter</code>
                            <span class="ds-spacing-value" style="font-family: var(--prism-font-mono); color: var(--prism-muted);">Horizontal page padding</span>
                        </div>
                        <div class="ds-spacing-row">
                            <code class="ds-var-name">--prism-nav-height</code>
                            <span class="ds-spacing-value" style="font-family: var(--prism-font-mono); color: var(--prism-muted);">Header nav height</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Imagery -->
            <div class="ds-subsection">
                <h3 class="ds-subsection-title">Imagery</h3>
                <p class="ds-subsection-note">Set hero image and card image via the branding editor in the Umbraco back office. These variables allow full control over background imagery and blend modes.</p>
                
                <div class="ds-imagery-demos">
                    <div class="ds-imagery-item">
                        <div class="ds-imagery-label">Hero Image</div>
                        <div class="ds-hero-image-demo" style="background-image: var(--prism-hero-image); background-size: cover; background-position: center;">
                            @if (string.IsNullOrWhiteSpace(heroImageUrl))
                            {
                                <div class="ds-image-placeholder">No image set</div>
                            }
                        </div>
                        <code class="ds-var-name">--prism-hero-image</code>
                    </div>

                    <div class="ds-imagery-item">
                        <div class="ds-imagery-label">Card Image</div>
                        <div class="ds-card-image-demo" style="background-image: var(--prism-card-image); background-size: cover; background-position: center;">
                            @if (string.IsNullOrWhiteSpace(cardImageUrl))
                            {
                                <div class="ds-image-placeholder">No image set</div>
                            }
                        </div>
                        <code class="ds-var-name">--prism-card-image</code>
                    </div>

                    <div class="ds-imagery-item">
                        <div class="ds-imagery-label">Image Radius</div>
                        <div class="ds-image-radius-demo" style="border-radius: var(--prism-image-radius); background: linear-gradient(135deg, var(--prism-primary), var(--prism-accent));">
                        </div>
                        <code class="ds-var-name">--prism-image-radius</code>
                    </div>
                </div>

                <div class="ds-imagery-item ds-imagery-item--full">
                    <div class="ds-imagery-label">Blend Mode</div>
                    <div class="ds-blend-demo" style="background-image: var(--prism-hero-image); background-blend-mode: var(--prism-hero-image-blend); background-color: var(--prism-primary);">
                        @if (string.IsNullOrWhiteSpace(heroImageUrl))
                        {
                            <div class="ds-image-placeholder">Set hero image to see blend mode in action</div>
                        }
                        else
                        {
                            <div style="color: white; font-weight: 600;">Hero image with blend mode applied</div>
                        }
                    </div>
                    <code class="ds-var-name">background-blend-mode: var(--prism-hero-image-blend)</code>
                </div>
            </div>
        </section>

        @* 
            Phase 1 Security: Debug panel is environment-gated via PrismDebugTagHelper.
            Only renders in Development or when Prism:EnableDebugPanel=true.
            Safe to include in views; the tag helper suppresses output in production.
        *@
        <div class="prism-debug-section">
            <prism-debug />
        </div>
    </div>

