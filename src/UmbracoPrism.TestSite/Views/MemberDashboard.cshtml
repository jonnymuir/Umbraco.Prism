@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<Umbraco.Cms.Web.Common.PublishedModels.MemberDashboard>
@{
    Layout = "Master";

    var tenant = PrismContext.CurrentTenant;
    var displayName = ViewBag.DisplayName as string ?? "Member";
    var email = ViewBag.Email as string ?? "";
    var userOid = ViewBag.UserOid as string ?? "";
}

<main class="dash-page">
        <div class="dash-welcome">
            <h1>Welcome back, @displayName</h1>
            <p>Manage your account, documents, and security settings.</p>
        </div>

        <!-- Account overview cards -->
        <div class="dash-grid">
            <div class="dash-card">
                <div class="dash-card__icon dash-card__icon--account">👤</div>
                <h3>My Account</h3>
                <p>View and update your personal information, contact details, and communication preferences.</p>
            </div>
            <div class="dash-card">
                <div class="dash-card__icon dash-card__icon--documents">📄</div>
                <h3>Documents</h3>
                <p>Access your statements, correspondence, and important documents in one secure location.</p>
            </div>
            <div class="dash-card">
                <div class="dash-card__icon dash-card__icon--support">💬</div>
                <h3>Support</h3>
                <p>Get help with your account. Contact our team or browse frequently asked questions.</p>
            </div>
        </div>

        <!-- Biometric authentication section -->
        <div class="dash-section">
            <h2>Biometric Authentication</h2>
            <p>Use Face ID or fingerprint to sign in securely from the mobile app — no password needed.</p>

            <div class="dash-bio-card">
                <div class="dash-bio-status">
                    <div class="dash-bio-status__dot dash-bio-status__dot--inactive"></div>
                    <strong>Not configured</strong>
                    <span style="color: var(--prism-muted); font-size: var(--prism-text-size-sm, 13px);">Set up via mobile app</span>
                </div>

                <div class="dash-bio-steps">
                    <div class="dash-bio-step">
                        <div class="dash-bio-step__num">1</div>
                        <div>
                            <h4>Open the mobile app</h4>
                            <p>Download and install the Prism mobile app for iOS or Android.</p>
                        </div>
                    </div>
                    <div class="dash-bio-step">
                        <div class="dash-bio-step__num">2</div>
                        <div>
                            <h4>Sign in with your account</h4>
                            <p>Log in using your existing credentials to link your device.</p>
                        </div>
                    </div>
                    <div class="dash-bio-step">
                        <div class="dash-bio-step__num">3</div>
                        <div>
                            <h4>Enable biometric login</h4>
                            <p>Follow the prompt to register Face ID or fingerprint. Future sign-ins will be instant.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Profile details -->
        <div class="dash-section">
            <h2>Profile</h2>
            <p>Your account details from your identity provider.</p>

            <div class="dash-profile">
                <div class="dash-profile__row">
                    <span class="dash-profile__label">Name</span>
                    <span class="dash-profile__value">@displayName</span>
                </div>
                @if (!string.IsNullOrEmpty(email))
                {
                    <div class="dash-profile__row">
                        <span class="dash-profile__label">Email</span>
                        <span class="dash-profile__value">@email</span>
                    </div>
                }
                <div class="dash-profile__row">
                    <span class="dash-profile__label">Tenant</span>
                    <span class="dash-profile__value">@(tenant?.Name ?? "—")</span>
                </div>
            </div>
        </div>

        <!-- Downstream API demo -->
        <div class="dash-section">
            <h2>Downstream API</h2>
            <p>Demonstrates how Prism propagates your identity to business applications via a Bearer token.</p>

            <div class="dash-api-card">
                <div id="api-idle">
                    <p style="margin:0 0 16px; color: var(--prism-muted, #64748b);">
                        Click the button below to call the MockBackOffice API using your current Prism Bearer token.
                        The API will validate the token, resolve your tenant, and return your registered role.
                    </p>
                    <button onclick="callDownstreamApi()" class="btn btn-primary" id="api-btn"
                            style="font-size: var(--prism-text-size-sm, 13px); padding: 8px 16px;">
                        Call MockBackOffice API
                    </button>
                    <div class="api-hint" style="margin-top: 16px;">
                        💡 Make sure MockBackOffice is running first:<br />
                        <code>dotnet run --project src/UmbracoPrism.MockBackOffice</code>
                    </div>
                </div>

                <div id="api-loading" style="display:none; padding: 16px 0; color: var(--prism-muted, #64748b); font-size: var(--prism-text-size-sm, 13px);">
                    ⏳ Calling MockBackOffice…
                </div>

                <div id="api-result" style="display:none;">
                    <div id="api-status-bar" style="display:flex; align-items:center; gap:12px; margin-bottom:12px; flex-wrap:wrap;">
                        <span id="api-status-badge" style="display:inline-flex; align-items:center; gap:6px; padding:4px 12px; border-radius:20px; font-size:var(--prism-text-size-sm,13px); font-weight:700; font-family:monospace;"></span>
                        <span id="api-url-label" style="font-size:var(--prism-text-size-sm,13px); color:var(--prism-muted,#64748b); font-family:monospace; word-break:break-all;"></span>
                        <span id="api-timing" style="font-size:var(--prism-text-size-sm,13px); color:var(--prism-muted,#64748b); margin-left:auto;"></span>
                    </div>
                    <div style="background:var(--prism-surface-alt,#f8fafc); border:1px solid var(--prism-border,#e2e8f0); border-radius:10px; overflow:hidden;">
                        <div style="display:flex; justify-content:space-between; align-items:center; padding:8px 14px; background:var(--prism-surface,#fff); border-bottom:1px solid var(--prism-border,#e2e8f0);">
                            <span id="api-content-type" style="font-size:var(--prism-text-size-sm,13px); color:var(--prism-muted,#64748b); font-family:monospace;"></span>
                            <button onclick="resetApiDemo()" style="background:none; border:none; color:var(--prism-muted,#64748b); cursor:pointer; font-size:var(--prism-text-size-sm,13px); padding:2px 6px;">✕ Reset</button>
                        </div>
                        <pre id="api-body" style="margin:0; padding:16px; font-size:var(--prism-text-size-sm,13px); overflow-x:auto; white-space:pre-wrap; word-break:break-word; color:var(--prism-text,#0f172a);"></pre>
                    </div>
                </div>
            </div>
        </div>

        <script>
            async function callDownstreamApi() {
                document.getElementById('api-idle').style.display = 'none';
                document.getElementById('api-result').style.display = 'none';
                document.getElementById('api-loading').style.display = 'block';

                try {
                    const res = await fetch('/api/prism/downstream-demo', { credentials: 'include' });
                    const data = await res.json();

                    document.getElementById('api-loading').style.display = 'none';
                    document.getElementById('api-result').style.display = 'block';

                    const ok = data.statusCode >= 200 && data.statusCode < 300;
                    const badge = document.getElementById('api-status-badge');
                    badge.textContent = `${data.statusCode} ${data.statusText}`;
                    badge.style.background = ok ? 'rgba(22,163,74,0.12)' : 'rgba(239,68,68,0.12)';
                    badge.style.color = ok ? 'var(--prism-success,#16a34a)' : 'var(--prism-danger,#ef4444)';

                    document.getElementById('api-url-label').textContent = data.url;
                    document.getElementById('api-timing').textContent = `${data.elapsedMs}ms`;
                    document.getElementById('api-content-type').textContent = data.contentType;
                    document.getElementById('api-body').textContent = data.body;
                } catch (err) {
                    document.getElementById('api-loading').style.display = 'none';
                    document.getElementById('api-result').style.display = 'block';
                    const badge = document.getElementById('api-status-badge');
                    badge.textContent = '0 Client Error';
                    badge.style.background = 'rgba(239,68,68,0.12)';
                    badge.style.color = 'var(--prism-danger,#ef4444)';
                    document.getElementById('api-url-label').textContent = '/api/prism/downstream-demo';
                    document.getElementById('api-body').textContent = err.toString();
                }
            }

            function resetApiDemo() {
                document.getElementById('api-result').style.display = 'none';
                document.getElementById('api-idle').style.display = 'block';
            }
        </script>

        <div style="margin-top: 24px;">
            <a href="/auth/logout" class="btn btn-outline">Sign Out</a>
        </div>
    </main>

