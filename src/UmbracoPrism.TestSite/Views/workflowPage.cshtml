@using UmbracoPrism.TestSite.Models
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<WorkflowViewModel>
@inject Microsoft.AspNetCore.Mvc.ViewEngines.ICompositeViewEngine _viewEngine
@{
    Layout = "~/Views/Shared/Master.cshtml";
    ViewBag.Title = Model.HasError ? "Workflow Error" : Model.StateDisplayName;
}

<div class="workflow-page">
    @if (Model.HasError)
    {
        <div class="workflow-page__header">
            <h1 class="workflow-page__title">Workflow Error</h1>
        </div>
        <div class="workflow-alert workflow-alert--error">
            <p>@Model.ErrorMessage</p>
        </div>
    }
    @* Instance picker — shown when instancePolicy = "prompt" and an active instance exists.
       The picker partial uses h2, so we provide the page h1 here. *@
    else if (Model.ShowInstancePicker)
    {
        <div class="workflow-page__header">
            <h1 class="workflow-page__title">@Model.StateDisplayName</h1>
        </div>
        @await Html.PartialAsync("~/Views/Partials/_WorkflowHub-InstancePicker.cshtml", Model)
    }
    else
    {
        @* Step type names follow the workflow definition JSON ("question", "check-answers",
           "confirmation", "status-timeline"). Legacy aliases kept for backward compatibility.
           H1 ownership:
             - question: outer template renders the state displayName as h1; partial has no h1.
             - check-answers: partial owns its h1 (govuk-heading-l with state displayName).
             - confirmation: partial owns its h1 (govuk-panel__title with state displayName).
             - unknown: partial assumed to own its h1; outer template provides one only if no partial. *@
        var partialName = Model.StepType.ToLowerInvariant() switch
        {
            "question" or "collect" => "_WorkflowStep-Question",
            "check-answers" or "review" => "_WorkflowStep-Review",
            "confirmation" or "completion" => "_WorkflowStep-Completion",
            "status-timeline" or "statustimeline" => "_WorkflowStep-StatusTimeline",
            "waiting" => "_WorkflowStep-Waiting",
            _ => $"_WorkflowStep-{Model.StepType}"
        };
        var partialPath = $"~/Views/Partials/{partialName}.cshtml";
        var viewResult = _viewEngine.GetView(null, partialPath, false);
        if (viewResult.Success)
        {
            if (partialName == "_WorkflowStep-Question")
            {
                <div class="workflow-page__header">
                    <h1 class="workflow-page__title">@Model.StateDisplayName</h1>
                </div>
            }
            @await Html.PartialAsync(partialName, Model)
        }
        else
        {
            <div class="workflow-page__header">
                <h1 class="workflow-page__title">@Model.StateDisplayName</h1>
            </div>
            <div class="workflow-alert workflow-alert--warn">
                <p>No template found for step type: <code>@Model.StepType</code></p>
            </div>
        }
    }
</div>