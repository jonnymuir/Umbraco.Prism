@using UmbracoPrism.Core.Models.Workflow
@using UmbracoPrism.TestSite.Models
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<WorkflowViewModel>
@inject Microsoft.AspNetCore.Mvc.ViewEngines.ICompositeViewEngine ViewEngine
@{
    Layout = "~/Views/Shared/Master.cshtml";
    ViewBag.Title = Model.HasError ? "Workflow Error" : Model.StateDisplayName;
}

<div class="workflow-page">
    @if (Model.HasError)
    {
        <div class="workflow-page__header">
            <h1 class="workflow-page__title">Workflow Error</h1>
        </div>
        <div class="workflow-alert workflow-alert--error">
            <p>@Model.ErrorMessage</p>
        </div>
    }
    else if (Model.ShowInstancePicker)
    {
        <div class="workflow-page__header">
            <h1 class="workflow-page__title">@Model.StateDisplayName</h1>
        </div>
        @await Html.PartialAsync("_WorkflowHub-InstancePicker", Model)
    }
    else
    {
        var shell = WorkflowRenderShellResolver.ResolveShell(
            Model.Components,
            Model.StepType,
            Model.Components.Any(c => string.Equals(c.Type, "waiting", StringComparison.OrdinalIgnoreCase)),
            Model.AvailableActions.Any());

        var partialName = shell switch
        {
            "question" => "_WorkflowStep-Question",
            "check-answers" => "_WorkflowStep-Review",
            "confirmation" => "_WorkflowStep-Completion",
            "status-timeline" => "_WorkflowStep-StatusTimeline",
            "task-list" => "_WorkflowStep-TaskList",
            "waiting" => "_WorkflowStep-Waiting",
            _ => $"_WorkflowStep-{shell}"
        };

        var viewResult = ViewEngine.FindView(ViewContext, partialName, false);
        if (viewResult.Success)
        {
            if (partialName == "_WorkflowStep-Question")
            {
                <div class="workflow-page__header">
                    <h1 class="workflow-page__title">@Model.StateDisplayName</h1>
                </div>
            }

            @await Html.PartialAsync(partialName, Model)
        }
        else
        {
            <div class="workflow-page__header">
                <h1 class="workflow-page__title">@Model.StateDisplayName</h1>
            </div>
            <div class="workflow-alert workflow-alert--warn">
                <p>No template found for workflow shell: <code>@shell</code></p>
            </div>
        }
    }
</div>