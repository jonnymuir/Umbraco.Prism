@using Umbraco.Cms.Web.Common.PublishedModels
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
    Layout = "~/Views/Shared/Master.cshtml";
    var heroTitle = Model.Value<string>("heroTitle") ?? "Welcome to Vinyl Vault";
    var heroSubtitle = Model.Value<string>("heroSubtitle") ?? "Your notification-powered vinyl record shop";
    
    // Get all genre landing pages (children of this node)
    var genres = Model.Children<VinylGenreLanding>().ToList();
}

<div class="vinyl-vault-home">
    <div class="hero">
        <h1>@heroTitle</h1>
        <p>@heroSubtitle</p>
    </div>

    <div class="genres-grid">
        <h2>Browse by Genre</h2>
        <div class="genre-tiles">
            @foreach (var genre in genres)
            {
                var genreName = genre.Value<string>("genre") ?? genre.Name;
                var description = genre.Value<string>("description") ?? "";
                
                <a href="@genre.Url()" class="genre-tile">
                    <div class="genre-icon">🎵</div>
                    <h3>@genreName</h3>
                    <p>@description</p>
                </a>
            }
        </div>
    </div>

    <div class="recent-arrivals">
        <h2>Recent Arrivals</h2>
        <div class="vinyl-grid">
            @{
                // Get all vinyl records across all genres, sorted by create date
                var allVinyls = genres
                    .SelectMany(g => g.Children<VinylRecord>())
                    .OrderByDescending(v => v.CreateDate)
                    .Take(8)
                    .ToList();
            }
            @foreach (var vinyl in allVinyls)
            {
                var title = vinyl.Value<string>("title") ?? vinyl.Name;
                var artist = vinyl.Value<string>("artist") ?? "";
                var inStock = vinyl.Value<bool>("inStock");
                
                <a href="@vinyl.Url()" class="vinyl-card">
                    <div class="vinyl-cover">
                        @* Cover image would be rendered here when MediaPicker is fully set up *@
                        <div class="placeholder-cover">🎶</div>
                    </div>
                    <h4>@artist</h4>
                    <p>@title</p>
                    @if (!inStock)
                    {
                        <span class="badge out-of-stock">Out of Stock</span>
                    }
                </a>
            }
        </div>
    </div>
</div>
