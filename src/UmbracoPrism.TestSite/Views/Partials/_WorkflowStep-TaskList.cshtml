@model UmbracoPrism.TestSite.Models.WorkflowViewModel

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <h1 class="govuk-heading-l">@Model.StateDisplayName</h1>
        
        @{
            var totalSections = Model.FieldGroups.Count;
            var completedSections = Model.FieldGroups.Count(g => g.Fields.All(f => !string.IsNullOrEmpty(f.Value?.ToString())));
        }
        
        <p class="govuk-body">You have completed @completedSections of @totalSections sections.</p>

        <ul class="govuk-task-list">
            @foreach (var group in Model.FieldGroups)
            {
                var isComplete = group.Fields.All(f => !string.IsNullOrEmpty(f.Value?.ToString()));
                var hasStarted = group.Fields.Any(f => !string.IsNullOrEmpty(f.Value?.ToString()));
                var statusTag = isComplete ? "Completed" : hasStarted ? "In progress" : "Not started";
                var tagClass = isComplete ? "govuk-tag" : hasStarted ? "govuk-tag govuk-tag--blue" : "govuk-tag govuk-tag--grey";
                
                <li class="govuk-task-list__item govuk-task-list__item--with-link">
                    <div class="govuk-task-list__name-and-hint">
                        <a class="govuk-link govuk-task-list__link" href="#" aria-describedby="@group.DisplayName-status">
                            @group.DisplayName
                        </a>
                    </div>
                    <div class="govuk-task-list__status" id="@group.DisplayName-status">
                        <strong class="@tagClass">@statusTag</strong>
                    </div>
                </li>
            }
        </ul>

        @if (Model.AvailableActions.Any())
        {
            <div class="govuk-button-group">
                @foreach (var action in Model.AvailableActions)
                {
                    var btnClass = action.Style switch
                    {
                        "primary" => "govuk-button",
                        "destructive" => "govuk-button govuk-button--warning",
                        _ => "govuk-button govuk-button--secondary"
                    };
                    <button type="submit" name="Action" value="@action.ActionKey" class="@btnClass" data-module="govuk-button">
                        @action.Label
                    </button>
                }
            </div>
        }
    </div>
</div>
