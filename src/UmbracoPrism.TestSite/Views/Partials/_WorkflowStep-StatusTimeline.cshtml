@model UmbracoPrism.TestSite.Models.WorkflowViewModel

<div class="prism-workflow prism-workflow--status">
    <div class="prism-status__icon" aria-hidden="true">⏳</div>
    <h2 class="prism-status__heading">@Model.StateDisplayName</h2>
    <p class="prism-status__body">
        We've received your submission and it's currently being reviewed.
        You'll hear from us soon — no further action is needed right now.
    </p>
</div>
