@model UmbracoPrism.Core.Models.Workflow.PrismFieldContext
<div class="@Model.WrapperClass"@Html.Raw(Model.WrapperAttrs)>
    @await Html.PartialAsync("~/Views/Partials/PrismFields/_PrismFieldLabel.cshtml", Model)
    @if (Model.Field.ReadOnly)
    {
        <div class="govuk-body">@Model.DisplayValue</div>
        <input type="hidden" name="fields[@Model.Field.FieldKey]" value="@Model.DisplayValue" />
    }
    else
    {
        <select class="govuk-select@(Model.HasFieldError ? " govuk-select--error" : "")"
                id="@Model.Field.FieldKey"
                name="fields[@Model.Field.FieldKey]"
                data-label="@Model.Field.Label"@Html.Raw(Model.DescribedBy)@Html.Raw(Model.RequiredAttr)@Html.Raw(Model.AriaRequired)@Html.Raw(Model.AriaInvalid)>
            <option value="">-- Select --</option>
            @if (Model.Field.Options != null)
            {
                foreach (var option in Model.Field.Options)
                {
                    <option value="@option" selected="@(option.Equals(Model.DisplayValue, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@option</option>
                }
            }
        </select>
    }
</div>
