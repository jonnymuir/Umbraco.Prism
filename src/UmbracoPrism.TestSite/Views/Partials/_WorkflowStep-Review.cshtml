@model UmbracoPrism.TestSite.Models.WorkflowViewModel
@{
    var token = Html.AntiForgeryToken();
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <h1 class="govuk-heading-l">@Model.StateDisplayName</h1>

        @foreach (var group in Model.FieldGroups)
        {
            <h2 class="govuk-heading-m">@group.DisplayName</h2>
            <dl class="govuk-summary-list">
                @foreach (var field in group.Fields.Where(f => string.IsNullOrEmpty(f.ConditionalOn)))
                {
                    <div class="govuk-summary-list__row">
                        <dt class="govuk-summary-list__key">@field.Label</dt>
                        <dd class="govuk-summary-list__value">@(field.Value ?? "Not answered")</dd>
                        <dd class="govuk-summary-list__actions">
                            @if (!string.IsNullOrEmpty(group.SourceStateKey))
                            {
                                <form method="post" action="@Model.ReturnUrl" style="display:inline">
                                    @token
                                    <input type="hidden" name="InstanceId" value="@Model.InstanceId" />
                                    <input type="hidden" name="StateVersion" value="@Model.StateVersion" />
                                    <input type="hidden" name="WorkflowKey" value="@Model.WorkflowKey" />
                                    <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />
                                    <input type="hidden" name="Nonce" value="@Model.Nonce" />
                                    <button type="submit" name="Action" value="change:@group.SourceStateKey"
                                            class="govuk-link govuk-link--no-visited-state"
                                            style="background:none;border:none;cursor:pointer;padding:0;font-size:inherit;font-family:inherit;text-decoration:underline">
                                        Change<span class="govuk-visually-hidden"> @field.Label.ToLower()</span>
                                    </button>
                                </form>
                            }
                            else
                            {
                                <a class="govuk-link" href="#">
                                    Change<span class="govuk-visually-hidden"> @field.Label.ToLower()</span>
                                </a>
                            }
                        </dd>
                    </div>
                }
            </dl>
        }

        <form method="post" action="@Model.ReturnUrl">
            @token
            <input type="hidden" name="InstanceId" value="@Model.InstanceId" />
            <input type="hidden" name="StateVersion" value="@Model.StateVersion" />
            <input type="hidden" name="WorkflowKey" value="@Model.WorkflowKey" />
            <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />
            <input type="hidden" name="Nonce" value="@Model.Nonce" />

            <div class="govuk-button-group">
                @foreach (var action in Model.AvailableActions)
                {
                    var btnClass = action.Style switch
                    {
                        "primary" => "govuk-button",
                        "destructive" => "govuk-button govuk-button--warning",
                        _ => "govuk-button govuk-button--secondary"
                    };
                    <button type="submit" name="Action" value="@action.ActionKey" class="@btnClass" data-module="govuk-button">
                        @action.Label
                    </button>
                }
            </div>
        </form>
    </div>
</div>
