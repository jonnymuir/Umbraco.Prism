@using UmbracoPrism.TestSite.Models
@model WorkflowViewModel

<div class="prism-instance-picker" role="region" aria-label="Resume or start a new workflow">
    <h2 class="prism-instance-picker__title">You have an existing request</h2>
    <p class="prism-instance-picker__description">
        Would you like to continue your existing @Model.WorkflowDisplayName request
        or start a new one?
    </p>
    <div class="prism-instance-picker__actions">
        <a href="?action=resume" class="prism-button prism-button--primary">Continue existing request</a>
        <a href="?action=start-new" class="prism-button prism-button--secondary">Start a new request</a>
    </div>
</div>
