@using Umbraco.Cms.Core.Models.Blocks
@using System.Text.Json
@model IEnumerable<BlockListItem>

@if (Model != null && Model.Any())
{
    var currentPath = Context.Request.Path.Value ?? "/";

    var navItems = Model.Select(block => new
    {
        label  = block.Content.Value<string>("navLabel") ?? string.Empty,
        href   = block.Content.Value<string>("navUrl") ?? "/",
        icon   = block.Content.Value<IPublishedContent?>("navIcon")?.Url(),
        target = block.Content.Value<bool>("openInNewTab") ? "_blank" : (string?)null,
    });

    var itemsJson = JsonSerializer.Serialize(navItems, new JsonSerializerOptions
    {
        DefaultIgnoreCondition = System.Text.Json.Serialization.JsonIgnoreCondition.WhenWritingNull
    });

    <script type="module" src="/App_Plugins/UmbracoPrism/dist/prism-mobile-nav.js"></script>
    <prism-mobile-nav
        items='@itemsJson'
        current-path="@currentPath"
        nav-label="Mobile app navigation">
    </prism-mobile-nav>
}
