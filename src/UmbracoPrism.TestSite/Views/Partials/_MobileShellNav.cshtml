@using Umbraco.Cms.Core.Models.Blocks
@using Umbraco.Cms.Core.Services
@using System.Text.Json
@using UmbracoPrism.Core.Models
@using UmbracoPrism.Core.Services
@model IEnumerable<BlockListItem>
@inject IDocumentUrlService DocumentUrlService
@inject IPrismPageAccessResolver PageAccessResolver

@if (Model != null && Model.Any())
{
    var currentPath = Context.Request.Path.Value ?? "/";

    var navItems = UmbracoPrism.TestSite.Services.MobileNavItems
        .Available(Model, DocumentUrlService, PageAccessResolver, PrismContext.CurrentTenant, Context.User.Identity?.IsAuthenticated == true)
        .Select(item => new
        {
            label  = item.Label,
            href   = item.Href,
            icon   = item.IconUrl,
            target = item.OpenInNewTab ? "_blank" : (string?)null,
        });

    var itemsJson = JsonSerializer.Serialize(navItems, new JsonSerializerOptions
    {
        DefaultIgnoreCondition = System.Text.Json.Serialization.JsonIgnoreCondition.WhenWritingNull
    });

    <script type="module" src="/App_Plugins/UmbracoPrism/dist/prism-mobile-nav.js" asp-append-version="true"></script>
    <prism-mobile-nav
        items='@itemsJson'
        current-path="@currentPath"
        nav-label="Mobile app navigation">
    </prism-mobile-nav>
}
