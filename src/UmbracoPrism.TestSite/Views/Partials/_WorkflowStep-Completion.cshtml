@model UmbracoPrism.TestSite.Models.WorkflowViewModel

<div class="prism-workflow prism-workflow--complete">
    <div class="prism-panel--confirmation">
        <p class="prism-completion__icon" aria-hidden="true">✅</p>
        <h2 class="prism-panel__title">@Model.StateDisplayName</h2>
        <p class="prism-panel__body">
            Thank you — your submission has been received. A member of our team will be in touch shortly.
        </p>
    </div>
    <div class="prism-workflow__actions">
        <a href="/" class="prism-button prism-button--secondary">Return to home</a>
    </div>
</div>
