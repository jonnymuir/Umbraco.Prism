@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
    Layout = null;
    var title = Model.Value<string>("pageTitle") ?? "Service Blueprint Demo";
    var intro = Model.Value<string>("pageIntro");
    var definitionKey = Model.Value<string>("blueprintKey") ?? "information-request";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@title - Prism Service Blueprint Demo</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
            line-height: 1.6;
            color: #333;
            background: #f5f5f5;
        }

        .prism-service-blueprint-demo {
            max-width: 800px;
            margin: 0 auto;
            padding: 2rem 1rem;
        }

        h1 {
            font-size: 2.5rem;
            font-weight: 700;
            color: #1a1a1a;
            margin-bottom: 1rem;
        }

        .intro {
            font-size: 1.125rem;
            color: #666;
            margin-bottom: 2rem;
            line-height: 1.8;
        }

        prism-service-blueprint-shell {
            display: block;
            background: white;
            border-radius: 8px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
            padding: 2rem;
        }

        .loading {
            text-align: center;
            padding: 3rem;
            color: #999;
        }
    </style>
</head>
<body>
    <main class="prism-service-blueprint-demo">
        <h1>@title</h1>

        @if (!string.IsNullOrEmpty(intro))
        {
            <p class="intro">@intro</p>
        }

        <prism-service-blueprint-shell definition-key="@definitionKey">
            <div class="loading">Loading service blueprint...</div>
        </prism-service-blueprint-shell>
    </main>

    @*
        NOTE: This script tag references the client-side Web Component that Isabelle will implement.
        The <prism-service-blueprint-shell> custom element is a placeholder for now.
    *@
    <script type="module" src="/dist/prism-service-blueprint.js"></script>
</body>
</html>
