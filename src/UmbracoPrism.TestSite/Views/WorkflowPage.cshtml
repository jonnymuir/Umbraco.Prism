@model UmbracoPrism.TestSite.Models.WorkflowViewModel
@inject Microsoft.AspNetCore.Mvc.ViewEngines.ICompositeViewEngine _viewEngine
@{
    Layout = "Master";
    ViewBag.Title = Model.HasError ? "Workflow Error" : Model.StateDisplayName;
}

<div class="workflow-page">
    <div class="workflow-page__header">
        <h1 class="workflow-page__title">@(Model.HasError ? "Workflow Error" : Model.StateDisplayName)</h1>
    </div>

    @if (Model.HasError)
    {
        <div class="workflow-alert workflow-alert--error">
            <p>@Model.ErrorMessage</p>
        </div>
    }
    else
    {
        @{
            var partialName = $"_WorkflowStep-{Model.Archetype}";
            var partialPath = $"~/Views/Partials/{partialName}.cshtml";
            var viewResult = _viewEngine.GetView(null, partialPath, false);
        }
        @if (viewResult.Success)
        {
            @await Html.PartialAsync(partialName, Model)
        }
        else
        {
            <div class="workflow-alert workflow-alert--warn">
                <p>No template found for step type: <code>@Model.Archetype</code></p>
            </div>
        }
    }
</div>