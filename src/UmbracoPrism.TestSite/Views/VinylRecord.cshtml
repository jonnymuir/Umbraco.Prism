@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@using Wayfinder.Services.Sanitization
@inject IServiceContentSanitizer Sanitizer
@{
    Layout = "~/Views/Shared/Master.cshtml";
    
    var title = Model.Value<string>("title") ?? Model.Name;
    var artist = Model.Value<string>("artist") ?? "";
    var genre = Model.Value<string>("genre") ?? "";
    var releaseYear = Model.Value<int?>("releaseYear");
    var description = Model.Value<string>("description") ?? "";
    var inStock = Model.Value<bool>("inStock");
    var stockCount = Model.Value<int?>("stockCount") ?? 0;
    var isLimitedEdition = Model.Value<bool>("isLimitedEdition");
    
    // Get parent genre page
    var genrePage = Model.Parent();
    var genreName = genrePage?.Value<string>("genre") ?? genre;
    var vaultHomePage = Model.Root()?.Children().FirstOrDefault(child => child.ContentType.Alias == "vinylVaultHome");
}

<div class="vinyl-detail">
    <div class="vinyl-header">
        <div class="vinyl-cover-large">
            @* Cover image placeholder - would use MediaPicker when fully set up *@
            <div class="placeholder-cover">🎶</div>
        </div>
        
        <div class="vinyl-meta">
            <div class="breadcrumb">
                <a href="@(Model.Root()?.Url())">Home</a> › 
                <a href="@(vaultHomePage?.Url())">Vinyl Vault</a> › 
                @if (genrePage != null)
                {
                    <a href="@genrePage.Url()">@genreName</a> <text>›</text>
                }
                <span>@title</span>
            </div>
            
            <h1>@title</h1>
            <h2 class="artist">@artist</h2>
            
            <div class="vinyl-details">
                @if (!string.IsNullOrWhiteSpace(genre))
                {
                    <p><strong>Genre:</strong> @genre</p>
                }
                @if (releaseYear.HasValue)
                {
                    <p><strong>Release Year:</strong> @releaseYear.Value</p>
                }
                <p><strong>Availability:</strong> 
                    @if (inStock)
                    {
                        <span class="badge badge-in-stock">In Stock (@stockCount available)</span>
                    }
                    else
                    {
                        <span class="badge badge-out-of-stock">Out of Stock</span>
                    }
                </p>
                @if (isLimitedEdition)
                {
                    <p><span class="badge badge-limited">⭐ Limited Edition</span></p>
                }
            </div>
            
            @* Subscription button for this genre *@
            <div class="actions">
                <button class="btn-subscribe" onclick="subscribeToGenre('@genreName')">
                    🔔 Subscribe to @genreName Notifications
                </button>
                @if (!inStock)
                {
                    <button class="btn-waitlist" onclick="joinWaitlist('@Model.Key')">
                        📬 Join Waitlist
                    </button>
                }
            </div>
        </div>
    </div>
    
    @if (!string.IsNullOrWhiteSpace(description))
    {
        <div class="vinyl-description">
            <h3>About This Album</h3>
            @Html.Raw(Sanitizer.Sanitize(description))
        </div>
    }
    
    <div class="back-link">
        @if (genrePage != null)
        {
            <a href="@genrePage.Url()">← Back to @genreName</a>
        }
    </div>
</div>

<script>
    function subscribeToGenre(genre) {
        // TODO: Wire to PrismNotificationService API
        alert('Subscribe to ' + genre + ' notifications - will call /umbraco/api/prismnotification/subscribe');
        console.log('Subscribe to genre:', genre);
        
        // Example API call (to be implemented):
        // fetch('/umbraco/api/prismnotification/subscribe', {
        //     method: 'POST',
        //     headers: { 'Content-Type': 'application/json' },
        //     body: JSON.stringify({ 
        //         userId: 'current-user-id',  // From auth context
        //         tenantId: 'current-tenant',  // From tenant context
        //         genre: genre 
        //     })
        // });
    }
    
    function joinWaitlist(contentKey) {
        // TODO: Wire to waitlist API (when Blathers implements it)
        alert('Join waitlist for this vinyl - feature to be implemented');
        console.log('Join waitlist for:', contentKey);
    }
</script>
