@using Wayfinder.Umbraco.Models
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<ServiceRequestPageViewModel>
@inject Microsoft.AspNetCore.Mvc.ViewEngines.ICompositeViewEngine ViewEngine
@{
    Layout = "~/Views/Shared/Master.cshtml";
    ViewBag.Title = Model.HasError ? "Service Request Error" : Model.StateDisplayName;
}

<div class="stage-page">
    @if (Model.HasError)
    {
        <div class="stage-page__header">
            <h1 class="stage-page__title">Service Request Error</h1>
        </div>
        <div class="stage-alert stage-alert--error">
            <p>@Model.ErrorMessage</p>
        </div>
    }
    else if (Model.ShowInstancePicker)
    {
        <div class="stage-page__header">
            <h1 class="stage-page__title">@Model.StateDisplayName</h1>
        </div>
        @await Html.PartialAsync("_ServiceRequestHub-InstancePicker", Model)
    }
    else
    {
        var shell = ServiceRequestRenderShellResolver.ResolveShell(
            Model.Components,
            Model.StepType,
            Model.Components.Any(c => string.Equals(c.Type, "waiting", StringComparison.OrdinalIgnoreCase)),
            Model.AvailableActions.Any());

        var partialName = shell switch
        {
            "question" => "_Stage-Question",
            "check-answers" => "_Stage-Review",
            "confirmation" => "_Stage-Completion",
            "status-timeline" => "_Stage-StatusTimeline",
            "task-list" => "_Stage-TaskList",
            "waiting" => "_Stage-Waiting",
            _ => $"_Stage-{shell}"
        };

        var viewResult = ViewEngine.FindView(ViewContext, partialName, false);
        if (viewResult.Success)
        {
            if (partialName == "_Stage-Question")
            {
                <div class="stage-page__header">
                    <h1 class="stage-page__title">@Model.StateDisplayName</h1>
                </div>
            }

            @await Html.PartialAsync(partialName, Model)
        }
        else
        {
            <div class="stage-page__header">
                <h1 class="stage-page__title">@Model.StateDisplayName</h1>
            </div>
            <div class="stage-alert stage-alert--warn">
                <p>No template found for stage shell: <code>@shell</code></p>
            </div>
        }
    }
</div>