@using UmbracoPrism.TestSite.Services.ServiceDesign
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<Umbraco.Cms.Web.Common.PublishedModels.MemberDashboard>
@{
    Layout = "~/Views/Shared/Master.cshtml";

    var tenant = PrismContext.CurrentTenant;
    var displayName = ViewBag.DisplayName as string ?? "Member";
    var email = ViewBag.Email as string ?? "";
    var userOid = ViewBag.UserOid as string ?? "";
    var contributionsUrl = TestSiteSeedContract.ContributionsPageUrl;
    var caseworkerQueueUrl = TestSiteSeedContract.CaseworkerQueuePageUrl;
    var jugglingLicenceUrl = TestSiteSeedContract.JugglingLicencePageUrl;
    // Every signed-in Prism member reaches this dashboard the same way, but only the NJF
    // Contributions Team roster (see NjfContributionsTeam's own remarks) actually has access to
    // the caseworker queue / contributions upload — most members are demo@prism.local, a plain
    // citizen persona, not a caseworker. Gate the cards on the real roster rather than showing an
    // affordance that leads to "Access denied" for most signed-in visitors.
    var isNjfCaseworker = NjfContributionsTeam.IsMember(email);
}

<main class="dash-page">
        <div class="dash-welcome">
            <h1>Welcome back, @displayName</h1>
            <p>Manage your account, documents, and security settings.</p>
        </div>

        <!-- Account overview cards -->
        <!-- Overview cards -->
        <div class="dash-grid">
            <div class="dash-card">
                <div class="dash-card__icon dash-card__icon--account">👤</div>
                <h3>My Account</h3>
                <p>View and update your personal information, contact details, and communication preferences.</p>
            </div>
            <div class="dash-card">
                <div class="dash-card__icon dash-card__icon--documents">📄</div>
                <h3>Documents</h3>
                <p>Access your statements, correspondence, and important documents in one secure location.</p>
            </div>
            <div class="dash-card">
                <div class="dash-card__icon dash-card__icon--support">💬</div>
                <h3>Support</h3>
                <p>Get help with your account. Contact our team or browse frequently asked questions.</p>
            </div>
            @if (isNjfCaseworker)
            {
                <div class="dash-card dash-card--cta">
                    <div class="dash-card__icon dash-card__icon--service-request">📋</div>
                    <h3>Caseworker queue</h3>
                    <p>The NJF Contributions Team's worklist — pick up and review submitted contributions files.</p>
                    <a href="@caseworkerQueueUrl" class="btn btn-primary u-mt-12">View queue</a>
                </div>
            }
            else
            {
                <div class="dash-card dash-card--cta">
                    <div class="dash-card__icon dash-card__icon--service-request">🤹</div>
                    <h3>Apply for a juggling licence</h3>
                    <p>Signed-in members get their Juggling Society membership discount applied automatically.</p>
                    <a href="@jugglingLicenceUrl" class="btn btn-primary u-mt-12">Start application</a>
                </div>
            }
        </div>

        <!-- Wayfinder service design demo — service-design capability itself lives entirely in
             Wayfinder.Umbraco (see docs/guides/support-systems.md in the core Wayfinder repo).
             Only the NJF Contributions Team roster (njf-caseworker@prism.local) has access to
             this worked example — see NjfContributionsTeam's own remarks; a plain member
             (demo@prism.local) doesn't see this section at all, since the link would only lead
             to "Access denied". -->
        @if (isNjfCaseworker)
        {
            <div class="dash-section">
                <h2>Wayfinder service design demo</h2>
                <p>As an NJF Contributions Team member, submit and review a monthly contributions file — Wayfinder's bulk data review capability, backed by a real downstream support system (Mock Business App).</p>
                <div class="dash-grid u-mt-16">
                    <div class="dash-card dash-card--cta">
                        <div class="dash-card__icon dash-card__icon--service-request">📤</div>
                        <h3>Submit contributions file</h3>
                        <p>Upload the monthly CSV of member contributions for validation.</p>
                        <a href="@contributionsUrl" class="btn btn-primary u-mt-12">Start</a>
                    </div>
                </div>
            </div>
        }

        <!-- Biometric authentication section -->
        <div class="dash-section">
            <h2>Biometric Authentication</h2>
            <p>Use Face ID or fingerprint to sign in securely from the mobile app — no password needed.</p>

            <div class="dash-bio-card">
                <!-- Static "Not configured" is the correct default — it's what a desktop web
                     visitor genuinely sees (there's no biometric hardware to check). On the
                     actual mobile app, prism-biometric-status.js below rewrites this in place
                     to reflect this device's real enrollment state; found live: this previously
                     said "Not configured" unconditionally, even moments after a real, successful
                     Face ID enrollment and sign-in, because nothing had ever wired it up to an
                     actual check. -->
                <div class="dash-bio-status" data-prism-biometric-status>
                    <div class="dash-bio-status__dot dash-bio-status__dot--inactive" data-prism-biometric-dot></div>
                    <strong data-prism-biometric-label>Not configured</strong>
                    <span class="dash-bio-status__hint" data-prism-biometric-hint>Set up via mobile app</span>
                </div>

                <div class="dash-bio-steps" data-prism-biometric-steps>
                    <div class="dash-bio-step">
                        <div class="dash-bio-step__num">1</div>
                        <div>
                            <h4>Open the mobile app</h4>
                            <p>Download and install the Prism mobile app for iOS or Android.</p>
                        </div>
                    </div>
                    <div class="dash-bio-step">
                        <div class="dash-bio-step__num">2</div>
                        <div>
                            <h4>Sign in with your account</h4>
                            <p>Log in using your existing credentials to link your device.</p>
                        </div>
                    </div>
                    <div class="dash-bio-step">
                        <div class="dash-bio-step__num">3</div>
                        <div>
                            <h4>Enable biometric login</h4>
                            <p>Follow the prompt to register Face ID or fingerprint. Future sign-ins will be instant.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Profile details -->
        <div class="dash-section">
            <h2>Profile</h2>
            <p>Your account details from your identity provider.</p>

            <div class="dash-profile">
                <div class="dash-profile__row">
                    <span class="dash-profile__label">Name</span>
                    <span class="dash-profile__value">@displayName</span>
                </div>
                @if (!string.IsNullOrEmpty(email))
                {
                    <div class="dash-profile__row">
                        <span class="dash-profile__label">Email</span>
                        <span class="dash-profile__value">@email</span>
                    </div>
                }
                <div class="dash-profile__row">
                    <span class="dash-profile__label">Tenant</span>
                    <span class="dash-profile__value">@(tenant?.Name ?? "—")</span>
                </div>
            </div>
        </div>

        @* 
            Phase 1 Security: Downstream API demo is environment-gated via DownstreamDemoController.
            Only functional in Development or when Prism:EnableDownstreamDemo=true.
            URL forwarding is restricted to allowlist to prevent token leakage.
        *@
        <!-- Downstream API demo -->
        <div class="dash-section">
            <h2>Downstream API</h2>
            <p>Demonstrates how Prism propagates your identity to business applications via a Bearer token.</p>

            <div class="dash-api-card">
                <div id="api-idle">
                    <p class="dash-api-card__intro">
                        Click the button below to call the Mock Business App API using your current Prism Bearer token.
                        The API will validate the token, resolve your tenant, and return your registered role.
                    </p>
                    <button class="btn btn-primary dash-api-card__btn" id="api-btn" type="button">
                        Call Mock Business App API
                    </button>
                    <div class="api-hint">
                        💡 Make sure Mock Business App is running first:<br />
                        <code>dotnet run --project src/UmbracoPrism.MockBusinessApp</code>
                    </div>
                </div>

                <div id="api-loading" role="status" aria-live="polite" class="dash-api-card__loading">
                    ⏳ Calling Mock Business App…
                </div>

                <div id="api-result" class="dash-api-card__result" aria-live="polite">
                    <div id="api-status-bar" class="dash-api-card__status-bar">
                        <span id="api-status-badge" class="dash-api-card__badge"></span>
                        <span id="api-url-label" class="dash-api-card__url"></span>
                        <span id="api-timing" class="dash-api-card__timing"></span>
                    </div>
                    <p id="api-summary" aria-live="polite" class="dash-api-card__summary"></p>
                    <div class="dash-api-card__result-box">
                        <div class="dash-api-card__result-header">
                            <div class="dash-api-card__result-header-left">
                                <span id="api-body-label" class="dash-api-card__body-label"></span>
                                <span id="api-content-type" class="dash-api-card__content-type"></span>
                            </div>
                            <button id="api-reset-btn" type="button" class="dash-api-card__reset-btn">✕ Reset</button>
                        </div>
                        <pre id="api-body" class="dash-api-card__body"></pre>
                    </div>
                </div>
            </div>
        </div>

        <!-- Downstream API demo script (SEC-PT2-004: externalized, not spliced inline; the
             call/reset buttons above are wired by id in the script itself, not onclick="..."). -->
        <script src="/js/member-dashboard-downstream-demo.js"></script>

        <!-- Rewrites the Biometric Authentication card above to this device's real enrollment
             state — a no-op outside the native app, where the static "Not configured" markup
             is already the right message. -->
        <script src="/App_Plugins/UmbracoPrism/mobile-shell/prism-biometric-status.js"></script>


        <div class="u-mt-24">
            <form method="post" action="/auth/logout">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline">Sign Out</button>
            </form>
        </div>
    </main>