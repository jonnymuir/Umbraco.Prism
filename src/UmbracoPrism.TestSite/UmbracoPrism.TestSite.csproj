<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <CompressionEnabled>false</CompressionEnabled> <!-- Disable compression. E.g. for umbraco backoffice files. These files should be precompressed by node and not let dotnet handle it -->
    <UserSecretsId>882392cb-6c22-4ca1-9e7f-667d9e867262</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MailKit" Version="4.16.0" />
    <PackageReference Include="Umbraco.Cms" Version="$(UmbracoVersion)" />
    <PackageReference Include="Umbraco.Cms.DevelopmentMode.Backoffice" Version="$(UmbracoVersion)" />
    <PackageReference Include="Azure.Extensions.AspNetCore.Configuration.Secrets" Version="1.3.2" />
    <PackageReference Include="Microsoft.OpenApi" Version="2.7.5" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Opt-in to app-local ICU to ensure consistent globalization APIs across different platforms -->
    <PackageReference Include="Microsoft.ICU.ICU4C.Runtime" Version="72.1.0.3" />
    <!-- Only place in this repo that references Wayfinder — Prism.Core carries no service-design
         dependency at all (see docs/guides/support-systems.md in the core Wayfinder repo).
         TestSite installs Wayfinder.Umbraco directly to demonstrate Prism + Wayfinder.Umbraco
         composed together. -->
    <PackageReference Include="Wayfinder" Version="0.7.3" />
    <PackageReference Include="Wayfinder.Engine" Version="0.7.3" />
    <PackageReference Include="Wayfinder.Umbraco" Version="0.7.3" />
    <RuntimeHostConfigurationOption Include="System.Globalization.AppLocalIcu" Value="72.1.0.3" Condition="$(RuntimeIdentifier.StartsWith('linux')) or $(RuntimeIdentifier.StartsWith('win')) or ('$(RuntimeIdentifier)' == '' and !$([MSBuild]::IsOSPlatform('osx')))" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\UmbracoPrism.Core\UmbracoPrism.Core.csproj" />
    <ProjectReference Include="..\UmbracoPrism.uSync\UmbracoPrism.uSync.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="wwwroot/App_Plugins/UmbracoPrism/**" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="cms-service-blueprints\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <PropertyGroup>
    <!-- Razor files are needed for the backoffice to work correctly -->
    <CopyRazorGenerateFilesToPublishDirectory>true</CopyRazorGenerateFilesToPublishDirectory>
  </PropertyGroup>

  <PropertyGroup>
    <!-- InMemoryAuto generates models at runtime only; the old SourceCodeAuto .generated.cs
         files are excluded from compilation below to avoid type conflicts. Build-time Razor
         compilation is disabled because model types are only available at runtime. -->
    <RazorCompileOnBuild>false</RazorCompileOnBuild>
    <RazorCompileOnPublish>false</RazorCompileOnPublish>
  </PropertyGroup>

  <ItemGroup>
    <!-- Exclude SourceCodeAuto-generated model files: InMemoryAuto regenerates these at
         runtime in ModelsGeneratedAssembly. Compiling them in causes type-ambiguity errors
         when CollectibleRuntimeViewCompiler compiles views that reference those types. -->
    <Compile Remove="umbraco/models/**/*.generated.cs" />
  </ItemGroup>

  <Target Name="InstallGovukFrontend" BeforeTargets="BeforeBuild">
    <Exec Command="npm ci" WorkingDirectory="$(MSBuildProjectDirectory)" />
    <Copy SourceFiles="node_modules/govuk-frontend/dist/govuk/govuk-frontend.min.css" DestinationFolder="wwwroot/css" />
    <Copy SourceFiles="node_modules/govuk-frontend/dist/govuk/govuk-frontend.min.js" DestinationFolder="wwwroot/js" />
  </Target>

</Project>
