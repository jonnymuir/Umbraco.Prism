{
  "$schema": "appsettings-schema.json",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    }
  },
  "Umbraco": {
    "CMS": {
      "Global": {
        "Id": "bfa96ff9-d8ca-4592-b3aa-13fcee9bfd96",
        "SanitizeTinyMce": true
      },
      "Content": {
        "AllowEditInvariantFromNonDefault": true,
        "ContentVersionCleanupPolicy": {
          "EnableCleanup": true
        }
      },
      "Unattended": {
        "UpgradeUnattended": true
      },
      "Security": {
        "AllowConcurrentLogins": false
      },
      "ModelsBuilder": {
        "ModelsMode": "InMemoryAuto",
        "ModelsNamespace": "Umbraco.Cms.Web.Common.PublishedModels",
        "AcceptUnsafeModelsDirectory": true
      },
      "Runtime": {
        "MaxRequestLength": 102400
      }
    }
  },
  "ConnectionStrings": {
    "umbracoDbDSN": "Data Source=|DataDirectory|/Umbraco.sqlite.db;Cache=Shared;Foreign Keys=True;Pooling=True",
    "umbracoDbDSN_ProviderName": "Microsoft.Data.Sqlite",
    "umbracoAutomateDbDSN": "Data Source=|DataDirectory|/Automate.sqlite.db;Cache=Shared;Foreign Keys=True;Pooling=True",
    "umbracoAutomateDbDSN_ProviderName": "Microsoft.Data.Sqlite"
  },
  "Prism": {
    "SeedStarterContent": true,
    "Notifications": {
      "NotifiableContentTypes": "vinylRecord"
    }
  },
  "Wayfinder": {
    "SupportSystems": [
      {
        "key": "juggling-licence-decision",
        "displayName": "Juggling Licence Decision",
        "description": "An Umbraco Automate automation on this same site decides applications automatically: recreational licences are approved instantly, competitive/professional ones go through a human approval step inside Automate. Either way it pushes a Prism notification to the applicant before handing the journey back.",
        "endpoint": {
          "method": "POST",
          "auth": { "type": "hmac-sha256", "secretRef": "JUGGLING_LICENCE_SIGNING_KEY" },
          "callbackSecretRef": "JUGGLING_LICENCE_CALLBACK_SECRET"
        },
        "capabilities": [
          {
            "key": "decide-application",
            "displayName": "Decide a juggling licence application",
            "completionModes": ["Webhook"],
            "inputs": [
              { "key": "licenceType", "title": "Licence type", "valueKind": "String", "format": "field-ref", "required": true }
            ],
            "outputs": [
              { "key": "applicationDecisionNote", "title": "Decision note", "valueKind": "String" }
            ],
            "outcomes": [
              { "key": "approved", "displayName": "Approved" },
              { "key": "referred", "displayName": "Referred" }
            ]
          }
        ]
      }
    ]
  }
}