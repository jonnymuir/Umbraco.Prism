<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>UmbracoPrism.WorkflowRuntime.Mcp</RootNamespace>
    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageId>UmbracoPrism.WorkflowRuntime.Mcp</PackageId>
    <Title>Umbraco Prism Workflow Authoring MCP</Title>
    <Version>0.1.0</Version>
    <Authors>Jonny Muir</Authors>
    <Company>Umbraco Prism</Company>
    <Description>ASP.NET Core MCP-over-HTTP endpoint mapping that exposes Umbraco Prism workflow authoring (list/read/validate/save/simulate) as MCP tools — a single MapPrismWorkflowAuthoringMcp() call any host adds to its own pipeline, alongside MapPrismWorkflowAuthoringApi(), inheriting its own auth.</Description>
    <PackageTags>Workflow;MCP;Model-Context-Protocol;Umbraco-Prism</PackageTags>
    <PackageProjectUrl>https://github.com/jonnymuir/Umbraco.Prism</PackageProjectUrl>
    <RepositoryUrl>https://github.com/jonnymuir/Umbraco.Prism</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageIcon>assets/logo-vertical-lockup.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="1.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../UmbracoPrism.WorkflowRuntime/UmbracoPrism.WorkflowRuntime.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="../../docs/guides/calculation-language.md" LogicalName="UmbracoPrism.WorkflowRuntime.Mcp.docs.calculation-language.md" />
    <EmbeddedResource Include="../../docs/guides/reference-workflow-contract.md" LogicalName="UmbracoPrism.WorkflowRuntime.Mcp.docs.reference-workflow-contract.md" />
    <EmbeddedResource Include="../../docs/guides/service-design-principles.md" LogicalName="UmbracoPrism.WorkflowRuntime.Mcp.docs.service-design-principles.md" />
    <EmbeddedResource Include="../../docs/guides/ai-workflow-authoring.md" LogicalName="UmbracoPrism.WorkflowRuntime.Mcp.docs.ai-workflow-authoring.md" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../assets/logo-vertical-lockup.png" Pack="true" PackagePath="assets/" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
