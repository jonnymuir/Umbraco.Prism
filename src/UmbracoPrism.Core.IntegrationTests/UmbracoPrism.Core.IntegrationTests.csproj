<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Booted-host integration lane for Prism's HTTP surface. Runs in its OWN test process so the
    real Umbraco host (booted via WebApplicationFactory<Program> over UmbracoPrism.TestSite) does
    not share process-global state — notably Wayfinder's static SupportSystemRegistry, which the
    TestSite registers into and which cannot be re-registered once read — with
    UmbracoPrism.Core.Tests. One shared ICollectionFixture boot serves every test class here.

    Not the Aspire localhost-auth lane: this asserts authorization *enforcement* (does [Authorize]
    challenge, does a policy deny, does the antiforgery filter fire) which needs neither Keycloak
    nor a real identity — just the booted pipeline. The full authenticated end-to-end stays in
    localhost-auth-playwright.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.0.1" />
    <PackageReference Include="AwesomeAssertions" Version="7.2.1" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- The host under test — WebApplicationFactory<Program> boots this exact project. -->
    <ProjectReference Include="../UmbracoPrism.TestSite/UmbracoPrism.TestSite.csproj" />
    <ProjectReference Include="../UmbracoPrism.Core/UmbracoPrism.Core.csproj" />
  </ItemGroup>

</Project>
