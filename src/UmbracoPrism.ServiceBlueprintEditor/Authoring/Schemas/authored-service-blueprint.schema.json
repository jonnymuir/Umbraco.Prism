{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://umbracoprism.dev/schemas/authored-workflow.schema.json",
  "type": "object",
  "required": ["definitionKey", "displayName", "initialTouchpointKey", "touchpoints", "gateways"],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "definitionKey": { "type": "string" },
    "displayName": { "type": "string" },
    "version": { "type": "integer", "minimum": 1 },
    "description": { "type": ["string", "null"] },
    "schemaVersion": { "type": "string" },
    "initialTouchpointKey": { "type": "string" },
    "requestPolicy": { "type": "string" },
    "queues": {
      "type": "array",
      "items": { "$ref": "#/$defs/queue" }
    },
    "lanes": {
      "type": "array",
      "items": { "$ref": "#/$defs/queue" }
    },
    "touchpoints": {
      "type": "array",
      "items": { "$ref": "#/$defs/touchpoint" }
    },
    "gateways": {
      "type": "array",
      "items": { "$ref": "#/$defs/gateway" }
    },
    "handoffs": {
      "type": "array",
      "items": { "type": "object" }
    },
    "parameterSchemas": {
      "type": "array",
      "items": { "$ref": "#/$defs/parameterSchema" }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "authorNote": { "type": ["string", "null"] }
  },
  "$defs": {
    "touchpoint": {
      "type": "object",
      "required": ["key", "title", "type", "queueKey"],
      "properties": {
        "key": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": ["string", "null"] },
        "type": { "type": "string" },
        "actor": { "type": ["string", "null"] },
        "queueKey": { "type": "string" },
        "laneKey": { "type": ["string", "null"] },
        "actions": { "type": "array", "items": { "$ref": "#/$defs/action" } },
        "components": { "type": "array", "items": { "type": "object" } },
        "roleGates": { "type": "array", "items": { "type": "string" } },
        "routes": { "type": "array", "items": { "$ref": "#/$defs/route" } },
        "editorComment": { "type": ["string", "null"] }
      }
    },
    "queue": {
      "type": "object",
      "required": ["key", "title"],
      "properties": {
        "key": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": ["string", "null"] },
        "actor": { "type": ["string", "null"] },
        "roleGates": { "type": "array", "items": { "type": "string" } },
        "tags": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "gateway": {
      "type": "object",
      "required": ["key", "title", "type", "queueKey", "routes"],
      "properties": {
        "key": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": ["string", "null"] },
        "type": { "enum": ["Split", "Join"] },
        "queueKey": { "type": "string" },
        "laneKey": { "type": ["string", "null"] },
        "source": { "type": ["string", "null"] },
        "routes": { "type": "array", "items": { "$ref": "#/$defs/route" } },
        "actor": { "type": ["string", "null"] },
        "roleGates": { "type": "array", "items": { "type": "string" } },
        "waitingInfo": {
          "type": ["object", "null"],
          "properties": {
            "content": { "type": ["string", "null"] },
            "expectedWaitSeconds": { "type": "integer" },
            "pollIntervalMs": { "type": "integer" },
            "allowDefer": { "type": "boolean" },
            "deferMessage": { "type": ["string", "null"] }
          }
        },
        "requiredIncomingQueues": { "type": "array", "items": { "type": "string" } },
        "requiredIncomingLanes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "route": {
      "type": "object",
      "required": ["id", "target", "trigger"],
      "properties": {
        "id": { "type": "string" },
        "target": { "type": "string" },
        "trigger": { "type": "string" },
        "condition": { "type": ["object", "null"] },
        "requiresRole": { "type": ["string", "null"] },
        "actions": { "type": "array", "items": { "$ref": "#/$defs/action" } }
      }
    },
    "action": {
      "type": "object",
      "required": ["type", "timing"],
      "properties": {
        "type": { "type": "string" },
        "timing": { "type": "string" },
        "parameterSchemaKey": { "type": ["string", "null"] },
        "summary": { "type": ["string", "null"] },
        "params": { "type": ["object", "null"] }
      }
    },
    "parameterSchema": {
      "type": "object",
      "required": ["key"],
      "properties": {
        "key": { "type": "string" },
        "appliesTo": { "type": "array", "items": { "type": "string" } },
        "allowAdditionalProperties": { "type": "boolean" },
        "properties": { "type": "array", "items": { "type": "object" } },
        "required": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
