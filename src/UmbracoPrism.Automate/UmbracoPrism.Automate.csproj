<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Umbraco Automate versions independently of the Umbraco.Cms major/minor it targets — track
         the same 17.x line TestSite's own Umbraco.Automate/Umbraco.Automate.Persistence.Sqlite
         PackageReferences use, not $(UmbracoPackageRange). -->
    <PackageReference Include="Umbraco.Automate.Core" Version="18.4.0" />
    <!-- Umbraco.Automate.Core pulls in SQLitePCLRaw.lib.e_sqlite3 2.1.11 transitively, which has
         a known high-severity advisory (GHSA-2m69-gcr7-jv3q, bundled SQLite < 3.50.2). The
         advisory itself lists no patched 2.x version, but the 3.x line re-versions to track the
         bundled SQLite release directly — pin it here rather than waiting on Umbraco.Automate.Core
         to bump its own reference. Restore-resolution override only, not a public dependency
         choice of this package's own. -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\UmbracoPrism.Core\UmbracoPrism.Core.csproj" />
  </ItemGroup>

</Project>
