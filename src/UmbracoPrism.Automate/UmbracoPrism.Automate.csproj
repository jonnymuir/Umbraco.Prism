<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <!-- Ship the /// XML doc comments. Set here, not in Directory.Build.props: that file is read
         before IsPackable is known. Stage 1: undocumented public members don't fail the build. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <PackageId>UmbracoPrism.Automate</PackageId>
    <Title>Umbraco Prism for Umbraco Automate</Title>
    <Description>Umbraco Automate actions for Umbraco Prism: send a push notification to a member's Prism mobile app from an automation.</Description>
    <PackageTags>Umbraco;Umbraco Automate;Push notifications;Mobile</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Umbraco Automate versions independently of the Umbraco.Cms patch it targets, but its
         major tracks Umbraco's: floor at the 17.x release TestSite runs, ceiling at the next major. -->
    <PackageReference Include="MessagePack" Version="3.1.11" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.13" />
    <PackageReference Include="Umbraco.Automate.Core" Version="[17.4.0, $([MSBuild]::Add($(UmbracoMajor), 1)).0.0)" />
    <PackageReference Include="OpenTelemetry.Api" Version="1.19.1" />
    <!-- Umbraco.Automate.Core pulls in SQLitePCLRaw.lib.e_sqlite3 2.1.11 transitively, which has
         a known high-severity advisory (GHSA-2m69-gcr7-jv3q, bundled SQLite < 3.50.2). The
         advisory itself lists no patched 2.x version, but the 3.x line re-versions to track the
         bundled SQLite release directly, so it is pinned here rather than waiting on
         Umbraco.Automate.Core to bump its own reference. Restore-resolution override only, not a public dependency
         choice of this package's own. -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\UmbracoPrism.Core\UmbracoPrism.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
