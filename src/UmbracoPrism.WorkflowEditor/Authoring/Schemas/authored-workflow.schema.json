{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://umbraco-prism.local/schemas/authored-workflow.schema.json",
  "title": "AuthoredWorkflow",
  "description": "Editor-native workflow schema saved by Workflow Editor V1 and projected into Prism runtime definitions.",
  "type": "object",
  "required": [
    "definitionKey",
    "displayName",
    "schemaVersion",
    "initialStageKey",
    "stages"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "definitionKey": {
      "type": "string"
    },
    "displayName": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "description": {
      "type": ["string", "null"]
    },
    "schemaVersion": {
      "type": "string"
    },
    "initialStageKey": {
      "type": "string"
    },
    "instancePolicy": {
      "type": "string"
    },
    "stages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/stage"
      }
    },
    "transitions": false,
    "lanes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/lane"
      }
    },
    "gateways": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/gateway"
      }
    },
    "handoffs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/handoff"
      }
    },
    "parameterSchemas": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/parameterSchema"
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "authorNote": {
      "type": ["string", "null"]
    }
  },
  "$defs": {
    "stage": {
      "type": "object",
      "required": ["key", "title", "type", "actions"],
      "properties": {
        "key": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": ["string", "null"] },
        "actor": { "type": ["string", "null"] },
        "laneKey": { "type": ["string", "null"] },
        "type": {
          "type": "string",
          "enum": ["Question", "CheckAnswers", "Confirmation", "TaskList"]
        },
        "actions": {
          "type": "array",
          "items": { "$ref": "#/$defs/action" }
        },
        "fields": {
          "type": "array",
          "items": { "$ref": "#/$defs/field" }
        },
        "roleGates": {
          "type": "array",
          "items": { "type": "string" }
        },
        "editorComment": {
          "type": ["string", "null"]
        }
      }
    },
    "transition": false,
    "lane": {
      "type": "object",
      "required": ["key", "title"],
      "properties": {
        "key": { "type": "string" },
        "title": { "type": "string" },
        "actor": { "type": ["string", "null"] },
        "roleGates": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "gateway": {
      "type": "object",
      "required": ["key", "title", "type", "laneKey", "routes"],
      "properties": {
        "key": { "type": "string" },
        "title": { "type": "string" },
        "type": {
          "type": "string",
          "enum": ["Split", "Join"]
        },
        "laneKey": { "type": "string" },
        "source": { "type": ["string", "null"] },
        "routes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/route" }
        },
        "description": { "type": ["string", "null"] },
        "actor": { "type": ["string", "null"] },
        "roleGates": {
          "type": "array",
          "items": { "type": "string" }
        },
        "waitingInfo": {
          "$ref": "#/$defs/waitingMetadata"
        },
        "requiredIncomingLanes": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "type": { "const": "Split" } }
          },
          "then": {
            "required": ["source"]
          }
        },
        {
          "if": {
            "properties": { "type": { "const": "Join" } }
          },
          "then": {
            "required": ["waitingInfo", "requiredIncomingLanes"]
          }
        }
      ]
    },
    "route": {
      "type": "object",
      "required": ["id", "target", "trigger"],
      "properties": {
        "id": { "type": "string" },
        "target": { "type": "string" },
        "trigger": { "type": "string" },
        "condition": {
          "oneOf": [
            { "$ref": "#/$defs/condition" },
            { "type": "null" }
          ]
        },
        "actions": {
          "type": "array",
          "items": { "$ref": "#/$defs/action" }
        },
        "requiresRole": {
          "type": ["string", "null"]
        }
      }
    },
    "waitingMetadata": {
      "type": "object",
      "properties": {
        "content": { "type": ["string", "null"] },
        "expectedWaitSeconds": { "type": "integer", "minimum": 0 },
        "pollIntervalMs": { "type": "integer", "minimum": 0 },
        "allowDefer": { "type": "boolean" },
        "deferMessage": { "type": ["string", "null"] }
      }
    },
    "action": {
      "type": "object",
      "required": ["type", "timing", "params"],
      "properties": {
        "type": { "type": "string" },
        "timing": {
          "type": "string",
          "enum": ["OnEntry", "OnExit", "OnTransition"]
        },
        "params": {
          "type": "object"
        },
        "parameterSchemaKey": {
          "type": ["string", "null"]
        },
        "summary": {
          "type": ["string", "null"]
        }
      }
    },
    "condition": {
      "type": "object",
      "required": ["kind", "expression"],
      "properties": {
        "kind": { "type": "string" },
        "expression": { "type": "string" },
        "description": { "type": ["string", "null"] }
      }
    },
    "field": {
      "type": "object",
      "required": ["key", "label", "type"],
      "properties": {
        "key": { "type": "string" },
        "label": { "type": "string" },
        "type": {
          "type": "string",
          "enum": ["Text", "Number", "Decimal", "Email", "Date", "Textarea", "Boolean", "Select", "Radios", "Checkboxes"]
        },
        "required": { "type": "boolean" },
        "hint": { "type": ["string", "null"] },
        "validationPattern": { "type": ["string", "null"] },
        "options": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "parameterSchema": {
      "type": "object",
      "required": ["key", "valueKind", "properties", "required"],
      "properties": {
        "key": { "type": "string" },
        "title": { "type": ["string", "null"] },
        "description": { "type": ["string", "null"] },
        "appliesTo": {
          "type": "array",
          "items": { "type": "string" }
        },
        "valueKind": {
          "type": "string",
          "enum": ["String", "Number", "Integer", "Boolean", "Object", "Array", "Null"]
        },
        "allowAdditionalProperties": { "type": "boolean" },
        "properties": {
          "type": "array",
          "items": { "$ref": "#/$defs/parameterDefinition" }
        },
        "required": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "parameterDefinition": {
      "type": "object",
      "required": ["key", "valueKind"],
      "properties": {
        "key": { "type": "string" },
        "title": { "type": ["string", "null"] },
        "description": { "type": ["string", "null"] },
        "valueKind": {
          "type": "string",
          "enum": ["String", "Number", "Integer", "Boolean", "Object", "Array", "Null"]
        },
        "format": { "type": ["string", "null"] },
        "editor": { "type": ["string", "null"] },
        "allowedValues": {
          "type": "array",
          "items": { "type": "string" }
        },
        "defaultValue": {},
        "properties": {
          "type": "array",
          "items": { "$ref": "#/$defs/parameterDefinition" }
        },
        "items": {
          "anyOf": [
            { "$ref": "#/$defs/parameterDefinition" },
            { "type": "null" }
          ]
        }
      }
    },
    "handoff": {
      "type": "object",
      "required": ["id", "fromStage", "toStage", "label"],
      "properties": {
        "id": { "type": "string" },
        "fromStage": { "type": "string" },
        "toStage": { "type": "string" },
        "label": { "type": "string" },
        "actorChange": { "type": ["string", "null"] }
      }
    }
  }
}
