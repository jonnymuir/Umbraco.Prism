<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Content Update="service-blueprints\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Update="service-blueprints-authored\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.2" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.0" />
    <PackageReference Include="Microsoft.OpenApi" Version="2.7.5" PrivateAssets="all" />
    <PackageReference Include="Wayfinder" Version="0.1.1" />
    <PackageReference Include="Wayfinder.Engine" Version="0.1.1" />
    <PackageReference Include="Wayfinder.Engine.Api" Version="0.1.1" />
    <PackageReference Include="Wayfinder.Engine.Mcp" Version="0.1.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../UmbracoPrism.Core/UmbracoPrism.Core.csproj" />
    <ProjectReference Include="../Wayfinder.Editor/Wayfinder.Editor.csproj" />
  </ItemGroup>

</Project>
