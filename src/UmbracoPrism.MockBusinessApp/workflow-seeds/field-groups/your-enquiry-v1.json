{
  "groupKey": "your-enquiry",
  "displayName": "Your Enquiry",
  "version": 1,
  "fields": [
    {
      "fieldKey": "enquiry-type",
      "label": "What can we help with?",
      "hint": null,
      "fieldType": "radio",
      "required": true,
      "options": [
        "General enquiry",
        "Technical support",
        "Partnership opportunity",
        "Speaking / events",
        "Other"
      ]
    },
    {
      "fieldKey": "enquiry-type-other",
      "label": "Please specify your enquiry type",
      "hint": "Please describe your enquiry type in a few words.",
      "fieldType": "text",
      "required": false,
      "maxLength": 100,
      "conditionalOn": "enquiry-type",
      "visibleWhen": "Other"
    },
    {
      "fieldKey": "message",
      "label": "Tell us more",
      "hint": "For technical support, include a version number, URL, or error reference to help us respond faster.",
      "fieldType": "textarea",
      "required": true,
      "minLength": 20,
      "maxLength": 500
    },
    {
      "fieldKey": "topics",
      "label": "Topics you're interested in",
      "hint": null,
      "fieldType": "checkboxlist",
      "required": false,
      "options": [
        "Umbraco CMS",
        ".NET Development",
        "Mobile Apps",
        "Cloud & Azure",
        "Design Systems"
      ]
    },
    {
      "fieldKey": "newsletter",
      "label": "Keep me updated with Prism news and releases",
      "hint": null,
      "fieldType": "boolean",
      "required": false
    }
  ]
}
