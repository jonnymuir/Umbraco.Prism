{
  "groupKey": "about-you-with-context",
  "displayName": "About You",
  "version": 1,
  "fields": [
    {
      "fieldKey": "privacy-note",
      "fieldType": "inset-text",
      "content": "We'll only use your contact details to respond to your enquiry. We won't share them with any third parties or add you to a mailing list without your consent."
    },
    {
      "fieldKey": "full-name",
      "label": "Full name",
      "hint": null,
      "fieldType": "text",
      "required": true,
      "maxLength": 100
    },
    {
      "fieldKey": "email-address",
      "label": "Email address",
      "hint": null,
      "fieldType": "email",
      "required": true
    },
    {
      "fieldKey": "organisation",
      "label": "Organisation (optional)",
      "hint": null,
      "fieldType": "text",
      "required": false,
      "maxLength": 100
    },
    {
      "fieldKey": "your-role",
      "label": "Your role",
      "hint": null,
      "fieldType": "select",
      "required": true,
      "options": [
        "Developer",
        "Architect",
        "Technical Lead",
        "CTO / Head of Engineering",
        "Other"
      ]
    },
    {
      "fieldKey": "why-we-need-details",
      "fieldType": "details",
      "label": "Why do we need your contact details?",
      "content": "We need your name and email so we can respond to your enquiry. Your role helps us understand the context of your question so we can give you the most relevant answer. We keep enquiry records for 12 months."
    }
