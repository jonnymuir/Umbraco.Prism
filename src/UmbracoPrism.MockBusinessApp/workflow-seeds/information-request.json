{
  "definitionKey": "information-request",
  "displayName": "Information Request",
  "version": 1,
  "initialState": "collecting-info",
  "states": [
    {
      "stateKey": "collecting-info",
      "displayName": "Tell us about yourself",
      "allowedActions": [
        "submit",
        "save-draft"
      ],
      "components": [
        {
          "type": "fieldset",
          "legend": "Your details",
          "children": [
            {
              "type": "text",
              "fieldKey": "firstName",
              "label": "First name",
              "hint": "As it appears on your ID",
              "required": true
            },
            {
              "type": "text",
              "fieldKey": "lastName",
              "label": "Last name",
              "hint": null,
              "required": true
            },
            {
              "type": "date",
              "fieldKey": "dateOfBirth",
              "label": "Date of birth",
              "hint": "For example, 12 03 1985",
              "required": true
            },
            {
              "type": "email",
              "fieldKey": "email",
              "label": "Email address",
              "hint": "We'll only use this to contact you about your request",
              "required": true
            }
          ]
        },
        {
          "type": "fieldset",
          "legend": "Your request",
          "children": [
            {
              "type": "select",
              "fieldKey": "requestType",
              "label": "What type of request is this?",
              "hint": null,
              "required": true,
              "options": [
                "General enquiry",
                "Data subject access request",
                "Complaint",
                "Technical support"
              ]
            },
            {
              "type": "textarea",
              "fieldKey": "description",
              "label": "Tell us more about your request",
              "hint": "Include as much detail as possible. Maximum 1000 characters.",
              "required": true
            },
            {
              "type": "radio",
              "fieldKey": "urgency",
              "label": "How urgent is this?",
              "hint": null,
              "required": true,
              "options": [
                "Standard (5-7 working days)",
                "Urgent (2 working days)",
                "Critical (same day)"
              ]
            }
          ]
        }
      ]
    },
    {
      "stateKey": "under-review",
      "displayName": "Your request is being reviewed",
      "allowedActions": [],
      "components": [
        {
          "type": "body",
          "content": "We've received your submission and it's currently being reviewed. You'll hear from us soon — no further action is needed right now."
        }
      ]
    },
    {
      "stateKey": "complete",
      "displayName": "Request Complete",
      "allowedActions": [
        "start-another"
      ],
      "components": [
        {
          "type": "panel",
          "heading": "Application complete"
        },
        {
          "type": "heading",
          "level": 2,
          "content": "What happens next"
        },
        {
          "type": "body",
          "content": "We've sent you a confirmation email."
        },
        {
          "type": "body",
          "content": "A member of our team will be in touch shortly."
        }
      ]
    }
  ],
  "transitions": [
    {
      "fromState": "collecting-info",
      "toState": "under-review",
      "action": "submit"
    },
    {
      "fromState": "collecting-info",
      "toState": "collecting-info",
      "action": "save-draft"
    },
    {
      "fromState": "under-review",
      "toState": "complete",
      "action": "approve",
      "requiresRole": "reviewer"
    },
    {
      "fromState": "under-review",
      "toState": "collecting-info",
      "action": "request-changes",
      "requiresRole": "reviewer"
    }
  ]
}
