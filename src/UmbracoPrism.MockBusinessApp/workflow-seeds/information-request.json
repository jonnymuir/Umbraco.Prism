{
  "definitionKey": "information-request",
  "displayName": "Information Request",
  "version": 2,
  "description": "Information request workflow for members of the public, reviewed by the back-office team.",
  "schemaVersion": "1.0",
  "initialState": "collecting-info",
  "queues": [
    {
      "key": "applicant",
      "displayName": "Applicant",
      "actor": "applicant",
      "description": "Member of the public submitting and tracking their information request."
    },
    {
      "key": "reviewer",
      "displayName": "Review team",
      "actor": "reviewer",
      "description": "Back-office team reviewing and actioning information requests."
    }
  ],
  "states": [
    {
      "stateKey": "collecting-info",
      "displayName": "Tell us about yourself",
      "stageType": "Question",
      "actor": "applicant",
      "queueKey": "applicant",
      "components": [
        {
          "type": "fieldset",
          "legend": "Your details",
          "children": [
            {
              "type": "text",
              "fieldKey": "firstName",
              "label": "First name",
              "hint": "As it appears on your ID",
              "required": true
            },
            {
              "type": "text",
              "fieldKey": "lastName",
              "label": "Last name",
              "required": true
            },
            {
              "type": "date",
              "fieldKey": "dateOfBirth",
              "label": "Date of birth",
              "hint": "For example, 12 03 1985",
              "required": true
            },
            {
              "type": "email",
              "fieldKey": "email",
              "label": "Email address",
              "hint": "We'll only use this to contact you about your request",
              "required": true
            }
          ]
        },
        {
          "type": "fieldset",
          "legend": "Your request",
          "children": [
            {
              "type": "select",
              "fieldKey": "requestType",
              "label": "What type of request is this?",
              "required": true,
              "options": [
                "General enquiry",
                "Data subject access request",
                "Complaint",
                "Technical support"
              ]
            },
            {
              "type": "textarea",
              "fieldKey": "description",
              "label": "Tell us more about your request",
              "hint": "Include as much detail as possible. Maximum 1000 characters.",
              "required": true
            },
            {
              "type": "radio",
              "fieldKey": "urgency",
              "label": "How urgent is this?",
              "required": true,
              "options": [
                "Standard (5-7 working days)",
                "Urgent (2 working days)",
                "Critical (same day)"
              ]
            }
          ]
        }
      ],
      "routes": [
        {
          "id": "collecting-info--submit--under-review",
          "target": "under-review",
          "trigger": "submit"
        },
        {
          "id": "collecting-info--save-draft--collecting-info",
          "target": "collecting-info",
          "trigger": "save-draft"
        }
      ]
    },
    {
      "stateKey": "under-review",
      "displayName": "Review request",
      "description": "Back-office reviewer reads the request and approves it or returns it for changes.",
      "stageType": "Question",
      "actor": "reviewer",
      "queueKey": "reviewer",
      "components": [
        {
          "type": "body",
          "content": "Review the submitted information request and choose to approve it or send it back for changes."
        }
      ],
      "routes": [
        {
          "id": "under-review--approve--complete",
          "target": "complete",
          "trigger": "approve",
          "requiresRole": "reviewer"
        },
        {
          "id": "under-review--request-changes--collecting-info",
          "target": "collecting-info",
          "trigger": "request-changes",
          "requiresRole": "reviewer"
        }
      ]
    },
    {
      "stateKey": "complete",
      "displayName": "Request Complete",
      "description": "Confirms the request has been processed and the applicant will be contacted.",
      "stageType": "Confirmation",
      "actor": "applicant",
      "queueKey": "applicant",
      "components": [
        {
          "type": "panel",
          "heading": "Application complete"
        },
        {
          "type": "heading",
          "level": 2,
          "content": "What happens next"
        },
        {
          "type": "body",
          "content": "We've sent you a confirmation email."
        },
        {
          "type": "body",
          "content": "A member of our team will be in touch shortly."
        }
      ],
      "routes": []
    }
  ],
  "gateways": []
}
