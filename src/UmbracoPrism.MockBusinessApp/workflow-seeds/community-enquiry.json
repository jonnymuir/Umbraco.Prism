{
  "definitionKey": "community-enquiry",
  "displayName": "Get in Touch",
  "version": 2,
  "description": "Community enquiry workflow for public submissions reviewed by the back-office team.",
  "schemaVersion": "1.0",
  "instancePolicy": "single",
  "initialState": "collecting-details",
  "queues": [
    {
      "key": "applicant",
      "displayName": "Enquirer",
      "actor": "applicant",
      "description": "Public user submitting and tracking their community enquiry."
    },
    {
      "key": "reviewer",
      "displayName": "Review team",
      "actor": "reviewer",
      "description": "Back-office team reviewing and responding to submitted enquiries."
    }
  ],
  "states": [
    {
      "stateKey": "collecting-details",
      "displayName": "Tell us about your enquiry",
      "stageType": "Question",
      "actor": "applicant",
      "queueKey": "applicant",
      "components": [
        {
          "type": "inset-text",
          "content": "We'll only use your contact details to respond to your enquiry. We won't share them with any third parties or add you to a mailing list without your consent."
        },
        {
          "type": "fieldset",
          "legend": "About You",
          "children": [
            {
              "type": "text",
              "fieldKey": "full-name",
              "label": "Full name",
              "hint": null,
              "required": true,
              "maxLength": 100
            },
            {
              "type": "email",
              "fieldKey": "email-address",
              "label": "Email address",
              "hint": null,
              "required": true
            },
            {
              "type": "text",
              "fieldKey": "organisation",
              "label": "Organisation (optional)",
              "hint": null,
              "required": false,
              "maxLength": 100
            },
            {
              "type": "select",
              "fieldKey": "your-role",
              "label": "Your role",
              "hint": null,
              "required": true,
              "options": [
                "Developer",
                "Architect",
                "Technical Lead",
                "CTO / Head of Engineering",
                "Other"
              ]
            }
          ]
        },
        {
          "type": "details",
          "heading": "Why do we need your contact details?",
          "content": "We need your name and email so we can respond to your enquiry. Your role helps us understand the context of your question so we can give you the most relevant answer. We keep enquiry records for 12 months."
        },
        {
          "type": "fieldset",
          "legend": "Your Enquiry",
          "children": [
            {
              "type": "radio",
              "fieldKey": "enquiry-type",
              "label": "What can we help with?",
              "hint": null,
              "required": true,
              "options": [
                "General enquiry",
                "Technical support",
                "Partnership opportunity",
                "Speaking / events",
                "Other"
              ]
            },
            {
              "type": "text",
              "fieldKey": "enquiry-type-detail",
              "label": "Please specify your enquiry type",
              "hint": "Please describe your enquiry type in a few words.",
              "required": false,
              "maxLength": 100,
              "conditionalOn": "enquiry-type",
              "visibleWhen": "Other"
            }
          ]
        },
        {
          "type": "inset-text",
          "content": "For technical support, include your Prism version number, a URL, or any error messages you're seeing. This helps us resolve your issue faster."
        },
        {
          "type": "warning-text",
          "content": "Do not include passwords, API keys, or other sensitive credentials in your message. Our support team does not need this information."
        },
        {
          "type": "fieldset",
          "legend": "Your Message",
          "children": [
            {
              "type": "textarea",
              "fieldKey": "message",
              "label": "Tell us more",
              "hint": "Please be as specific as possible \u2014 the more detail you give, the faster we can help.",
              "required": true,
              "minLength": 20,
              "maxLength": 1000
            },
            {
              "type": "checkboxlist",
              "fieldKey": "topics",
              "label": "Topics you're interested in",
              "hint": null,
              "required": false,
              "options": [
                "Umbraco CMS",
                ".NET Development",
                "Mobile Apps",
                "Cloud & Azure",
                "Design Systems"
              ]
            },
            {
              "type": "boolean",
              "fieldKey": "newsletter",
              "label": "Keep me updated with Prism news and releases",
              "hint": null,
              "required": false
            }
          ]
        }
      ],
      "routes": [
        {
          "id": "collecting-details--submit--under-review",
          "target": "under-review",
          "trigger": "submit"
        },
        {
          "id": "collecting-details--save-draft--collecting-details",
          "target": "collecting-details",
          "trigger": "save-draft"
        }
      ]
    },
    {
      "stateKey": "under-review",
      "displayName": "Review enquiry",
      "description": "Back-office reviewer reads the enquiry and approves or requests changes.",
      "stageType": "Question",
      "actor": "reviewer",
      "queueKey": "reviewer",
      "components": [
        {
          "type": "body",
          "content": "Review the submitted enquiry and choose to approve it or send it back for changes."
        }
      ],
      "routes": [
        {
          "id": "under-review--approve--complete",
          "target": "complete",
          "trigger": "approve",
          "requiresRole": "reviewer"
        },
        {
          "id": "under-review--request-changes--collecting-details",
          "target": "collecting-details",
          "trigger": "request-changes",
          "requiresRole": "reviewer"
        }
      ]
    },
    {
      "stateKey": "complete",
      "displayName": "We're in touch!",
      "description": "Confirms the enquiry has been acknowledged and the applicant will be contacted.",
      "stageType": "Confirmation",
      "actor": "applicant",
      "queueKey": "applicant",
      "components": [
        {
          "type": "panel",
          "heading": "Enquiry received"
        },
        {
          "type": "heading",
          "level": 2,
          "content": "What happens next"
        },
        {
          "type": "body",
          "content": "We've sent you a confirmation email."
        },
        {
          "type": "body",
          "content": "A member of our team will be in touch shortly."
        }
      ],
      "routes": []
    }
  ],
  "gateways": []
}
