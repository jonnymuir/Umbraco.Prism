{
  "definitionKey": "community-enquiry",
  "displayName": "Get in Touch",
  "version": 1,
  "instancePolicy": "single",
  "initialState": "collecting-details",
  "states": [
    {
      "stateKey": "collecting-details",
      "displayName": "Tell us about your enquiry",
      "stepType": "question",
      "allowedActions": ["submit", "save-draft"],
      "components": [
        { "type": "fieldset", "fieldGroupKey": "about-you-with-context" },
        { "type": "fieldset", "fieldGroupKey": "your-enquiry-with-context" }
      ]
    },
    {
      "stateKey": "under-review",
      "displayName": "Your enquiry is with us",
      "stepType": "status-timeline",
      "allowedActions": [],
      "components": [
        { "type": "body", "content": "We've received your enquiry and it's currently being reviewed. A member of the team will be in touch shortly — no further action is needed right now." }
      ]
    },
    {
      "stateKey": "complete",
      "displayName": "We're in touch!",
      "stepType": "confirmation",
      "allowedActions": ["start-another"],
      "components": [
        { "type": "panel", "heading": "Enquiry received" },
        { "type": "heading", "level": 2, "content": "What happens next" },
        { "type": "body", "content": "We've sent you a confirmation email." },
        { "type": "body", "content": "A member of our team will be in touch shortly." }
      ]
    }
  ],
  "transitions": [
    { "fromState": "collecting-details", "toState": "under-review", "action": "submit" },
    { "fromState": "collecting-details", "toState": "collecting-details", "action": "save-draft" },
    { "fromState": "under-review", "toState": "complete", "action": "approve", "requiresRole": "reviewer" },
    { "fromState": "under-review", "toState": "collecting-details", "action": "request-changes", "requiresRole": "reviewer" }
  ]
}
