{
  "definitionKey": "planning-notification",
  "displayName": "Apply for Planning Permission",
  "version": 1,
  "instancePolicy": "single",
  "initialState": "project-details",
  "states": [
    {
      "stateKey": "project-details",
      "displayName": "Describe your project",
      "stepType": "question",
      "allowedActions": ["continue"],
      "components": [
        { "type": "fieldset", "fieldGroupKey": "project-info" }
      ]
    },
    {
      "stateKey": "work-type",
      "displayName": "Type of work",
      "stepType": "question",
      "allowedActions": ["continue", "back"],
      "components": [
        { "type": "fieldset", "fieldGroupKey": "work-type-info" }
      ]
    },
    {
      "stateKey": "timeline-cost",
      "displayName": "Timeline and cost",
      "stepType": "question",
      "allowedActions": ["continue", "back"],
      "components": [
        { "type": "fieldset", "fieldGroupKey": "timeline-cost-info" }
      ]
    },
    {
      "stateKey": "affected-parties",
      "displayName": "Affected parties",
      "stepType": "question",
      "allowedActions": ["continue", "back"],
      "components": [
        { "type": "fieldset", "fieldGroupKey": "affected-parties-info" }
      ]
    },
    {
      "stateKey": "check-answers",
      "displayName": "Check your answers",
      "stepType": "check-answers",
      "allowedActions": ["submit", "back"],
      "components": [
        { "type": "summary-list", "fieldGroupKey": "project-info", "changeStateKey": "project-details" },
        { "type": "summary-list", "fieldGroupKey": "work-type-info", "changeStateKey": "work-type" },
        { "type": "summary-list", "fieldGroupKey": "timeline-cost-info", "changeStateKey": "timeline-cost" },
        { "type": "summary-list", "fieldGroupKey": "affected-parties-info", "changeStateKey": "affected-parties" }
      ]
    },
    {
      "stateKey": "complete",
      "displayName": "Application received",
      "stepType": "confirmation",
      "allowedActions": ["start-another"],
      "components": [
        { "type": "panel", "heading": "Application received" },
        { "type": "heading", "level": 2, "content": "What happens next" },
        { "type": "body", "content": "We've sent you a confirmation email." },
        { "type": "body", "content": "A member of our team will review your application and be in touch." }
      ]
    }
  ],
  "transitions": [
    { "fromState": "project-details", "toState": "work-type", "action": "continue" },
    { "fromState": "work-type", "toState": "timeline-cost", "action": "continue" },
    { "fromState": "work-type", "toState": "project-details", "action": "back" },
    { "fromState": "timeline-cost", "toState": "affected-parties", "action": "continue" },
    { "fromState": "timeline-cost", "toState": "work-type", "action": "back" },
    { "fromState": "affected-parties", "toState": "check-answers", "action": "continue" },
    { "fromState": "affected-parties", "toState": "timeline-cost", "action": "back" },
    { "fromState": "check-answers", "toState": "complete", "action": "submit" },
    { "fromState": "check-answers", "toState": "affected-parties", "action": "back" }
  ]
}
