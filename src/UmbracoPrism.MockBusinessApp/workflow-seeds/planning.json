{
  "definitionKey": "planning",
  "displayName": "Planning Application",
  "version": 3,
  "description": "Standard planning application workflow for submitting and tracking planning permission requests.",
  "schemaVersion": "1.0",
  "initialState": "declaration",
  "instancePolicy": "single",
  "queues": [
    {
      "key": "applicant",
      "displayName": "Applicant",
      "actor": "applicant",
      "description": "Web applicant completing and submitting the planning application."
    }
  ],
  "states": [
    {
      "stateKey": "declaration",
      "displayName": "Declaration",
      "description": "Collects applicant and site identity before the full planning form.",
      "stageType": "Question",
      "actor": "applicant",
      "queueKey": "applicant",
      "components": [
        {
          "type": "fieldset",
          "children": [
            {
              "type": "text",
              "fieldKey": "applicant-name",
              "label": "Applicant name",
              "hint": "Enter the full name of the person or organisation applying.",
              "required": true
            },
            {
              "type": "textarea",
              "fieldKey": "site-address",
              "label": "Site address",
              "hint": "Enter the full address of the site where development is proposed.",
              "required": true
            }
          ]
        }
      ],
      "routes": [
        {
          "id": "declaration--continue--application-form",
          "target": "application-form",
          "trigger": "continue"
        }
      ]
    },
    {
      "stateKey": "application-form",
      "displayName": "Application Form",
      "description": "Captures the substantive planning request.",
      "stageType": "Question",
      "actor": "applicant",
      "queueKey": "applicant",
      "components": [
        {
          "type": "fieldset",
          "children": [
            {
              "type": "textarea",
              "fieldKey": "description",
              "label": "Description of proposed works",
              "hint": "Provide a clear description of the development you are proposing.",
              "required": true
            },
            {
              "type": "select",
              "fieldKey": "development-type",
              "label": "Type of development",
              "required": true,
              "options": [
                "New build",
                "Extension",
                "Change of use",
                "Demolition",
                "Other"
              ]
            }
          ]
        }
      ],
      "routes": [
        {
          "id": "application-form--continue--check-answers",
          "target": "check-answers",
          "trigger": "continue"
        }
      ]
    },
    {
      "stateKey": "check-answers",
      "displayName": "Check your answers",
      "description": "Summarises captured answers before final submission.",
      "stageType": "CheckAnswers",
      "actor": "applicant",
      "queueKey": "applicant",
      "components": [
        {
          "type": "summary-list",
          "children": [
            {
              "type": "textarea",
              "fieldKey": "description",
              "label": "Description of proposed works",
              "hint": "Provide a clear description of the development you are proposing.",
              "required": true
            },
            {
              "type": "select",
              "fieldKey": "development-type",
              "label": "Type of development",
              "required": true,
              "options": [
                "New build",
                "Extension",
                "Change of use",
                "Demolition",
                "Other"
              ]
            },
            {
              "type": "text",
              "fieldKey": "applicant-name",
              "label": "Applicant name",
              "hint": "Enter the full name of the person or organisation applying.",
              "required": true
            },
            {
              "type": "textarea",
              "fieldKey": "site-address",
              "label": "Site address",
              "hint": "Enter the full address of the site where development is proposed.",
              "required": true
            },
            {
              "type": "text",
              "fieldKey": "id-document-uploaded",
              "label": "Identity document",
              "required": true
            }
          ]
        }
      ],
      "routes": [
        {
          "id": "check-answers--continue--id-verification",
          "target": "id-verification",
          "trigger": "continue"
        },
        {
          "id": "check-answers--submit--submitted",
          "target": "submitted",
          "trigger": "submit"
        }
      ]
    },
    {
      "stateKey": "id-verification",
      "displayName": "Identity Verification",
      "stageType": "Question",
      "actor": "applicant",
      "queueKey": "applicant",
      "components": [
        {
          "type": "fieldset",
          "children": [
            {
              "type": "text",
              "fieldKey": "id-document-uploaded",
              "label": "Identity document",
              "hint": "Upload or provide a reference for your proof of identity.",
              "required": true
            }
          ]
        }
      ],
      "routes": [
        {
          "id": "id-verification--continue--submitted",
          "target": "submitted",
          "trigger": "continue"
        }
      ]
    },
    {
      "stateKey": "submitted",
      "displayName": "Application submitted",
      "description": "Confirms receipt and moves the case into reviewer handling.",
      "stageType": "Confirmation",
      "actor": "applicant",
      "queueKey": "applicant",
      "components": [
        {
          "type": "panel",
          "heading": "Application submitted"
        },
        {
          "type": "body",
          "content": "Your planning application has been received. A caseworker will be in touch with next steps."
        }
      ],
      "routes": []
    }
  ],
  "gateways": [],
  "tags": {
    "owner": "planning-team",
    "serviceArea": "Planning"
  }
}
