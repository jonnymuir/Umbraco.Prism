{
  "definitionKey": "planning",
  "displayName": "Planning Application",
  "version": 2,
  "description": "Standard planning application workflow for submitting and tracking planning permission requests.",
  "schemaVersion": "1.0",
  "initialTouchpoint": "declaration",
  "requestPolicy": "single",
  "touchpoints": [
    {
      "touchpointKey": "declaration",
      "displayName": "Declaration",
      "description": "Collects applicant and site identity before the full planning form.",
      "touchpointType": "Question",
      "actor": "applicant",
      "queueKey": "web-user",
      "actions": [
        {
          "type": "forms.load",
          "timing": "OnEntry",
          "parameterSchemaKey": "forms-form-definition",
          "summary": "Load the declaration form.",
          "params": {
            "formDefinitionId": "planning-declaration"
          }
        }
      ],
      "components": [
        {
          "type": "fieldset",
          "children": [
            {
              "type": "text",
              "fieldKey": "applicant-name",
              "label": "Applicant name",
              "hint": "Enter the full name of the person or organisation applying.",
              "required": true
            },
            {
              "type": "textarea",
              "fieldKey": "site-address",
              "label": "Site address",
              "hint": "Enter the full address of the site where development is proposed.",
              "required": true
            }
          ]
        }
      ],
      "routes": [
        {
          "id": "declaration--continue--route-from-declaration",
          "target": "route-from-declaration",
          "trigger": "continue"
        }
      ]
    },
    {
      "touchpointKey": "application-form",
      "displayName": "Application Form",
      "description": "Captures the substantive planning request.",
      "touchpointType": "Question",
      "actor": "applicant",
      "queueKey": "web-user",
      "actions": [
        {
          "type": "forms.save",
          "timing": "OnExit",
          "parameterSchemaKey": "forms-form-definition",
          "summary": "Persist the application form before moving on.",
          "params": {
            "formDefinitionId": "planning-application"
          }
        }
      ],
      "components": [
        {
          "type": "fieldset",
          "children": [
            {
              "type": "textarea",
              "fieldKey": "description",
              "label": "Description of proposed works",
              "hint": "Provide a clear description of the development you are proposing.",
              "required": true
            },
            {
              "type": "select",
              "options": [
                "New build",
                "Extension",
                "Change of use",
                "Demolition",
                "Other"
              ],
              "fieldKey": "development-type",
              "label": "Type of development",
              "required": true
            }
          ]
        }
      ],
      "routes": [
        {
          "id": "application-form--continue--route-from-application-form",
          "target": "route-from-application-form",
          "trigger": "continue"
        }
      ]
    },
    {
      "touchpointKey": "check-answers",
      "displayName": "Check your answers",
      "description": "Summarises captured answers before final submission.",
      "touchpointType": "CheckAnswers",
      "actor": "applicant",
      "queueKey": "web-user",
      "components": [
        {
          "type": "summary-list",
          "children": [
            {
              "type": "textarea",
              "fieldKey": "description",
              "label": "Description of proposed works",
              "hint": "Provide a clear description of the development you are proposing.",
              "required": true
            },
            {
              "type": "select",
              "options": [
                "New build",
                "Extension",
                "Change of use",
                "Demolition",
                "Other"
              ],
              "fieldKey": "development-type",
              "label": "Type of development",
              "required": true
            },
            {
              "type": "text",
              "fieldKey": "applicant-name",
              "label": "Applicant name",
              "hint": "Enter the full name of the person or organisation applying.",
              "required": true
            },
            {
              "type": "textarea",
              "fieldKey": "site-address",
              "label": "Site address",
              "hint": "Enter the full address of the site where development is proposed.",
              "required": true
            },
            {
              "type": "text",
              "fieldKey": "id-document-uploaded",
              "label": "Identity document",
              "required": true
            }
          ]
        }
      ],
      "routes": [
        {
          "id": "check-answers--continue--route-from-check-answers",
          "target": "route-from-check-answers",
          "trigger": "continue"
        },
        {
          "id": "check-answers--submit--route-from-check-answers",
          "target": "route-from-check-answers",
          "trigger": "submit"
        }
      ]
    },
    {
      "touchpointKey": "id-verification",
      "displayName": "Identity Verification",
      "touchpointType": "Question",
      "queueKey": "web-user",
      "components": [
        {
          "type": "fieldset",
          "children": [
            {
              "type": "text",
              "fieldKey": "id-document-uploaded",
              "label": "Identity document",
              "required": true
            }
          ]
        }
      ],
      "routes": [
        {
          "id": "id-verification--continue--route-from-id-verification",
          "target": "route-from-id-verification",
          "trigger": "continue"
        }
      ]
    },
    {
      "touchpointKey": "submitted",
      "displayName": "Application submitted",
      "description": "Confirms receipt and moves the case into reviewer handling.",
      "touchpointType": "Confirmation",
      "actor": "applicant",
      "queueKey": "web-user",
      "components": [
        {
          "type": "panel",
          "heading": "Application submitted"
        }
      ],
      "routes": []
    }
  ],
  "queues": [
    {
      "key": "web-user",
      "displayName": "Applicant",
      "description": "Web user completing the planning application.",
      "actor": "applicant"
    }
  ],
  "gateways": [
    {
      "key": "route-from-declaration",
      "displayName": "Continue to Application Form",
      "gatewayType": "Split",
      "queueKey": "web-user",
      "routes": [
        {
          "id": "route-from-declaration--continue--application-form",
          "target": "application-form",
          "trigger": "continue"
        }
      ]
    },
    {
      "key": "route-from-application-form",
      "displayName": "Continue to Check Answers",
      "gatewayType": "Split",
      "queueKey": "web-user",
      "routes": [
        {
          "id": "route-from-application-form--continue--check-answers",
          "target": "check-answers",
          "trigger": "continue"
        }
      ]
    },
    {
      "key": "route-from-check-answers",
      "displayName": "Route from Check Answers",
      "gatewayType": "Split",
      "queueKey": "web-user",
      "routes": [
        {
          "id": "route-from-check-answers--continue--id-verification",
          "target": "id-verification",
          "trigger": "continue"
        },
        {
          "id": "route-from-check-answers--submit--submitted",
          "target": "submitted",
          "trigger": "submit",
          "conditions": [
            {
              "kind": "expression",
              "expression": "application.isComplete == true",
              "description": "Prevent submission until the applicant has completed the form."
            }
          ],
          "actions": [
            {
              "type": "forms.submit",
              "timing": "OnTransition",
              "parameterSchemaKey": "forms-form-definition",
              "summary": "Submit the application form to the business app.",
              "params": {
                "formDefinitionId": "planning-application"
              }
            }
          ]
        }
      ]
    },
    {
      "key": "route-from-id-verification",
      "displayName": "Continue to Submitted",
      "gatewayType": "Split",
      "queueKey": "web-user",
      "routes": [
        {
          "id": "route-from-id-verification--continue--submitted",
          "target": "submitted",
          "trigger": "continue"
        }
      ]
    }
  ],
  "tags": {
    "owner": "planning-team",
    "serviceArea": "Planning"
  }
}