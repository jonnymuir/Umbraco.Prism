<Project>
  <PropertyGroup>
    <!-- This estate targets one Umbraco major at a time (currently 17 LTS). UmbracoVersion is
         the exact patch the build compiles and tests against; UmbracoPackageRange is what the
         Umbraco.Cms.* PackageReferences use — floor at that patch, ceiling at the next major —
         so a host on Umbraco 18+ hits an honest restore-time version conflict instead of running
         these v17-built assemblies against a v18 API surface. Supporting a new Umbraco major is
         a deliberate, matrix-tested step: bump UmbracoMajor + UmbracoVersion together.
         See CLAUDE.md § Umbraco version support. -->
    <UmbracoMajor>17</UmbracoMajor>
    <UmbracoVersion>17.8.0</UmbracoVersion>
    <UmbracoPackageRange>[$(UmbracoVersion), $([MSBuild]::Add($(UmbracoMajor), 1)).0.0)</UmbracoPackageRange>
    <!-- uSync's major tracks Umbraco's, so it gets the same treatment. -->
    <USyncVersion>17.4.3</USyncVersion>
    <USyncPackageRange>[$(USyncVersion), $([MSBuild]::Add($(UmbracoMajor), 1)).0.0)</USyncPackageRange>
    <!-- Microsoft.OpenApi is deliberately NOT pinned in this estate: it flows transitively from
         Umbraco.Cms.Api.Management ($(UmbracoVersion)) at the version Umbraco itself requires
         (17.6.x → 2.9.0+, which clears GHSA-v5pm-xwqc-g5wc, the OpenAPI-parsing resource-exhaustion
         advisory). A hand-maintained pin here would risk holding a version *below* Umbraco's own,
         which then isn't on disk in a real host — 2.7.5 was confirmed live to throw
         FileNotFoundException at startup against an Umbraco 17.5.3 host that shipped 2.4.1. Only
         re-pin to jump *ahead* of Umbraco for a fix it hasn't picked up yet, PrivateAssets="all". -->

  </PropertyGroup>

  <!-- The published packages (UmbracoPrism, UmbracoPrism.Automate, UmbracoPrism.uSync) release
       together from one tag, so they share one version. Bump it with
       src/UmbracoPrism.Client/package.json; package-release.yml checks both against the tag. -->
  <PropertyGroup>
    <Version>7.0.0</Version>
    <Authors>Jonny Muir</Authors>
    <Company>Umbraco Prism</Company>
    <PackageProjectUrl>https://github.com/jonnymuir/Umbraco.Prism</PackageProjectUrl>
    <RepositoryUrl>https://github.com/jonnymuir/Umbraco.Prism</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageIcon>assets/logo-vertical-lockup.png</PackageIcon>
  </PropertyGroup>

  <!-- Items are evaluated after every property, so IsPackable from the project file is known here
       (a PropertyGroup condition in this file is not: it runs before the project sets it). -->
  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)LICENSE" Pack="true" PackagePath="/" />
    <None Include="$(MSBuildThisFileDirectory)assets/logo-vertical-lockup.png" Pack="true" PackagePath="assets/" />
  </ItemGroup>
</Project>
