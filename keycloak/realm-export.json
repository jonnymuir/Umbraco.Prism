  "roles": {
    "realm": [
      {
        "name": "user",
        "description": "User role"
      }
    ]
  },
  "defaultRoles": [
    "user"
  ],
  "scopeMappings": [],
  "clientScopeMappings": {},
  "internationalizationEnabled": false,
