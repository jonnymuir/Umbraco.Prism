{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "dotnet: build Core",
      "type": "shell",
      "command": "dotnet",
      "args": ["build", "${workspaceFolder}/src/UmbracoPrism.Core/UmbracoPrism.Core.csproj"],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Client: build",
      "type": "shell",
      "command": "npm",
      "args": ["run", "build"],
      "options": {
        "cwd": "${workspaceFolder}/src/UmbracoPrism.Client"
      },
      "dependsOn": ["dotnet: build Core"],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "Storybook: dev",
      "type": "shell",
      "command": "npm",
      "args": ["run", "storybook"],
      "options": {
        "cwd": "${workspaceFolder}/src/UmbracoPrism.Client"
      },
      "isBackground": true,
      "problemMatcher": []
    }
  ]
}
