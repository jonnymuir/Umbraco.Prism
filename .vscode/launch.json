{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "UI: Storybook",
            "type": "node-terminal",
            "request": "launch",
            "command": "npm run storybook",
            "cwd": "${workspaceFolder}/src/UmbracoPrism.Client"
        },
        {
            "name": "C#: Prism Test Debug",
            "type": "dotnet",
            "request": "launch",
            "preLaunchTask": "Client: build",
            "projectPath": "${workspaceFolder}/src/UmbracoPrism.TestSite/UmbracoPrism.TestSite.csproj"
        },
        {
            "name": "C#: Mock Back-Office Debug",
            "type": "dotnet",
            "request": "launch",
            "preLaunchTask": "dotnet: build Core",
            "projectPath": "${workspaceFolder}/src/UmbracoPrism.MockBackOffice/UmbracoPrism.MockBackOffice.csproj"
        }
    ],
    "compounds": [
        {
            "name": "C#: Full Prism Stack (Both)",
            "configurations": [
                "C#: Prism Test Debug",
                "C#: Mock Back-Office Debug"
            ],
            "stopAll": true,
            "dependsOrder": "sequence"
        }
    ]
}