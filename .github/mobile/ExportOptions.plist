<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Static export options for deploy-testflight.yml's `xcodebuild -exportArchive` step.
  Not templated per-run — signingStyle: automatic + the App Store Connect API key
  (passed via -authenticationKey* flags, not here) is enough for xcodebuild to resolve
  the distribution certificate and provisioning profile itself, scoped to the bundle ID
  baked into the generated ios/ project.

  "app-store-connect" is the current Xcode 15+ method name for a TestFlight/App Store
  upload archive (Xcode 14 and earlier used "app-store"). If the macos-latest runner's
  pinned Xcode version rejects this value, check `xcodebuild -help` on that runner and
  adjust — Apple has changed this method name before and may again.
-->
<plist version="1.0">
<dict>
    <key>method</key>
    <string>app-store-connect</string>
    <key>signingStyle</key>
    <string>automatic</string>
    <key>destination</key>
    <string>export</string>
</dict>
</plist>
